FORM f_carrega_pendente_qualidade .

  DATA: lit_zppt_oest TYPE TABLE OF zppt_oest,
        lwa_zppt_oest TYPE zppt_oest.

  DATA: lit_marc TYPE TABLE OF marc,
        lwa_marc TYPE marc.

  DATA: lv_tipo_certificado         TYPE vbap-mvgr1.

  REFRESH gt_outtab3.

  SELECT *
    FROM zppt_oest
    INTO TABLE lit_zppt_oest.

  IF lit_zppt_oest[] IS NOT INITIAL.
    SELECT matnr werks lgpro
      FROM marc
      INTO CORRESPONDING FIELDS OF TABLE lit_marc
      FOR ALL ENTRIES IN lit_zppt_oest
      WHERE matnr = lit_zppt_oest-matnr_apl
        AND werks = lit_zppt_oest-werks_apl.
    SORT lit_marc BY matnr werks.

    IF sy-subrc EQ 0.

      SELECT *
        FROM zrnppt_prev
        INTO TABLE it_zrnppt_prev_capa
        FOR ALL ENTRIES IN lit_marc
        WHERE matnr = lit_marc-matnr.

      DELETE it_zrnppt_prev_capa WHERE ano >= sy-datum(4)
                                   AND mes >= sy-datum+4(2).

    ENDIF.

  ENDIF.

  LOOP AT lit_zppt_oest INTO lwa_zppt_oest.
    MOVE-CORRESPONDING lwa_zppt_oest TO wa_outtab.

*    CLEAR lv_tipo_certificado.
*    CALL FUNCTION 'ZQMF_TIPO_CERTIFICADO' "Validação do campo Call Obs.
*      EXPORTING
*        i_werks                  = lwa_zppt_oest-werks
*        i_matnr                  = lwa_zppt_oest-matnr
*      IMPORTING
*        e_mvgr1                  = lv_tipo_certificado
*      EXCEPTIONS
*        ov_item_nao_existe       = 1
*        material_nao_existe      = 2
*        informar_item_ov         = 3
*        material_ov_divergente   = 4
*        centro_ov_divergente     = 5
*        informar_centro          = 6
*        informar_material        = 7
*        informar_ov              = 8
*        tipo_nao_encontrado      = 9
*        estrategia_nao_encontrad = 10
*        OTHERS                   = 11.
*
*    IF lv_tipo_certificado IS INITIAL OR lv_tipo_certificado = 'NT'.
*      wa_outtab-tp_certifica = 'N'.
*    ENDIF.

    IF wa_outtab-lgort_apl IS INITIAL.
      READ TABLE lit_marc INTO lwa_marc WITH KEY matnr = lwa_zppt_oest-matnr_apl
                                                 werks = lwa_zppt_oest-werks_apl
                                                 BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-lgort_apl = lwa_marc-lgpro.
*        wa_outtab-call_obs = icon_annotation.
      ENDIF.
    ENDIF.

*    "Campos de analise financeira na consulta dos materiais alternativos
*    PERFORM f_analise_financeira_capabil CHANGING wa_outtab.

    APPEND wa_outtab TO gt_outtab3.
    CLEAR wa_outtab.
  ENDLOOP.

  LOOP AT gt_outtab3 INTO wa_outtab.
    wa_outtab-call_obs = icon_annotation.
    MODIFY gt_outtab3 FROM wa_outtab.
  ENDLOOP.
  CLEAR wa_outtab.

* Se tiver um capabil NOK todos os outros com mesmo mateiral lote material aplicado deveram ser também
  "Montar uma tabela com todos os registros que são capabil NOK
  gt_outtab3_nok[] = gt_outtab3[].
  SORT gt_outtab3_nok BY capabil.
  DELETE gt_outtab3_nok WHERE capabil NE 'NOK'.
  SORT gt_outtab3_nok BY matnr charg matnr_apl.

  LOOP AT gt_outtab3 ASSIGNING FIELD-SYMBOL(<fs_outtab3>).

    READ TABLE gt_outtab3_nok TRANSPORTING NO FIELDS WITH KEY matnr     = <fs_outtab3>-matnr
                                                              charg     = <fs_outtab3>-charg
                                                              matnr_apl = <fs_outtab3>-matnr_apl BINARY SEARCH.
    IF sy-subrc EQ 0.
      <fs_outtab3>-capabil = 'NOK'.
    ENDIF.

  ENDLOOP.

ENDFORM.                    " F_CARREGA_PENDENTE_QUALIDADE

