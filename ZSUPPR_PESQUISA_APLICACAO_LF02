*&---------------------------------------------------------------------*
*&      Form  F_GRID3_DISPLAY
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_grid3_display .

  IF container3 IS NOT BOUND.
    IF cl_salv_table=>is_offline( ) EQ if_salv_c_bool_sap=>false.
      CREATE OBJECT container3
        EXPORTING
          container_name = 'CONTAINER3'.
    ENDIF.

    CREATE OBJECT gr_table3
      EXPORTING
        i_parent = container3.

* Layout variant of tabstrip 3
*    DATA: ls_variant TYPE disvariant.
*    ls_variant-report = sy-repid.
*    ls_variant-handle = '002'.

* Fieldcatalog for ALV
    PERFORM f_alv_build_fieldcat3.

* ALV attributes FOR LAYOUT
    PERFORM f_alv_report_layout.

* Event
    IF go_event_receiver IS INITIAL.
      CREATE OBJECT go_event_receiver.
    ENDIF.
    SET HANDLER go_event_receiver->handle_data_changed FOR gr_table3.
    SET HANDLER go_event_receiver->handle_hotspot_click FOR gr_table3.

* Call grid instance of tabstrip 3
    CALL METHOD gr_table3->set_table_for_first_display
      EXPORTING
        is_layout       = gt_layout
*       is_variant      = ls_variant
*       i_save          = 'A'
      CHANGING
        it_fieldcatalog = gt_fieldcatalog3
        it_outtab       = gt_outtab3.

*   data is changed and cursor is moved from the cell


    CALL METHOD gr_table3->register_edit_event
      EXPORTING
        i_event_id = cl_gui_alv_grid=>mc_evt_modified.


    CALL METHOD cl_gui_control=>set_focus
      EXPORTING
        control = gr_table3.
  ELSE.
    CALL METHOD gr_table3->refresh_table_display.
  ENDIF.

ENDFORM.                    " F_GRID3_DISPLAY

