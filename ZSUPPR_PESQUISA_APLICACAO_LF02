*&---------------------------------------------------------------------*
*&      Form  F_SELECIONA_CARACT_MATNR
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_seleciona_caract_matnr .

  TYPES: BEGIN OF ty_matnr_objek,
           objek TYPE inob-objek,
         END OF ty_matnr_objek,

         BEGIN OF ty_ausp,
           objek TYPE ausp-objek,
           atinn TYPE ausp-atinn,
           atzhl TYPE ausp-atzhl,
           mafid TYPE ausp-mafid,
           klart TYPE ausp-klart,
           adzhl TYPE ausp-adzhl,
           atwrt TYPE ausp-atwrt,
           atflv TYPE ausp-atflv,
           matnr TYPE mara-matnr,
         END OF ty_ausp,

         BEGIN OF ty_inob,
           cuobj TYPE inob-cuobj,
           objek TYPE inob-objek,
         END OF ty_inob,

         BEGIN OF ty_cabn,
           atinn TYPE cabn-atinn,
           atnam TYPE cabn-atnam,
           atfor TYPE cabn-atfor,
         END OF ty_cabn,

         BEGIN OF ty_cawn,
           atinn TYPE cawn-atinn,
           atwrt TYPE cawn-atwrt,
           atzhl TYPE cawn-atzhl,
           adzhl TYPE cawn-adzhl,
         END OF ty_cawn,

         BEGIN OF ty_cawnt,
           atinn TYPE cawnt-atinn,
           atzhl TYPE cawnt-atzhl,
           adzhl TYPE cawnt-adzhl,
           atwtb TYPE cawnt-atwtb,
         END OF ty_cawnt.

  DATA: lit_matnr_objek TYPE TABLE OF ty_matnr_objek,
        lit_matnr_ausp  TYPE TABLE OF ty_ausp,
        lit_ausp        TYPE TABLE OF ty_ausp,
        lit_ausp_aux    TYPE TABLE OF ty_ausp,
        lit_inob        TYPE TABLE OF ty_inob,
        lit_cabn        TYPE TABLE OF ty_cabn,
        lit_cawn        TYPE TABLE OF ty_cawn,
        lit_cawnt       TYPE TABLE OF ty_cawnt.

  DATA: lv_cuobj_023    TYPE inob-cuobj.

  FIELD-SYMBOLS: <fs_mara>         TYPE mara,
                 <fs_matnr_objek>  TYPE ty_matnr_objek,
                 <fs_atinn>        TYPE zsusde_caract_int,
                 <fs_ausp>         TYPE ty_ausp,
                 <fs_matnr_ausp>   TYPE ty_ausp,
                 <fs_inob>         TYPE ty_inob,
                 <fs_cabn>         TYPE ty_cabn,
                 <fs_cawn>         TYPE ty_cawn,
                 <fs_cawnt>        TYPE ty_cawnt,
                 <fs_caract_matnr> LIKE LINE OF it_caract_matnr.

  cl_progress_indicator=>progress_indicate(
    i_text = 'Selecionando as caract dos SKUs...'
    i_output_immediately = abap_true ).

  REFRESH: it_caract_matnr,
           it_atinn.

  PERFORM f_add_atinn USING 'SD_TOL_MAX_ESPESSURA'.
  PERFORM f_add_atinn USING 'SD_TOL_MIN_ESPESSURA'.
  PERFORM f_add_atinn USING 'SD_ESPESSURA'.
  PERFORM f_add_atinn USING 'SD_TOL_MIN_LARGURA'.
