*&---------------------------------------------------------------------*
*&      Form  F_CRIAR_RESERVA_PRODUCAO
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_criar_reserva_producao USING     p_wa_outtab TYPE ty_outtab
                                        p_stge_loc
                                        p_entry_qnt
                              CHANGING  p_rsnum
                                        p_rspos.

  DATA: ls_header      TYPE bapi2093_res_head,
        lt_item        TYPE STANDARD TABLE OF bapi2093_res_item,
        ls_item_line   LIKE LINE OF lt_item,
        lt_segment     TYPE TABLE OF bapi_profitability_segment,
        l_rsnum        TYPE bapi2093_res_key-reserv_no,
        l_msgtext      TYPE zppt_separa_log-msglog,
        l_msgtype      TYPE bapiret2-type,
        lt_return      TYPE TABLE OF bapiret2,
        ls_return_line LIKE LINE OF lt_return,
        lv_res_no      TYPE bapi2093_res_key-reserv_no.

  ls_header-res_date = sy-datum.
  ls_header-created_by = sy-uname.
  ls_header-move_type = '231'.
  ls_header-sales_ord = 'EMPRODUÇÃO'.
  ls_header-s_ord_item = '1'.

  ls_item_line-material = p_wa_outtab-matnr.
  ls_item_line-plant = p_wa_outtab-werks.
  ls_item_line-stge_loc = p_stge_loc.
  ls_item_line-batch = p_wa_outtab-charg.
  ls_item_line-entry_qnt = p_entry_qnt.
  APPEND ls_item_line TO lt_item.

  CALL FUNCTION 'BAPI_RESERVATION_CREATE1'
    EXPORTING
      reservationheader    = ls_header
    IMPORTING
      reservation          = lv_res_no
    TABLES
      reservationitems     = lt_item
      profitabilitysegment = lt_segment
      return               = lt_return
    EXCEPTIONS
      OTHERS               = 01.

  IF lv_res_no IS NOT INITIAL.
    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = 'X'.

    SELECT SINGLE rsnum rspos
      FROM resb
      INTO (p_rsnum, p_rspos)
      WHERE rsnum EQ lv_res_no.

  ELSE.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
  ENDIF.

ENDFORM.                    " F_CRIAR_RESERVA_PRODUCAO
*&---------------------------------------------------------------------*
*&      Form  F_ATUALIZA_DERROGA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM f_atualiza_derroga .

  gt_outtab3_aux[] = gt_outtab3[].
  SORT gt_outtab3 BY werks matnr charg werks_apl matnr_apl.
  DELETE ADJACENT DUPLICATES FROM gt_outtab3_aux COMPARING werks matnr charg werks_apl matnr_apl.

  "A marcação do primeiro derroga de cada registro deve refletir nos outros com mesmo werks matnr charg werks_apl matnr_apl
  LOOP AT gt_outtab3_aux INTO DATA(ls_outtab3_aux).

    LOOP AT gt_outtab3 ASSIGNING FIELD-SYMBOL(<fs_outtab3>) WHERE werks     = ls_outtab3_aux-werks
                                                              AND matnr     = ls_outtab3_aux-matnr
                                                              AND charg     = ls_outtab3_aux-charg
                                                              AND werks_apl = ls_outtab3_aux-werks_apl
                                                              AND matnr_apl = ls_outtab3_aux-matnr_apl.
      <fs_outtab3>-derroga = ls_outtab3_aux-derroga.
    ENDLOOP.

  ENDLOOP.

  LOOP AT gt_outtab3 INTO DATA(ls_outtab3).

    UPDATE zppt_oest SET derroga = ls_outtab3-derroga
                     WHERE werks     = ls_outtab3-werks
                       AND matnr     = ls_outtab3-matnr
                       AND charg     = ls_outtab3-charg
                       AND werks_apl = ls_outtab3-werks_apl
                       AND matnr_apl = ls_outtab3-matnr_apl.
    COMMIT WORK.
  ENDLOOP.

ENDFORM.

