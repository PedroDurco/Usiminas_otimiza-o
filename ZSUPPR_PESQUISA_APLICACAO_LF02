*&---------------------------------------------------------------------*
*&      Form  F_CONSISTE_DIMENSIONAL
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_consiste_dimensional  USING    p_werks
                                      p_matnr
                                      p_wa_mchbcar LIKE wa_mchbcar
*PP - Correção MP Alternativa - INC 3413606
                                      p_matnr_produto
                                      p_charg_produto
*PP - Correção MP Alternativa - INC 3413606
                             CHANGING p_matches.

  DATA: lwa_caract_charg LIKE LINE OF it_caract_charg,
        lwa_caract_matnr LIKE LINE OF it_caract_matnr.


  DATA: lv_charg_esp                   TYPE f,
        lv_charg_tol_min_esp           TYPE f,
        lv_charg_tol_max_esp           TYPE f,

        lv_matnr_esp                   TYPE f,
        lv_matnr_tol_min_esp           TYPE f,
        lv_matnr_tol_max_esp           TYPE f,

        lv_charg_larg                  TYPE f,
        lv_matnr_larg                  TYPE f,
        lv_matnr_tol_min_larg          TYPE f,

        lv_matnr_sd_hierarquia_produto TYPE atwrt,

*PP - Correção MP Alternativa - INC 3413606
        lv_charg_comp                  TYPE f,
        lv_matnr_comp                  TYPE f.
*PP - Correção MP Alternativa - INC 3413606

  DATA  lv_erro_tol_esp       TYPE c.

*PP - Correção MP Alternativa - INC 3413606
**********************************************************************
* Consistencia do Comprimento
**********************************************************************
  IF p_charg_produto NE 'Bobinas' AND p_charg_produto NE 'Rolo'.
    IF p_matnr_produto = 'Chapa' OR
       p_matnr_produto = 'Tira' OR
       p_matnr_produto = 'Blank' OR
       p_matnr_produto = 'Platina'.

      CLEAR lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = p_matnr
                                          atnam = 'SD_COMPRIMENTO'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr TRANSPORTING atflv.
      MOVE lwa_caract_matnr-atflv TO lv_matnr_comp.

      CLEAR lwa_caract_charg.
      READ TABLE it_caract_charg WITH KEY matnr = p_wa_mchbcar-matnr
                                          charg = p_wa_mchbcar-charg
                                          atnam = 'SD_COMPRIMENTO'
                                          BINARY SEARCH
                                          INTO lwa_caract_charg TRANSPORTING atflv.
      MOVE lwa_caract_charg-atflv TO lv_charg_comp.

      "comprimento
      IF lv_charg_comp GT 0.
        IF lv_charg_comp < lv_matnr_comp.
          p_matches = 'I'.  "Descartar devido inconsistencia Comprimento
          RETURN.
        ENDIF.
      ENDIF.

    ENDIF.
  ENDIF.
*PP - Correção MP Alternativa - INC 3413606

**********************************************************************
* Consistencia da Largura
**********************************************************************
  CLEAR lwa_caract_matnr.
  READ TABLE it_caract_matnr WITH KEY matnr = p_matnr
                                      atnam = 'SD_TOL_MIN_LARGURA'
                                      BINARY SEARCH
                                      INTO lwa_caract_matnr TRANSPORTING atflv.
  MOVE lwa_caract_matnr-atflv TO lv_matnr_tol_min_larg.

  CLEAR lwa_caract_matnr.
  READ TABLE it_caract_matnr WITH KEY matnr = p_matnr
                                      atnam = 'SD_LARGURA'
                                      BINARY SEARCH
                                      INTO lwa_caract_matnr TRANSPORTING atflv.
  MOVE lwa_caract_matnr-atflv TO lv_matnr_larg.

  lv_matnr_tol_min_larg = lv_matnr_larg - lv_matnr_tol_min_larg.


  CLEAR lwa_caract_charg.
  READ TABLE it_caract_charg WITH KEY matnr = p_wa_mchbcar-matnr
                                      charg = p_wa_mchbcar-charg
                                      atnam = 'SD_LARGURA'
                                      BINARY SEARCH
                                      INTO lwa_caract_charg TRANSPORTING atflv.
  MOVE lwa_caract_charg-atflv TO lv_charg_larg.

  IF lv_charg_larg < lv_matnr_tol_min_larg.
    p_matches = 'I'.  "Descartar devido inconsistencia Largura
    RETURN.
  ENDIF.
**********************************************************************


**********************************************************************
* Consistencia da Espessura
**********************************************************************
* Esp CHARG
  CLEAR lwa_caract_charg.
  READ TABLE it_caract_charg WITH KEY matnr = p_wa_mchbcar-matnr
                                      charg = p_wa_mchbcar-charg
                                      atnam = 'SD_ESPESSURA'
                                      BINARY SEARCH
                                      INTO lwa_caract_charg TRANSPORTING atflv.
  MOVE lwa_caract_charg-atflv TO lv_charg_esp.

* Tol Min Esp CHARG
  CLEAR lwa_caract_charg.
  READ TABLE it_caract_charg WITH KEY matnr = p_wa_mchbcar-matnr
                                      charg = p_wa_mchbcar-charg
                                      atnam = 'SD_TOL_MIN_ESPESSURA'
                                      BINARY SEARCH
                                      INTO lwa_caract_charg TRANSPORTING atflv.
  MOVE lwa_caract_charg-atflv TO lv_charg_tol_min_esp.

*Tol Max Esp CHARG
  CLEAR lwa_caract_charg.
  READ TABLE it_caract_charg WITH KEY matnr = p_wa_mchbcar-matnr
                                      charg = p_wa_mchbcar-charg
                                      atnam = 'SD_TOL_MAX_ESPESSURA'
                                      BINARY SEARCH
                                      INTO lwa_caract_charg TRANSPORTING atflv.
  MOVE lwa_caract_charg-atflv TO lv_charg_tol_max_esp.


  lv_charg_tol_min_esp = lv_charg_esp - lv_charg_tol_min_esp.
  lv_charg_tol_max_esp = lv_charg_esp + lv_charg_tol_max_esp.

******************** 34K ******************************
* Esp MATNR
  CLEAR lwa_caract_matnr.
  READ TABLE it_caract_matnr WITH KEY matnr = p_matnr
                                      atnam = 'SD_ESPESSURA'
                                      BINARY SEARCH
                                      INTO lwa_caract_matnr TRANSPORTING atflv.
  MOVE lwa_caract_matnr-atflv TO lv_matnr_esp.

* Tol Min Esp MATNR
  CLEAR lwa_caract_matnr.
  READ TABLE it_caract_matnr WITH KEY matnr = p_matnr
                                      atnam = 'SD_TOL_MIN_ESPESSURA'
                                      BINARY SEARCH
                                      INTO lwa_caract_matnr TRANSPORTING atflv.
  MOVE lwa_caract_matnr-atflv TO lv_matnr_tol_min_esp.

* Tol Max Esp MATNR
  CLEAR lwa_caract_matnr.
  READ TABLE it_caract_matnr WITH KEY matnr = p_matnr
                                      atnam = 'SD_TOL_MAX_ESPESSURA'
                                      BINARY SEARCH
                                      INTO lwa_caract_matnr TRANSPORTING atflv.
  MOVE lwa_caract_matnr-atflv TO lv_matnr_tol_max_esp.

******************** 54K ******************************
  "Se não encontrar as caracteristicas com o material de 34k buscar com o de 54k
  IF lv_matnr_esp IS INITIAL AND lv_matnr_tol_min_esp IS INITIAL AND lv_matnr_tol_max_esp IS INITIAL.

    IF p_matnr BETWEEN '34000000' AND '34999999'.

      CLEAR: lwa_caract_matnr, lv_matnr_sd_hierarquia_produto.
      READ TABLE it_caract_matnr WITH KEY matnr = p_matnr
                                          atnam = 'SD_HIERARQUIA_PRODUTO'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr TRANSPORTING atwrt.
      lv_matnr_sd_hierarquia_produto = lwa_caract_matnr-atwrt.

      IF lv_matnr_sd_hierarquia_produto IS NOT INITIAL AND lv_matnr_sd_hierarquia_produto CS 'SOLDA'.

        READ TABLE it_mast INTO DATA(wa_mast) WITH KEY matnr = p_matnr
                                                       werks = p_werks BINARY SEARCH.

        IF sy-subrc EQ 0.

* Esp MATNR
          CLEAR lwa_caract_matnr.
          READ TABLE it_caract_matnr WITH KEY matnr = wa_mast-idnrk
                                              atnam = 'SD_ESPESSURA'
                                              BINARY SEARCH
                                              INTO lwa_caract_matnr TRANSPORTING atflv.
          MOVE lwa_caract_matnr-atflv TO lv_matnr_esp.

* Tol Min Esp MATNR
          CLEAR lwa_caract_matnr.
          READ TABLE it_caract_matnr WITH KEY matnr = wa_mast-idnrk
                                              atnam = 'SD_TOL_MIN_ESPESSURA'
                                              BINARY SEARCH
                                              INTO lwa_caract_matnr TRANSPORTING atflv.
          MOVE lwa_caract_matnr-atflv TO lv_matnr_tol_min_esp.

* Tol Max Esp MATNR
          CLEAR lwa_caract_matnr.
          READ TABLE it_caract_matnr WITH KEY matnr = wa_mast-idnrk
                                              atnam = 'SD_TOL_MAX_ESPESSURA'
                                              BINARY SEARCH
                                              INTO lwa_caract_matnr TRANSPORTING atflv.
          MOVE lwa_caract_matnr-atflv TO lv_matnr_tol_max_esp.

        ENDIF.

      ENDIF.

    ENDIF.

  ENDIF.

  lv_matnr_tol_min_esp = lv_matnr_esp - lv_matnr_tol_min_esp.
  lv_matnr_tol_max_esp = lv_matnr_esp + lv_matnr_tol_max_esp.


  "Consistencia Espessura
  "a faixa de tolerância do Lote deve estar compreendida na faixa do 34k
  CLEAR lv_erro_tol_esp.
  IF lv_charg_tol_min_esp NOT BETWEEN lv_matnr_tol_min_esp AND lv_matnr_tol_max_esp OR
     lv_charg_tol_max_esp NOT BETWEEN lv_matnr_tol_min_esp AND lv_matnr_tol_max_esp.
    lv_erro_tol_esp = 'X'.
  ENDIF.

  "quando não ocorrer compreensão entre as faixas de espessura
  "mas a nominal do lote atender o item acabado,
  "exibir na tela de restrito com a mensagem “divergência de tolerância de Espessura”.
  IF lv_erro_tol_esp = 'X'.

    IF lv_charg_esp = lv_matnr_esp.
*      p_matches = ''.
      MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
      wa_result-werks_apl = p_werks.
      wa_result-matnr_apl = p_matnr.
*     Stefanini/Elaine Omine - PRJ1372 - 25/07/2023 - Início
      wa_result-idnrk_apl = wa_lista_tecnica-idnrk.
      wa_result-lgort_apl = wa_marc-lgpro.
*     Stefanini/Elaine Omine - PRJ1372 - 25/07/2023 - Fim
      CONCATENATE 'Dimensional >>' 'Divergência de tolerância de Espessura' INTO wa_result-log SEPARATED BY space.
      APPEND wa_result TO it_result.
      CLEAR wa_result.
    ELSE.
      p_matches = 'I'.  "Descartar devido inconsistencia Espessura
*      MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
*      wa_result-werks_apl = p_werks.
*      wa_result-matnr_apl = p_matnr.
*      wa_result-xloek     = 'D'.
*      CONCATENATE 'Dimensional >>' 'Inconsistência de espessura' INTO wa_result-log SEPARATED BY space.
*      APPEND wa_result TO it_result.
*      CLEAR wa_result.
    ENDIF.

  ENDIF.
**********************************************************************

ENDFORM.                    " F_CONSISTE_DIMENSIONAL

