    SORT lit_matnr_objek BY objek.
    DELETE ADJACENT DUPLICATES FROM lit_matnr_objek COMPARING objek.
    SELECT objek cuobj
      FROM inob
      INTO TABLE lit_inob
      FOR ALL ENTRIES IN lit_matnr_objek
      WHERE obtab = 'MARA'
        AND objek EQ lit_matnr_objek-objek
        AND klart = '023'.
  ENDIF.

  IF lit_charg_objek[] IS NOT INITIAL.
    SORT lit_charg_objek BY objek.
    DELETE ADJACENT DUPLICATES FROM lit_charg_objek COMPARING objek.
    SELECT objek cuobj
      FROM inob
      APPENDING TABLE lit_inob
      FOR ALL ENTRIES IN lit_charg_objek
      WHERE obtab = 'MCH1'
        AND objek EQ lit_charg_objek-objek
        AND klart = '023'.
  ENDIF.

