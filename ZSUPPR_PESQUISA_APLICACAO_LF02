*          lwa_oest-resbp = 'X'. "Reserva parcial do lote
*        ELSE.
*          lwa_oest-resbp = ''.
*        ENDIF.
        lwa_oest-resbp     = ''.
*       Stefanini/Elaine Omine - PRJ1372 - 25/08/2023 - Fim
        lwa_oest-seq       = lv_seq_oest.
        lwa_oest-cprog     = 'ZPPR_PROCESSA_NECESSIDADE_MP'.
        lwa_oest-usuario   = sy-uname.
        lwa_oest-data      = sy-datum.
        lwa_oest-cputm     = sy-uzeit.
*       Stefanini/Elaine Omine - PRJ1372 - 12/09/2023 - Início
        lwa_oest-decendio  = gv_decendio.
*       Stefanini/Elaine Omine - PRJ1372 - 12/09/2023 - Fim
        INSERT zppt_oest FROM lwa_oest.
        COMMIT WORK.
        CLEAR: lwa_oest.
      ENDIF.

      "APAGA NA TABELA ZPPT_PAJT
      DELETE FROM zppt_pajt WHERE ( cprog EQ 'ZPPR_PROCESSA_NECESSIDADE_MP' OR
                                    cprog EQ 'ZSUPPR_PROCESSA_SOLICITACAO_MP' )
*                              AND ernam NE 'JOBTNG1'
                              AND werks EQ wa_outtab-werks
                              AND matnr EQ wa_outtab-matnr
                              AND charg EQ wa_outtab-charg
                              AND werks_apl EQ wa_outtab-werks_apl
                              AND matnr_apl EQ wa_outtab-matnr_apl.
*                              AND erdat  < gv_datacong.              " 03.03.203 - PRJ13
      COMMIT WORK AND WAIT.

      CLEAR: wa_outtab.

    ENDLOOP.

    IF g_tab_appl-subscreen = '0201'.
      DELETE gt_outtab1 WHERE mark = 'X'.
      CALL METHOD gr_table1->refresh_table_display.
    ELSEIF g_tab_appl-subscreen = '0202'.
      DELETE gt_outtab2 WHERE mark = 'X'.
      CALL METHOD gr_table2->refresh_table_display.
    ELSE.
      DELETE gt_outtab3 WHERE mark = 'X'.
      CALL METHOD gr_table3->refresh_table_display.
    ENDIF.

  ENDIF.

ENDFORM.                    " F_SOLICITAR_APROVACAO_200

