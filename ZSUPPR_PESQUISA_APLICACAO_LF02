          SET PARAMETER ID 'WRK' FIELD wa_outtab-werks.
          SET PARAMETER ID 'CHA' FIELD ''.
          CALL TRANSACTION 'MMBE'.
        ELSE.
          CLEAR lit_param[].
          lwa-parid = 'MAT'.
          lwa-parval = wa_outtab-matnr.
          APPEND lwa TO lit_param.

          CALL FUNCTION 'ABAP4_CALL_TRANSACTION' STARTING NEW TASK 'MM02'
            EXPORTING
              tcode                   = 'MM02'
              skip_screen             = 'X'
            TABLES
              spagpa_tab              = lit_param
            EXCEPTIONS
              call_transaction_denied = 1
              tcode_invalid           = 2
              OTHERS                  = 3.
          IF sy-subrc <> 0.
            MESSAGE 'Não foi possível abrir a transação MM02!' TYPE 'S'.
          ENDIF.
        ENDIF.
      ENDIF.
    WHEN 'CALL_OBS'.                            "<<< F.M
*      IF wa_outtab-tp_certifica <> 'N'. "Checa se permite atribuição de anexo.
      CONCATENATE 'Anexos/Notas para:'  wa_outtab-werks wa_outtab-matnr wa_outtab-charg wa_outtab-lgort INTO v_call_oexp. "-instid SEPARATED BY ' '.

      "Função Z que chama anexo
      CALL FUNCTION 'ZPPF_ANEXO_MP'
        EXPORTING
          im_concat   = v_call_oexp
        IMPORTING
          ep_document = lv_document.
*        ENDIF.

      IF lv_document IS NOT INITIAL. "Se preenchida, flega campo derroga e salva na tab. transparente
*        wa_outtab-derroga = 'X'.

        CASE p_sender.
          WHEN gr_table3.
            MODIFY gt_outtab3 FROM wa_outtab INDEX p_es_row_no_row_id.
            MOVE-CORRESPONDING wa_outtab TO lwa_oest_d.
            MODIFY zppt_oest FROM lwa_oest_d.
            COMMIT WORK.
            IF sy-subrc = 0.
              MESSAGE 'Anexo inserido com sucesso!' TYPE 'S'.
            ENDIF.
        ENDCASE.
      ENDIF.
      CLEAR: lwa_oest_d.


      gr_table3->check_changed_data( ).
      CALL METHOD gr_table3->set_ready_for_input
        EXPORTING
          i_ready_for_input = 1.
      CALL METHOD gr_table3->refresh_table_display. "<<< F.M
*    WHEN 'DERROGA'.
*      IF wa_outtab-tp_certifica <> 'N'. "Checa se permite atribuição de anexo.
*        wa_outtab-derroga = 'X'.
*
*        CASE p_sender.
*          WHEN gr_table3.
*            MODIFY gt_outtab3 FROM wa_outtab INDEX p_es_row_no_row_id.
