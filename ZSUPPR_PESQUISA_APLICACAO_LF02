FORM f_seleciona_parametros .

  CLEAR: gv_horizonte_demanda,
         gv_estoque_minimo.

  SELECT *
    FROM zsuget_variaveis
     INTO wa_zsuget_variaveis
       WHERE repid  = 'ZSUPPR_COCKPIT_MP_ALTERNATIVA'
         AND filtro  = 'HORIZONTE_DEMANDA'
         AND field  = 'ATWRT'.
  ENDSELECT.
  IF sy-subrc IS INITIAL.
    gv_horizonte_demanda = wa_zsuget_variaveis-valor.
  ENDIF.

  SELECT *
    FROM zsuget_variaveis
     INTO wa_zsuget_variaveis
       WHERE repid  = 'ZSUPPR_COCKPIT_MP_ALTERNATIVA'
         AND filtro  = 'ESTOQUE_MINIMO'
         AND field  = 'ATWRT'.
  ENDSELECT.
  IF sy-subrc IS INITIAL.
    gv_estoque_minimo = wa_zsuget_variaveis-valor.
  ENDIF.

* Início inclusão - 03.03.203 - PRJ1372
