*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM f_somar_qtd_reservada_231 .

  DATA  lit_resb TYPE STANDARD TABLE OF resb.

  SELECT rsnum rspos rsart matnr werks lgort charg bdmng bwart kdauf banfn enmng
    INTO CORRESPONDING FIELDS OF TABLE lit_resb
    FROM resb
    FOR ALL ENTRIES IN gt_outtab_all
    WHERE matnr   = gt_outtab_all-matnr
      AND werks   = gt_outtab_all-werks
      AND xloek   = ''
      AND lgort   = gt_outtab_all-lgort
      AND charg   = gt_outtab_all-charg
      AND kzear   = ''.
  IF sy-subrc IS INITIAL.

    "Somar qtd reservada e qtd retirada
    CLEAR it_resb_aux[].
    it_resb_aux[] = lit_resb[].
    DELETE it_resb_aux WHERE bwart NE '231'.

    LOOP AT it_resb_aux INTO DATA(ls_resb).

      CLEAR wa_resb_231.
      wa_resb_231-matnr = ls_resb-matnr.
      wa_resb_231-werks = ls_resb-werks.
      wa_resb_231-lgort = ls_resb-lgort.
      wa_resb_231-charg = ls_resb-charg.
      wa_resb_231-bdmng = ls_resb-bdmng.
      wa_resb_231-enmng = ls_resb-enmng.
      COLLECT wa_resb_231 INTO it_resb_231.
    ENDLOOP.

  ENDIF.

ENDFORM.
