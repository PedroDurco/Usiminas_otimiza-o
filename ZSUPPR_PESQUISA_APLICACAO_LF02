*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_aprovar_200 .

  TYPES: BEGIN OF ty_log.
  TYPES: werks    TYPE werks_d.
  TYPES: lgort_pa  TYPE lgort_d.
  TYPES: matnr    TYPE matnr.
  TYPES: idnrk    TYPE idnrk.
  TYPES: charg TYPE charg_d.
         INCLUDE TYPE message.
         TYPES: END OF ty_log.

  DATA: ti_log TYPE TABLE OF ty_log WITH HEADER LINE.

  DATA: lit_zppt_gi TYPE TABLE OF zppt_gi,
        lwa_zppt_gi TYPE zppt_gi.

  DATA lwa_zsuppt_lista_alt TYPE zsuppt_lista_alt.
  DATA lwa_zppt_oest_log    TYPE zppt_oest_log.

  DATA: l_msgno   TYPE sy-msgno,
        e_message TYPE message,
        t_tabmes  TYPE bdcmsgcoll OCCURS 0 WITH HEADER LINE.

  DATA ls_selrow  TYPE lvc_s_row.
  DATA ls_selrow_aux  TYPE lvc_s_row.

  DATA: lv_lgort_charg TYPE mchb-lgort,
        lv_mchb_clabs  TYPE mchb-clabs,
        lv_rsnum       TYPE resb-rsnum,
        lv_rsnum_sel   TYPE resb-rsnum,
        lv_rspos       TYPE resb-rspos,
        lv_tot_reserva TYPE mchb-clabs,
        lt_return      TYPE TABLE OF bapiret2.

  REFRESH gt_rows.
  IF g_tab_appl-subscreen = '0201'.
    CALL METHOD gr_table1->get_selected_rows
      IMPORTING
        et_index_rows = gt_rows.
  ELSEIF g_tab_appl-subscreen = '0202'.
    CALL METHOD gr_table2->get_selected_rows
      IMPORTING
        et_index_rows = gt_rows.
  ELSE.
    CALL METHOD gr_table3->get_selected_rows
      IMPORTING
        et_index_rows = gt_rows.
  ENDIF.

  IF gt_rows[] IS INITIAL.
    MESSAGE e000(su) WITH text-m02.
  ELSE.

    CLEAR gt_outtab_all[].

    LOOP AT gt_rows INTO ls_selrow.
      IF g_tab_appl-subscreen = '0201'.
        READ TABLE gt_outtab1 INTO wa_outtab INDEX ls_selrow-index.

        LOOP AT gt_outtab1 INTO DATA(ls_outtab1) WHERE matnr     = wa_outtab-matnr
                                                   AND charg     = wa_outtab-charg
                                                   AND matnr_apl = wa_outtab-matnr_apl.
          APPEND ls_outtab1 TO gt_outtab_all.
        ENDLOOP.

      ELSEIF g_tab_appl-subscreen = '0202'.
        READ TABLE gt_outtab2 INTO wa_outtab INDEX ls_selrow-index.

        LOOP AT gt_outtab2 INTO DATA(ls_outtab2) WHERE matnr     = wa_outtab-matnr
                                                   AND charg     = wa_outtab-charg
                                                   AND matnr_apl = wa_outtab-matnr_apl.
          APPEND ls_outtab2 TO gt_outtab_all.
        ENDLOOP.

      ELSE.
        READ TABLE gt_outtab3 INTO wa_outtab INDEX ls_selrow-index.

        LOOP AT gt_outtab3 INTO DATA(ls_outtab3) WHERE matnr     = wa_outtab-matnr
                                                   AND charg     = wa_outtab-charg
                                                   AND matnr_apl = wa_outtab-matnr_apl.
          APPEND ls_outtab3 TO gt_outtab_all.
        ENDLOOP.

      ENDIF.

    ENDLOOP.

    SELECT *
      FROM zppt_gi
      INTO TABLE lit_zppt_gi.
    SORT lit_zppt_gi BY matnr.

    SORT gt_outtab_all BY matnr charg matnr_apl clabs.
    DELETE ADJACENT DUPLICATES FROM gt_outtab_all COMPARING matnr charg matnr_apl clabs.

    PERFORM f_somar_qtd_reservada_231.

    SELECT *
      FROM zsuppt_lista_alt
      INTO TABLE @DATA(lt_lista_alt)
      FOR ALL ENTRIES IN @gt_outtab_all
      WHERE matnr      = @gt_outtab_all-matnr
        AND charg      = @gt_outtab_all-charg
        AND matnr_pa   = @gt_outtab_all-matnr_apl
        AND desativada = ''.

    DATA(vl_uzeit) = sy-uzeit.
    LOOP AT gt_outtab_all INTO wa_outtab.

      gv_tabix = sy-tabix.

      "INSERE NA TABELA ZSUPPT_LISTA_ALT
      lwa_zsuppt_lista_alt-mandt        = sy-mandt.
      lwa_zsuppt_lista_alt-werks        = wa_outtab-werks_apl.
      lwa_zsuppt_lista_alt-matnr_pa     = wa_outtab-matnr_apl.
      lwa_zsuppt_lista_alt-udate        = sy-datum.
      lwa_zsuppt_lista_alt-utime        = vl_uzeit.
      lwa_zsuppt_lista_alt-capabil      = wa_outtab-capabil.
      SELECT SINGLE lgpro
        FROM marc
        INTO lwa_zsuppt_lista_alt-lgort_origem
        WHERE matnr = wa_outtab-matnr_apl
          AND werks = wa_outtab-werks_apl.

      SELECT SINGLE pn_cli kunnr
        INTO (lwa_zsuppt_lista_alt-pn_cli, lwa_zsuppt_lista_alt-kunnr)
        FROM zsdt_part_number
       WHERE material  = wa_outtab-matnr_apl
          AND zf_status = 'A'.

      lwa_zsuppt_lista_alt-matnr     = wa_outtab-matnr.
      lwa_zsuppt_lista_alt-charg     = wa_outtab-charg.
      lwa_zsuppt_lista_alt-lgort     = wa_outtab-lgort.

      lwa_zsuppt_lista_alt-dt_lib_om = wa_outtab-data.
      lwa_zsuppt_lista_alt-uname_om  = wa_outtab-usuario.
      lwa_zsuppt_lista_alt-dt_lib_qa = sy-datum.
      lwa_zsuppt_lista_alt-uname_qa  = sy-uname.

      CLEAR: lv_mchb_clabs, lv_lgort_charg.
      SELECT SINGLE clabs lgort
        FROM mchb
        INTO (lv_mchb_clabs, lv_lgort_charg)
        WHERE werks EQ wa_outtab-werks
          AND matnr EQ wa_outtab-matnr
          AND charg EQ wa_outtab-charg
          AND clabs GT 0.

      CLEAR lv_tot_reserva.

      "Verificar se o lote tem transferência
      IF lv_lgort_charg <> lwa_zsuppt_lista_alt-lgort_origem OR sy-subrc NE 0.

        READ TABLE it_resb_231 INTO wa_resb_231 WITH KEY matnr = wa_outtab-matnr
                                                         werks = wa_outtab-werks
                                                         charg = wa_outtab-charg.
        IF sy-subrc EQ 0.
          lv_tot_reserva = wa_outtab-clabs + wa_resb_231-bdmng.
        ELSE.
          lv_tot_reserva = wa_outtab-clabs.
        ENDIF.

        "Processado totalmente
        IF lv_tot_reserva >= lv_mchb_clabs. "AND sy-subrc EQ 0. "AND wa_outtab-resbp IS INITIAL.

*         Stefanini/Elaine Omine - PRJ1372 - 21/07/2023 - Início
*          LOOP AT lt_lista_alt INTO DATA(ls_lista_alt) WHERE matnr    = wa_outtab-matnr
*                                                         AND charg    = wa_outtab-charg
*                                                         AND matnr_pa = wa_outtab-matnr_apl.
*            CALL FUNCTION 'BAPI_RESERVATION_DELETE'
*              EXPORTING
*                reservation = ls_lista_alt-rsnum
*              TABLES
*                return      = lt_return.
*
*            CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
*              EXPORTING
*                wait = 'X'.
*
*          ENDLOOP.
*
*          "EFETUAR RESERVA DO LOTE
*          SELECT SINGLE matnr
*            FROM resb
*            INTO @DATA(lv_matnr)
*            WHERE matnr = @wa_outtab-matnr
*              AND werks = @wa_outtab-werks
*              AND xloek EQ ''
*              AND kzear EQ ''
*              AND charg = @wa_outtab-charg
*              AND bdmng = @wa_outtab-clabs
*              AND kdauf = 'EMPRODUÇÃO'
*              AND kdpos = '000001'
*              AND bwart = '231'.
*
*          IF sy-subrc NE 0.
*
*            PERFORM f_criar_reserva_producao USING wa_outtab
*                                                   wa_outtab-lgort_apl
*                                                   lv_mchb_clabs
*                                          CHANGING lv_rsnum
*                                                   lv_rspos.
*          ENDIF.
*         Stefanini/Elaine Omine - PRJ1372 - 21/07/2023 - Fim

                                                            "RDM 270984
          "Para as aplicações de valores menores que valor total do lote (valores parcial), não haverá transferência de depósitos.
          CLEAR t_tabmes[].

* fazer a mov do lote utilizando - ZPPF_TRANSF_LOTE_DEP
          CALL FUNCTION 'ZPPF_TRANSF_LOTE_DEP'
            EXPORTING
              centro        = wa_outtab-werks
              material      = wa_outtab-matnr
              lote          = wa_outtab-charg
              deposito_de   = lv_lgort_charg                    "deposito do lote
              deposito_para = lwa_zsuppt_lista_alt-lgort_origem "deposito do SKU
              quantidade    = lv_mchb_clabs
              testrun       = ' '
            TABLES
              t_tabmes      = t_tabmes
            EXCEPTIONS
              no_initial    = 1
              OTHERS        = 2.
          IF sy-subrc EQ 0.
            READ TABLE t_tabmes INDEX 1.
            IF sy-subrc EQ 0.

              IF t_tabmes-msgtyp NE 'S'.
                MOVE t_tabmes-msgnr TO l_msgno.

                IF NOT t_tabmes-msgtyp IS INITIAL.

                  CALL FUNCTION 'WRITE_MESSAGE'
                    EXPORTING
                      msgid = t_tabmes-msgid
                      msgno = l_msgno
                      msgty = t_tabmes-msgtyp
                      msgv1 = t_tabmes-msgv1
                      msgv2 = t_tabmes-msgv2
                      msgv3 = t_tabmes-msgv3
                      msgv4 = t_tabmes-msgv4
                    IMPORTING
                      messg = e_message.

                  ti_log-werks    = lwa_zsuppt_lista_alt-werks.
                  ti_log-lgort_pa = lwa_zsuppt_lista_alt-lgort_origem.
                  ti_log-matnr    = lwa_zsuppt_lista_alt-matnr_pa.
                  ti_log-idnrk    = lwa_zsuppt_lista_alt-matnr.
                  ti_log-charg    = lwa_zsuppt_lista_alt-charg.
                  MOVE-CORRESPONDING e_message TO ti_log.
                  CONCATENATE 'Erro na transf de dep da mp:'(011)
                              ti_log-msgtx
                              INTO ti_log-msgtx SEPARATED BY space.
                  APPEND ti_log.

                ENDIF.
*             Stefanini/Elaine Omine - PRJ1372 - 31/07/2023 - Início
              ELSE.
                LOOP AT lt_lista_alt INTO DATA(ls_lista_alt) WHERE matnr    = wa_outtab-matnr
                                                               AND charg    = wa_outtab-charg
                                                               AND matnr_pa = wa_outtab-matnr_apl.
                  CALL FUNCTION 'BAPI_RESERVATION_DELETE'
                    EXPORTING
                      reservation = ls_lista_alt-rsnum
                    TABLES
                      return      = lt_return.

                  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
                    EXPORTING
                      wait = 'X'.

                ENDLOOP.

                "EFETUAR RESERVA DO LOTE
                SELECT SINGLE matnr
                  FROM resb
                  INTO @DATA(lv_matnr)
                  WHERE matnr = @wa_outtab-matnr
                    AND werks = @wa_outtab-werks
                    AND xloek EQ ''
                    AND kzear EQ ''
                    AND charg = @wa_outtab-charg
                    AND bdmng = @wa_outtab-clabs
                    AND kdauf = 'EMPRODUÇÃO'
                    AND kdpos = '000001'
                    AND bwart = '231' ##NULL_VALUES_OK.

                IF sy-subrc NE 0.

                  PERFORM f_criar_reserva_producao USING wa_outtab
                                                         wa_outtab-lgort_apl
                                                         lv_mchb_clabs
                                                CHANGING lv_rsnum
                                                         lv_rspos.
                ENDIF.
*             Stefanini/Elaine Omine - PRJ1372 - 31/07/2023 - Fim
              ENDIF.
            ENDIF.
          ELSE.
            ti_log-werks    = lwa_zsuppt_lista_alt-werks.
            ti_log-lgort_pa = lwa_zsuppt_lista_alt-lgort_origem.
            ti_log-matnr    = lwa_zsuppt_lista_alt-matnr_pa.
            ti_log-idnrk    = lwa_zsuppt_lista_alt-matnr.
            ti_log-charg    = lwa_zsuppt_lista_alt-charg.
            ti_log-msgty    = 'E'.
            CONCATENATE 'Erro na transf de dep da mp:'(011)
                         ti_log-msgtx
                         INTO ti_log-msgtx SEPARATED BY space.
            APPEND ti_log.
          ENDIF.
          "Processado parcialmente
        ELSE.

          "EFETUAR RESERVA DO LOTE
          SELECT SINGLE matnr
            FROM resb
            INTO @lv_matnr
            WHERE matnr = @wa_outtab-matnr
              AND werks = @wa_outtab-werks
              AND xloek EQ ''
              AND kzear EQ ''
              AND charg = @wa_outtab-charg
              AND bdmng = @wa_outtab-clabs
              AND kdauf = 'EMPRODUÇÃO'
              AND kdpos = '000001'
              AND bwart = '231' ##NULL_VALUES_OK.

          IF sy-subrc NE 0.
            PERFORM f_criar_reserva_producao USING    wa_outtab
                                                      wa_outtab-lgort
                                                      wa_outtab-clabs
                                             CHANGING lv_rsnum
                                                      lv_rspos.
          ENDIF.


        ENDIF.

        "Lote sem transferência
      ELSE.

        "EFETUAR RESERVA DO LOTE
        SELECT SINGLE matnr, rsnum
          FROM resb
          INTO ( @lv_matnr, @lv_rsnum_sel )
          WHERE matnr = @wa_outtab-matnr
            AND werks = @wa_outtab-werks
            AND xloek EQ ''
            AND kzear EQ ''
            AND charg = @wa_outtab-charg
            AND bdmng = @wa_outtab-clabs
            AND kdauf = 'EMPRODUÇÃO'
            AND kdpos = '000001'
            AND bwart = '231' ##NULL_VALUES_OK.

        IF sy-subrc NE 0.
          PERFORM f_criar_reserva_producao USING wa_outtab
                                                 wa_outtab-lgort
                                                 wa_outtab-clabs
                                        CHANGING lv_rsnum
                                                 lv_rspos.
        ELSE.
          lv_rsnum = lv_rsnum_sel.
        ENDIF.

      ENDIF.

      IF NOT ti_log-msgtx IS INITIAL.
        CLEAR ti_log.
        CONTINUE.
      ENDIF.

      lwa_zsuppt_lista_alt-rsnum = lv_rsnum.
      lwa_zsuppt_lista_alt-rspos = lv_rspos.
      lwa_zsuppt_lista_alt-clabs = wa_outtab-clabs.
      INSERT INTO zsuppt_lista_alt VALUES lwa_zsuppt_lista_alt.
      IF sy-subrc EQ 0.

*       Stefanini/Elaine Omine - PRJ1372 - 12/09/2023 - Início
        SELECT SINGLE cprog, decendio
          FROM zppt_oest
          INTO @DATA(wl_oest)
         WHERE werks     EQ @wa_outtab-werks
           AND matnr     EQ @wa_outtab-matnr
           AND charg     EQ @wa_outtab-charg
           AND werks_apl EQ @wa_outtab-werks_apl
           AND matnr_apl EQ @wa_outtab-matnr_apl.
        IF sy-subrc NE 0.
          CLEAR wl_oest.
        ELSEIF wl_oest-cprog NE 'ZPPR_PROCESSA_NECESSIDADE_MP'.
          "Se o registro não for do Otimizador, define o decêndio com base na data do dia
          IF sy-datum+6(2) LE 10.
            wl_oest-decendio = sy-datum(6) && '01'.
          ELSEIF sy-datum+6(2) LE 20.
            wl_oest-decendio = sy-datum(6) && '11'.
          ELSE.
            wl_oest-decendio = sy-datum(6) && '21'.
          ENDIF.
        ENDIF.
*       Stefanini/Elaine Omine - PRJ1372 - 12/09/2023 - Fim

        "APAGA NA TABELA ZPPT_OEST
        DELETE FROM zppt_oest WHERE werks EQ wa_outtab-werks
                                AND matnr EQ wa_outtab-matnr
                                AND charg EQ wa_outtab-charg
                                AND werks_apl EQ wa_outtab-werks_apl
                                AND matnr_apl EQ wa_outtab-matnr_apl.

        "INSERE REGISTRO NA TABELA ZPPT_OEST_LOG
        MOVE-CORRESPONDING wa_outtab TO lwa_zppt_oest_log.

        READ TABLE lit_zppt_gi INTO lwa_zppt_gi
                                WITH KEY matnr = wa_outtab-idnrk_apl
                                BINARY SEARCH.
        IF sy-subrc IS INITIAL.
          lwa_zppt_oest_log-lgort_apl   = lwa_zppt_gi-deposito.
          lwa_zppt_oest_log-lote_minimo = lwa_zppt_gi-lote_minimo.
          lwa_zppt_oest_log-necessidade = lwa_zppt_gi-necessidade.
        ENDIF.

*       Stefanini/Elaine Omine - PRJ1372 - 12/09/2023 - Início
        lwa_zppt_oest_log-cprog       = wl_oest-cprog.
        lwa_zppt_oest_log-decendio    = wl_oest-decendio.
*       Stefanini/Elaine Omine - PRJ1372 - 12/09/2023 - Fim
        lwa_zppt_oest_log-udate       = sy-datum.
        lwa_zppt_oest_log-erdat       = sy-datum.
        lwa_zppt_oest_log-usuario_qa  = sy-uname.
        lwa_zppt_oest_log-data_qa     = sy-datum.
        lwa_zppt_oest_log-hora_qa     = vl_uzeit.
        lwa_zppt_oest_log-utime       = vl_uzeit.
        lwa_zppt_oest_log-situacao    = 'APROVADO'.
        INSERT INTO zppt_oest_log VALUES lwa_zppt_oest_log.

        COMMIT WORK AND WAIT.

        IF g_tab_appl-subscreen = '0201'.
          DELETE gt_outtab1 WHERE matnr     = wa_outtab-matnr
                              AND charg     = wa_outtab-charg
                              AND matnr_apl = wa_outtab-matnr_apl.
        ELSEIF g_tab_appl-subscreen = '0202'.
          DELETE gt_outtab2 WHERE matnr     = wa_outtab-matnr
                              AND charg     = wa_outtab-charg
                              AND matnr_apl = wa_outtab-matnr_apl.
        ELSE.
          DELETE gt_outtab3 WHERE matnr     = wa_outtab-matnr
                              AND charg     = wa_outtab-charg
                              AND matnr_apl = wa_outtab-matnr_apl.
        ENDIF.

      ENDIF.

      CLEAR: wa_outtab.

    ENDLOOP.

    IF g_tab_appl-subscreen = '0201'.
      CALL METHOD gr_table1->check_changed_data.
      CALL METHOD gr_table1->refresh_table_display.
    ELSEIF g_tab_appl-subscreen = '0202'.
      CALL METHOD gr_table2->check_changed_data.
      CALL METHOD gr_table2->refresh_table_display.
    ELSE.
      CALL METHOD gr_table3->check_changed_data.
      CALL METHOD gr_table3->refresh_table_display.
    ENDIF.

    IF NOT ti_log[] IS INITIAL.
      CALL FUNCTION 'ZSUPP_POPUP_ALV_DISPLAY'
        EXPORTING
          i_end_column = 130
          i_title      = 'Log de processamento'
        TABLES
          it_alv       = ti_log.
    ENDIF.

  ENDIF.

  FREE: ti_log, lit_zppt_gi.

ENDFORM.                    " F_APROVAR_200

*&---------------------------------------------------------------------*
*&      Form  F_REPROVAR_200
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_reprovar_200 .

  DATA: lit_zppt_gi TYPE TABLE OF zppt_gi,
        lwa_zppt_gi TYPE zppt_gi.

  DATA lwa_zppt_lta_reprov  TYPE zppt_lta_reprov.
  DATA lwa_zppt_oest_log    TYPE zppt_oest_log.

  DATA ls_selrow  TYPE lvc_s_row.
  DATA ls_selrow_aux  TYPE lvc_s_row.

  REFRESH gt_rows.
  IF g_tab_appl-subscreen = '0201'.
    CALL METHOD gr_table1->get_selected_rows
      IMPORTING
        et_index_rows = gt_rows.
  ELSEIF g_tab_appl-subscreen = '0202'.
    CALL METHOD gr_table2->get_selected_rows
      IMPORTING
        et_index_rows = gt_rows.
  ELSE.
    CALL METHOD gr_table3->get_selected_rows
      IMPORTING
        et_index_rows = gt_rows.
  ENDIF.

  IF gt_rows[] IS INITIAL.
    MESSAGE e000(su) WITH text-m02.
  ELSE.

    CLEAR: gt_rows_aux[].

    LOOP AT gt_rows INTO ls_selrow.
      IF g_tab_appl-subscreen = '0201'.
        READ TABLE gt_outtab1 INTO wa_outtab INDEX ls_selrow-index.

        LOOP AT gt_outtab1 INTO DATA(ls_outtab1) WHERE matnr     = wa_outtab-matnr
                                                   AND charg     = wa_outtab-charg
                                                   AND matnr_apl = wa_outtab-matnr_apl.
          ls_selrow_aux-index = sy-tabix.
          APPEND ls_selrow_aux TO gt_rows_aux.
        ENDLOOP.

      ELSEIF g_tab_appl-subscreen = '0202'.
        READ TABLE gt_outtab2 INTO wa_outtab INDEX ls_selrow-index.

        LOOP AT gt_outtab2 INTO DATA(ls_outtab2) WHERE matnr     = wa_outtab-matnr
                                                   AND charg     = wa_outtab-charg
                                                   AND matnr_apl = wa_outtab-matnr_apl.
          ls_selrow_aux-index = sy-tabix.
          APPEND ls_selrow_aux TO gt_rows_aux.
        ENDLOOP.

      ELSE.
        READ TABLE gt_outtab3 INTO wa_outtab INDEX ls_selrow-index.

        LOOP AT gt_outtab3 INTO DATA(ls_outtab3) WHERE matnr     = wa_outtab-matnr
                                                   AND charg     = wa_outtab-charg
                                                   AND matnr_apl = wa_outtab-matnr_apl.
          ls_selrow_aux-index = sy-tabix.
          APPEND ls_selrow_aux TO gt_rows_aux.
        ENDLOOP.

      ENDIF.

    ENDLOOP.

    CLEAR gt_rows[].
    SORT gt_rows_aux BY index.
    DELETE ADJACENT DUPLICATES FROM gt_rows_aux COMPARING index.
    APPEND LINES OF gt_rows_aux TO gt_rows.

    SELECT *
      FROM zppt_gi
      INTO TABLE lit_zppt_gi.
    SORT lit_zppt_gi BY matnr.

    LOOP AT gt_rows INTO ls_selrow.

      IF g_tab_appl-subscreen = '0201'.
        READ TABLE gt_outtab1 INTO wa_outtab INDEX ls_selrow-index.
      ELSEIF g_tab_appl-subscreen = '0202'.
        READ TABLE gt_outtab2 INTO wa_outtab INDEX ls_selrow-index.
      ELSE.
        READ TABLE gt_outtab3 INTO wa_outtab INDEX ls_selrow-index.
      ENDIF.

      IF NOT sy-subrc IS INITIAL.
        CONTINUE.
      ENDIF.

      wa_outtab-mark = 'X'.
      IF g_tab_appl-subscreen = '0201'.
        MODIFY gt_outtab1 FROM wa_outtab INDEX sy-tabix TRANSPORTING mark.
      ELSEIF g_tab_appl-subscreen = '0202'.
        MODIFY gt_outtab2 FROM wa_outtab INDEX sy-tabix TRANSPORTING mark.
      ELSE.
        MODIFY gt_outtab3 FROM wa_outtab INDEX sy-tabix TRANSPORTING mark.
      ENDIF.

      "INSERE NA TABELA ZPPT_LTA_REPROV para não sugerir novamente
      lwa_zppt_lta_reprov-mandt   = sy-mandt.
      lwa_zppt_lta_reprov-idnrk   = wa_outtab-matnr.
      lwa_zppt_lta_reprov-charg   = wa_outtab-charg.
      lwa_zppt_lta_reprov-matnr   = wa_outtab-matnr_apl.
      lwa_zppt_lta_reprov-usuario = sy-uname.
      lwa_zppt_lta_reprov-data    = sy-datum.
      INSERT INTO zppt_lta_reprov VALUES lwa_zppt_lta_reprov.

*     Stefanini/Elaine Omine - PRJ1372 - 12/09/2023 - Início
      SELECT SINGLE cprog, decendio
        FROM zppt_oest
        INTO @DATA(wl_oest)
       WHERE werks     EQ @wa_outtab-werks
         AND matnr     EQ @wa_outtab-matnr
         AND charg     EQ @wa_outtab-charg
         AND werks_apl EQ @wa_outtab-werks_apl
         AND matnr_apl EQ @wa_outtab-matnr_apl.
      IF sy-subrc NE 0.
        CLEAR wl_oest.
      ELSEIF wl_oest-cprog NE 'ZPPR_PROCESSA_NECESSIDADE_MP'.
        "Se o registro não for do Otimizador, define o decêndio com base na data do dia
        IF sy-datum+6(2) LE 10.
          wl_oest-decendio = sy-datum(6) && '01'.
        ELSEIF sy-datum+6(2) LE 20.
          wl_oest-decendio = sy-datum(6) && '11'.
        ELSE.
          wl_oest-decendio = sy-datum(6) && '21'.
        ENDIF.
      ENDIF.
*     Stefanini/Elaine Omine - PRJ1372 - 12/09/2023 - Fim

      "APAGA NA TABELA ZPPT_OEST
      DELETE FROM zppt_oest WHERE werks EQ wa_outtab-werks
                              AND matnr EQ wa_outtab-matnr
                              AND charg EQ wa_outtab-charg
                              AND werks_apl EQ wa_outtab-werks_apl
                              AND matnr_apl EQ wa_outtab-matnr_apl.

      "INSERE REGISTRO NA TABELA ZPPT_OEST_LOG
      MOVE-CORRESPONDING wa_outtab TO lwa_zppt_oest_log.

      READ TABLE lit_zppt_gi INTO lwa_zppt_gi
                              WITH KEY matnr = wa_outtab-idnrk_apl
                              BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        lwa_zppt_oest_log-lgort_apl   = lwa_zppt_gi-deposito.
        lwa_zppt_oest_log-lote_minimo = lwa_zppt_gi-lote_minimo.
        lwa_zppt_oest_log-necessidade = lwa_zppt_gi-necessidade.
      ENDIF.

*     Stefanini/Elaine Omine - PRJ1372 - 12/09/2023 - Início
      DELETE FROM zppt_pajt WHERE werks     EQ lwa_zppt_oest_log-werks
                              AND matnr     EQ lwa_zppt_oest_log-matnr
                              AND charg     EQ lwa_zppt_oest_log-charg
                              AND matnr_apl EQ lwa_zppt_oest_log-matnr_apl
                              AND clabs     EQ lwa_zppt_oest_log-clabs
                              AND cprog     EQ 'ZSUPPR_PROCESSA_SOLICITACAO_MP'.

      lwa_zppt_oest_log-cprog       = wl_oest-cprog.
      lwa_zppt_oest_log-decendio    = wl_oest-decendio.
*     Stefanini/Elaine Omine - PRJ1372 - 12/09/2023 - Fim
      lwa_zppt_oest_log-erdat       = sy-datum.
      lwa_zppt_oest_log-udate       = sy-datum.
      lwa_zppt_oest_log-usuario_qa  = sy-uname.
      lwa_zppt_oest_log-data_qa     = sy-datum.
      lwa_zppt_oest_log-hora_qa     = sy-uzeit.
      lwa_zppt_oest_log-utime       = sy-uzeit.
      lwa_zppt_oest_log-situacao    = 'REPROVADO'.
      INSERT INTO zppt_oest_log VALUES lwa_zppt_oest_log.

      COMMIT WORK AND WAIT.

      CLEAR: wa_outtab.

    ENDLOOP.

    IF g_tab_appl-subscreen = '0201'.
      DELETE gt_outtab1 WHERE mark = 'X'.
      CALL METHOD gr_table1->refresh_table_display.
    ELSEIF g_tab_appl-subscreen = '0202'.
      DELETE gt_outtab2 WHERE mark = 'X'.
      CALL METHOD gr_table2->refresh_table_display.
    ELSE.
      DELETE gt_outtab3 WHERE mark = 'X'.
      CALL METHOD gr_table3->refresh_table_display.
    ENDIF.

  ENDIF.

  FREE lit_zppt_gi.

ENDFORM.                    " F_REPROVAR_200

*&---------------------------------------------------------------------*
*&      Form  F_CARREGA_RESULTADO_JOB
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_carrega_resultado_job  USING p_uname.

  DATA: lv_index TYPE sy-tabix.

  DATA: lit_zppt_pajt TYPE TABLE OF zppt_pajt,
        lwa_zppt_pajt TYPE zppt_pajt.

  DATA: lit_marc TYPE TABLE OF marc,
        lwa_marc TYPE marc.

  DATA: lit_zppt_gi TYPE TABLE OF zppt_gi,
        lwa_zppt_gi TYPE zppt_gi.

  DATA: lv_restrito TYPE c,
        ls_outtab1  TYPE ty_outtab.

  SELECT *
    FROM zppt_pajt
    INTO TABLE lit_zppt_pajt
    WHERE cprog EQ sy-cprog
      AND ernam EQ p_uname.

  IF lit_zppt_pajt[] IS NOT INITIAL.
    SELECT matnr werks lgpro
      FROM marc
      INTO CORRESPONDING FIELDS OF TABLE lit_marc
      FOR ALL ENTRIES IN lit_zppt_pajt
      WHERE matnr = lit_zppt_pajt-matnr_apl
        AND werks = lit_zppt_pajt-werks_apl.
    SORT lit_marc BY matnr werks.

    IF sy-subrc EQ 0.

      SELECT *
        FROM zrnppt_prev
        INTO TABLE it_zrnppt_prev_capa
        FOR ALL ENTRIES IN lit_marc
        WHERE matnr = lit_marc-matnr.

      DELETE it_zrnppt_prev_capa WHERE ano >= sy-datum(4)
                                   AND mes >= sy-datum+4(2).

    ENDIF.

*   Stefanini/Elaine Omine - PRJ1372 - 18/08/2023 - Início
    SELECT *
      FROM zsuppt_lista_alt
      INTO TABLE @DATA(tl_lista_alt)
       FOR ALL ENTRIES IN @lit_zppt_pajt
     WHERE matnr      EQ @lit_zppt_pajt-matnr
       AND werks      EQ @lit_zppt_pajt-werks
       AND charg      EQ @lit_zppt_pajt-charg
       AND desativada EQ ''.
    LOOP AT tl_lista_alt INTO DATA(wl_lista_alt).
      DELETE lit_zppt_pajt WHERE matnr EQ wl_lista_alt-matnr
                             AND werks EQ wl_lista_alt-werks
                             AND charg EQ wl_lista_alt-charg.
    ENDLOOP.
    IF tl_lista_alt IS NOT INITIAL.
      SELECT *
        FROM zppt_oest
        INTO TABLE @DATA(tl_oest)
         FOR ALL ENTRIES IN @lit_zppt_pajt
       WHERE matnr EQ @lit_zppt_pajt-matnr
         AND werks EQ @lit_zppt_pajt-werks
         AND charg EQ @lit_zppt_pajt-charg.
      LOOP AT tl_oest INTO DATA(wl_oest).
        DELETE lit_zppt_pajt WHERE matnr EQ wl_oest-matnr
                               AND werks EQ wl_oest-werks
                               AND charg EQ wl_oest-charg.
      ENDLOOP.
    ENDIF.
    IF tl_lista_alt IS NOT INITIAL.
      SELECT *
        FROM resb
        INTO TABLE @DATA(tl_resb)
         FOR ALL ENTRIES IN @lit_zppt_pajt
       WHERE matnr EQ @lit_zppt_pajt-matnr
         AND werks EQ @lit_zppt_pajt-werks
         AND charg EQ @lit_zppt_pajt-charg
         AND xloek EQ ''
         AND kzear EQ ''.
      LOOP AT tl_resb INTO DATA(wl_resb).
        DELETE lit_zppt_pajt WHERE matnr EQ wl_resb-matnr
                               AND werks EQ wl_resb-werks
                               AND charg EQ wl_resb-charg.
      ENDLOOP.

    ENDIF.
*   Stefanini/Elaine Omine - PRJ1372 - 18/08/2023 - Fim

  ENDIF.

  SELECT *
    FROM zppt_gi
    INTO TABLE lit_zppt_gi.
  SORT lit_zppt_gi BY matnr.

  REFRESH gt_outtab1.

  LOOP AT lit_zppt_pajt INTO lwa_zppt_pajt.
    MOVE-CORRESPONDING lwa_zppt_pajt TO wa_outtab.

    IF wa_outtab-lgort_apl IS INITIAL.
      READ TABLE lit_marc INTO lwa_marc WITH KEY matnr = lwa_zppt_pajt-matnr_apl
                                                 werks = lwa_zppt_pajt-werks_apl
                                                 BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-lgort_apl = lwa_marc-lgpro.
      ENDIF.
    ENDIF.

    READ TABLE lit_zppt_gi INTO lwa_zppt_gi WITH KEY matnr = lwa_zppt_pajt-idnrk_apl
                                            BINARY SEARCH.
    IF sy-subrc IS INITIAL.
      wa_outtab-necessidade_mp = lwa_zppt_gi-necessidade.
    ENDIF.

    IF wa_outtab-log IS INITIAL.

*      "Não executar para o "Qualidade - Solicitações pendentes'
*      IF p_dynnr NE '300'.
*        "Campos de analise financeira na consulta dos materiais alternativos
*        PERFORM f_analise_financeira_capabil CHANGING wa_outtab.
*      ENDIF.

      wa_outtab-capabil = 'OK'.
      APPEND wa_outtab TO gt_outtab1.

    ELSE.

      IF wa_outtab-xloek EQ 'E'.
        wa_outtab-statustxt = 'CAPABILIDADE'.
        wa_outtab-icon_stt  = icon_yellow_light.
      ELSEIF wa_outtab-xloek EQ 'C'.
        wa_outtab-statustxt = 'CAPABILIDADE'.
        wa_outtab-icon_stt  = icon_yellow_light.
      ELSEIF wa_outtab-xloek EQ 'M'.
        wa_outtab-statustxt = 'CONSULTA'.
        wa_outtab-icon_stt  = icon_yellow_light.
      ELSEIF wa_outtab-xloek EQ 'R'.
        wa_outtab-statustxt = 'CAPABILIDADE'.
        wa_outtab-icon_stt  = icon_yellow_light.
      ELSEIF wa_outtab-xloek EQ 'A'.
        wa_outtab-statustxt = 'CERTIFICADO'.
        wa_outtab-icon_stt  = icon_yellow_light.
      ENDIF.

*     Stefanini/Elaine Omine - PRJ1372 - 21/07/2023 - Início
      IF wa_outtab-xloek EQ 'E' OR
         wa_outtab-xloek EQ 'C' OR
         wa_outtab-xloek EQ 'R'.
        wa_outtab-capabil = 'NOK'.
      ELSE.
        wa_outtab-capabil = 'OK'.
      ENDIF.
*     Stefanini/Elaine Omine - PRJ1372 - 21/07/2023 - Fim

*      "Não executar para o "Qualidade - Solicitações pendentes'
*      IF p_dynnr NE '300'.
*        "Campos de analise financeira na consulta dos materiais alternativos
*        PERFORM f_analise_financeira_capabil CHANGING wa_outtab.
*      ENDIF.

      IF wa_outtab-xloek NE 'X'.
        CLEAR wa_outtab-xloek.
      ENDIF.

      APPEND wa_outtab TO gt_outtab2.
    ENDIF.

    CLEAR wa_outtab.
  ENDLOOP.

  sort gt_outtab1.
  delete ADJACENT DUPLICATES FROM gt_outtab1.

  sort gt_outtab2.
  delete ADJACENT DUPLICATES FROM gt_outtab2.


* Se tiver um capabil NOK todos os outros com mesmo mateiral lote material aplicado deveram ser também
  "Montar uma tabela com todos os registros que são capabil NOK
  gt_outtab2_nok[] = gt_outtab2[].
  SORT gt_outtab2_nok BY capabil.
  DELETE gt_outtab2_nok WHERE capabil NE 'NOK'.
  SORT gt_outtab2_nok BY matnr charg matnr_apl.

  LOOP AT gt_outtab2 ASSIGNING FIELD-SYMBOL(<fs_outtab2>).

    READ TABLE gt_outtab2_nok TRANSPORTING NO FIELDS WITH KEY matnr     = <fs_outtab2>-matnr
                                                              charg     = <fs_outtab2>-charg
                                                              matnr_apl = <fs_outtab2>-matnr_apl BINARY SEARCH.
    IF sy-subrc EQ 0.
      <fs_outtab2>-capabil = 'NOK'.
    ENDIF.

  ENDLOOP.

  SORT gt_outtab2 BY matnr charg matnr_apl.

  DATA(gt_outtab2_aux) = gt_outtab2[].

  LOOP AT gt_outtab1 INTO ls_outtab1.

    lv_index = sy-tabix.

    READ TABLE gt_outtab2 TRANSPORTING NO FIELDS WITH KEY matnr     = ls_outtab1-matnr
                                                          charg     = ls_outtab1-charg
                                                          matnr_apl = ls_outtab1-matnr_apl BINARY SEARCH.
    IF sy-subrc EQ 0.
      DELETE gt_outtab1 INDEX lv_index.
    ELSE.
      READ TABLE gt_outtab2 TRANSPORTING NO FIELDS WITH KEY matnr     = ls_outtab1-matnr
                                                            charg     = ls_outtab1-charg BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        APPEND ls_outtab1 TO gt_outtab2_aux.
        DELETE gt_outtab1 INDEX lv_index.
      ENDIF.
    ENDIF.

  ENDLOOP.

  gt_outtab2 = gt_outtab2_aux.
  SORT gt_outtab2 BY matnr charg matnr_apl.

ENDFORM.                    " F_CARREGA_RESULTADO_JOB

