        READ TABLE lit_inob ASSIGNING <fs_inob> WITH KEY objek = lv_objek BINARY SEARCH.
        IF sy-subrc IS INITIAL.
          INSERT INITIAL LINE INTO TABLE lit_charg_ausp ASSIGNING <fs_charg_ausp>.
