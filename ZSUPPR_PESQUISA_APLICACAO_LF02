*&---------------------------------------------------------------------*
*&      Form  F_CHECK_LOTE_RESERVADO
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_check_lote_reservado CHANGING p_wa_mchbcar LIKE wa_outtab
                                     p_xloek.

  CLEAR wa_resb.

  " Filter batches reserved for production
  READ TABLE it_resb_261 INTO wa_resb
        WITH KEY werks = p_wa_mchbcar-werks
                 matnr = p_wa_mchbcar-matnr
                 charg = p_wa_mchbcar-charg
                 lgort = p_wa_mchbcar-lgort
                 BINARY SEARCH.
  IF sy-subrc IS INITIAL.

    p_wa_mchbcar-bdmng_reserv = wa_resb-bdmng - wa_resb-enmng.

    READ TABLE it_resb_231 INTO wa_resb_231
        WITH KEY werks = p_wa_mchbcar-werks
                 matnr = p_wa_mchbcar-matnr
                 charg = p_wa_mchbcar-charg
                 lgort = p_wa_mchbcar-lgort
                 BINARY SEARCH.
    IF sy-subrc IS INITIAL.
      p_wa_mchbcar-bdmng_reserv = p_wa_mchbcar-bdmng_reserv + ( wa_resb_231-bdmng - wa_resb_231-enmng ).
    ENDIF.

    p_xloek = 'X'.
    RETURN.
  ENDIF.

  " Filter batches reserved for Requisition
  READ TABLE it_resb_bext INTO wa_resb
        WITH KEY matnr = p_wa_mchbcar-matnr
                 charg = p_wa_mchbcar-charg
                 BINARY SEARCH.
  IF sy-subrc IS INITIAL.
    p_xloek = 'X'.
    RETURN.
  ENDIF.

  " Filter batches reserved for other orders
  READ TABLE it_resb_231 INTO wa_resb
        WITH KEY werks = p_wa_mchbcar-werks
                 matnr = p_wa_mchbcar-matnr
                 charg = p_wa_mchbcar-charg
                 lgort = p_wa_mchbcar-lgort
                 BINARY SEARCH.
  IF sy-subrc IS INITIAL.

    p_xloek = 'X'.

    p_wa_mchbcar-bdmng_reserv = wa_resb-bdmng - wa_resb-enmng.

    READ TABLE it_resb_261 INTO wa_resb_261
          WITH KEY werks = p_wa_mchbcar-werks
                   matnr = p_wa_mchbcar-matnr
                   charg = p_wa_mchbcar-charg
                   lgort = p_wa_mchbcar-lgort
                   BINARY SEARCH.
    IF sy-subrc IS INITIAL.
      p_wa_mchbcar-bdmng_reserv = p_wa_mchbcar-bdmng_reserv + ( wa_resb_261-bdmng - wa_resb_261-enmng ).
    ENDIF.

    RETURN.
  ENDIF.

  READ TABLE it_lista_alt TRANSPORTING NO FIELDS
                          WITH KEY matnr = p_wa_mchbcar-matnr
                                   charg = p_wa_mchbcar-charg
                                   BINARY SEARCH.
  IF sy-subrc IS INITIAL.
    p_xloek = 'X'.
    RETURN.
  ENDIF.

ENDFORM.                    " F_CHECK_LOTE_RESERVADO

*&---------------------------------------------------------------------*
*&      Form  F_CONSISTE_PROVA_ERRO
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_consiste_prova_erro  USING p_werks
                                  p_matnr
                                  p_wa_mchbcar LIKE wa_mchbcar
                         CHANGING p_matches.

  TYPES: BEGIN OF ty_rastreabilidade,
           matnr TYPE mchb-matnr,
           charg TYPE mchb-charg,
         END OF ty_rastreabilidade.

  DATA: lit_rastreabilidade TYPE TABLE OF ty_rastreabilidade,
        lwa_rastreabilidade TYPE ty_rastreabilidade,
        lit_log_pe          TYPE TABLE OF bapiret2,
        lwa_log_pe          TYPE bapiret2,
        lwa_inspecao_mp     TYPE zppt_inspecao,
        lwa_caract_charg    LIKE LINE OF it_caract_charg,
        lwa_caract_matnr    LIKE LINE OF it_caract_matnr,
        lwa_prova_erro      TYPE ty_prova_erro,
        lwa_prova_erro_log  TYPE ty_prova_erro_log,
        lv_qualidade        TYPE ze_qualidades,
        lv_message(60)      TYPE c.

  DATA: lv_num_inspecao TYPE atwrt,
        lv_dummy        TYPE atwrt.

  CLEAR lwa_caract_matnr.
  READ TABLE it_caract_matnr WITH KEY matnr = p_matnr
                                      atnam = 'SD_QUALIDADES'
                                      INTO lwa_caract_matnr TRANSPORTING atwrt.
  MOVE lwa_caract_matnr-atwrt TO lv_qualidade.

  IF p_wa_mchbcar-matnr BETWEEN '54000000' AND '54999999' OR
     p_wa_mchbcar-matnr BETWEEN '34000000' AND '34999999'.

    CLEAR: lwa_caract_charg.
    READ TABLE it_caract_charg INTO lwa_caract_charg
                               WITH KEY matnr = p_wa_mchbcar-matnr
                                        charg = p_wa_mchbcar-charg
                                        atnam = 'SD_NUMERO_INSPECAO'
                                        BINARY SEARCH.
    IF sy-subrc IS INITIAL.
      LOOP AT it_caract_charg FROM sy-tabix INTO lwa_caract_charg.
        IF lwa_caract_charg-matnr EQ p_wa_mchbcar-matnr AND
           lwa_caract_charg-charg EQ p_wa_mchbcar-charg AND
           lwa_caract_charg-atnam EQ 'SD_NUMERO_INSPECAO'.

          SPLIT lwa_caract_charg-atwrt AT space INTO lv_num_inspecao lv_dummy.

          "Obter o LOTE MP através da Inspeção
          READ TABLE it_inspecao_mp INTO lwa_inspecao_mp
                                     WITH KEY inspecao = lv_num_inspecao
                                     BINARY SEARCH.
          IF sy-subrc IS INITIAL.
            lwa_rastreabilidade-matnr = lwa_inspecao_mp-matnr.
            lwa_rastreabilidade-charg = lwa_inspecao_mp-charg.
            APPEND lwa_rastreabilidade TO lit_rastreabilidade.
          ENDIF.

        ELSE.
          EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.

  ELSE.
    lwa_rastreabilidade-matnr = p_wa_mchbcar-matnr.
    lwa_rastreabilidade-charg = p_wa_mchbcar-charg.
    APPEND lwa_rastreabilidade TO lit_rastreabilidade.
  ENDIF.

  IF lit_rastreabilidade[] IS INITIAL.

    p_matches = ''.
*    MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
*    wa_result-werks_apl = p_werks.
*    wa_result-matnr_apl = p_matnr.
*    CONCATENATE 'Rastreabilidade >>' 'Inconsistência na Rastreabilidade do Lote MP através da INSPEÇÃO' INTO wa_result-log SEPARATED BY space.
*    APPEND wa_result TO it_result.
*    CLEAR wa_result.

  ELSE.

    LOOP AT lit_rastreabilidade INTO lwa_rastreabilidade.

      READ TABLE it_prova_erro INTO lwa_prova_erro
                               WITH KEY werks     = p_werks
                                        matnr     = p_matnr
                                        qualidade = lv_qualidade
                                        matnr_mp  = lwa_rastreabilidade-matnr
                                        charg_mp  = lwa_rastreabilidade-charg.
      IF sy-subrc IS INITIAL.
        IF lwa_prova_erro-status = 'NOK'.
          p_matches = ''.
*          LOOP AT it_prova_erro_log INTO lwa_prova_erro_log
*                                    WHERE werks     = p_werks
*                                      AND matnr     = p_matnr
*                                      AND qualidade = lv_qualidade
*                                      AND matnr_mp  = lwa_rastreabilidade-matnr
*                                      AND charg_mp  = lwa_rastreabilidade-charg.
*            MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
*            wa_result-werks_apl = p_werks.
*            wa_result-matnr_apl = p_matnr.
*            CONCATENATE 'Prova de Erro >>' lwa_prova_erro_log-log INTO wa_result-log SEPARATED BY space.
*            APPEND wa_result TO it_result.
*            CLEAR wa_result.
*          ENDLOOP.
        ENDIF.
      ELSE.

        CALL FUNCTION 'ZQMF_MATXPE'
          EXPORTING
            i_werks                     = p_werks
            i_vbeln                     = ''
            i_posnr                     = 0
            i_matnr_pa                  = p_matnr
            i_zzqualid                  = lv_qualidade
            i_matnr                     = lwa_rastreabilidade-matnr "p_wa_mchbcar-matnr
            i_charg                     = lwa_rastreabilidade-charg "p_wa_mchbcar-charg
          IMPORTING
            ex_t_msg                    = lit_log_pe
          EXCEPTIONS
            charg_matnr_not_found       = 1
            matnr_pa_not_found          = 2
            qualidade_pa_not_found      = 3
            werks_pa_not_found          = 4
            kunnr_not_found             = 5
            vbeln_not_found             = 6
            posnr_not_found             = 7
            strgr_not_found             = 8
            pe_not_found                = 9
            vbeln_obrigatorio           = 10
            posnr_obrigatorio           = 11
            kunnr_obrigatorio           = 12
            erro_zqmf_busca_laminacao   = 13
            erro_zqmf_prova_erro_qualid = 14
            laminacao_pa_diferente_mp   = 15
            OTHERS                      = 16.
        IF sy-subrc IS INITIAL.

          IF lit_log_pe[] IS NOT INITIAL.
            p_matches = ''.

            lwa_prova_erro-werks     = p_werks.
            lwa_prova_erro-matnr     = p_matnr.
            lwa_prova_erro-qualidade = lv_qualidade.
            lwa_prova_erro-matnr_mp  = lwa_rastreabilidade-matnr.
            lwa_prova_erro-charg_mp  = lwa_rastreabilidade-charg.
            lwa_prova_erro-status    = 'NOK'.
            APPEND lwa_prova_erro TO it_prova_erro.
            CLEAR lwa_prova_erro.

            LOOP AT lit_log_pe INTO lwa_log_pe.

              lwa_prova_erro_log-werks     = p_werks.
              lwa_prova_erro_log-matnr     = p_matnr.
              lwa_prova_erro_log-qualidade = lv_qualidade.
              lwa_prova_erro_log-matnr_mp  = lwa_rastreabilidade-matnr.
              lwa_prova_erro_log-charg_mp  = lwa_rastreabilidade-charg.
              CONCATENATE 'Prova de Erro >>' lwa_log_pe-message INTO lwa_prova_erro_log-log SEPARATED BY space.
              APPEND lwa_prova_erro_log TO it_prova_erro_log.
              CLEAR lwa_prova_erro_log.

*              MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
*              wa_result-werks_apl = p_werks.
*              wa_result-matnr_apl = p_matnr.
*              CONCATENATE 'Prova de Erro >>' lwa_log_pe-message INTO wa_result-log SEPARATED BY space.
*              APPEND wa_result TO it_result.
*              CLEAR wa_result.

            ENDLOOP.
          ELSE.
            lwa_prova_erro-werks     = p_werks.
            lwa_prova_erro-matnr     = p_matnr.
            lwa_prova_erro-qualidade = lv_qualidade.
            lwa_prova_erro-matnr_mp  = lwa_rastreabilidade-matnr.
            lwa_prova_erro-charg_mp  = lwa_rastreabilidade-charg.
            lwa_prova_erro-status    = 'OK'.
            APPEND lwa_prova_erro TO it_prova_erro.
            CLEAR lwa_prova_erro.
          ENDIF.

        ELSE.

          CLEAR p_matches.
          CLEAR: lv_message.
          CASE sy-subrc.
            WHEN 1.
              lv_message = 'Material/lote não encontrado'.
            WHEN 2.
              lv_message = 'Material PA não encontrado'.
            WHEN 3.
              lv_message = 'Qualidade PA não encontrada'.
            WHEN 4.
              lv_message = 'Centro PA não encontrado'.
            WHEN 5.
              lv_message = 'Cliente não encontrado'.
            WHEN 6.
              lv_message = 'Ordem não encontrada'.
            WHEN 7.
              lv_message = 'Item da OV não encontrado'.
            WHEN 8.
              lv_message = 'Estratégia não encontrada'.
            WHEN 9.
              lv_message = 'PE não encontrado'.
            WHEN 10.
              lv_message = 'Ordem obrigatório'.
            WHEN 11.
              lv_message = 'Item da OV obrigatório'.
            WHEN 12.
              lv_message = 'Cliente obrigatório'.
            WHEN 13.
              lv_message = 'Erro na função Busca Laminação'.
            WHEN 14.
              lv_message = 'Erro na função Prova Erro Qualid'.
            WHEN 15.
              lv_message = 'Laminação PA divergente da MP'.
            WHEN OTHERS.
              lv_message = 'Não Houve seleção de Dados'.
          ENDCASE.

          p_matches = ''.

          lwa_prova_erro-werks     = p_werks.
          lwa_prova_erro-matnr     = p_matnr.
          lwa_prova_erro-qualidade = lv_qualidade.
          lwa_prova_erro-matnr_mp  = lwa_rastreabilidade-matnr.
          lwa_prova_erro-charg_mp  = lwa_rastreabilidade-charg.
          lwa_prova_erro-status    = 'NOK'.
          APPEND lwa_prova_erro TO it_prova_erro.
          CLEAR lwa_prova_erro.

          lwa_prova_erro_log-werks     = p_werks.
          lwa_prova_erro_log-matnr     = p_matnr.
          lwa_prova_erro_log-qualidade = lv_qualidade.
          lwa_prova_erro_log-matnr_mp  = lwa_rastreabilidade-matnr.
          lwa_prova_erro_log-charg_mp  = lwa_rastreabilidade-charg.
          CONCATENATE 'Prova de Erro >>' lv_message INTO lwa_prova_erro_log-log SEPARATED BY space.
          APPEND lwa_prova_erro_log TO it_prova_erro_log.
          CLEAR lwa_prova_erro_log.

*          MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
*          wa_result-werks_apl = p_werks.
*          wa_result-matnr_apl = p_matnr.
*          CONCATENATE 'Prova de Erro >>' lv_message INTO wa_result-log SEPARATED BY space.
*          APPEND wa_result TO it_result.
*          CLEAR wa_result.

        ENDIF.

      ENDIF.

    ENDLOOP.

  ENDIF.

  FREE lit_rastreabilidade.

ENDFORM.                    " F_CONSISTE_PROVA_ERRO

