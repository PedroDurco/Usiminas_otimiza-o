*&      Form  F_0100_USER_COMMAND
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_0100_user_command  CHANGING c_okcode TYPE sy-ucomm.

  DATA: l_okcode TYPE sy-ucomm.

  l_okcode = c_okcode.

  CASE l_okcode.
    WHEN 'SOL_APROV'.
      PERFORM  f_solicitar_aprovacao.
    WHEN 'PROC_MASSA'.
      PERFORM f_process_massa.
    WHEN 'BACK'.
      PERFORM f_exit_program.
    WHEN 'EXIT'.
      PERFORM f_exit_program.
    WHEN 'CANC'.
      PERFORM f_exit_program.
    WHEN 'SAVE'.
      PERFORM f_atualiza_derroga.
    WHEN OTHERS.
      EXIT.
  ENDCASE.

ENDFORM.                    " F_0100_USER_COMMAND

*&---------------------------------------------------------------------*
*&      Form  F_0200_USER_COMMAND
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_0200_user_command  CHANGING c_okcode TYPE sy-ucomm.

  DATA: l_okcode TYPE sy-ucomm.

  l_okcode = c_okcode.

  CASE l_okcode.
    WHEN 'SOL_APROV'.
      IF sy-sysid = 'DDR' OR sy-sysid = 'TDR' OR
         sy-sysid = 'DQR' OR sy-sysid = 'TQR' OR
         sy-uname(5) = 'FFDPR'.
        PERFORM  f_solicitar_aprovacao_200.
      ELSE.
        AUTHORITY-CHECK OBJECT 'ZPP_LT_ACT' ID 'ACTVT' DUMMY.
        IF sy-subrc EQ 0.
          PERFORM f_solicitar_aprovacao_200.
        ELSE.
          MESSAGE e000(su) WITH 'Sem autorização para Solicitar Aprovação OM!'.
        ENDIF.
      ENDIF.
    WHEN 'APROVAR'.
      IF sy-sysid = 'DDR' OR sy-sysid = 'TDR' OR
         sy-sysid = 'DQR' OR sy-sysid = 'TQR' OR
         sy-uname(5) = 'FFDPR'.
        PERFORM f_aprovar_200.
      ELSE.
*        AUTHORITY-CHECK OBJECT 'ZPP_APQM' ID 'ACTVT' DUMMY.
*        IF sy-subrc <> 0.
*          MESSAGE e000(su) WITH text-m07.
*          STOP.
*        ENDIF.

        AUTHORITY-CHECK OBJECT 'ZPP_LT_ALT' ID 'ACTVT' DUMMY.
        IF sy-subrc EQ 0.
          PERFORM f_aprovar_200.
        ELSE.
          MESSAGE e000(su) WITH 'Sem autorização para Aprovar QA!'.
        ENDIF.
      ENDIF.
    WHEN 'REPROVAR'.
