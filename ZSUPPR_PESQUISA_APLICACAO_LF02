          <fs_charg_ausp>-charg = <fs_mchbcar>-charg.
          <fs_charg_ausp>-atinn = <fs_atinn>-atinn.
        ENDIF.

      ENDLOOP.

    ENDLOOP.

    CHECK lit_charg_ausp[] IS NOT INITIAL.

    lit_objek_ausp[] = lit_charg_ausp[].
    SORT lit_charg_ausp BY objek.
    DELETE ADJACENT DUPLICATES FROM lit_objek_ausp COMPARING objek.

    LOOP AT lit_objek_ausp ASSIGNING <fs_ausp>.
      lwa_keys_selopt-sign    = 'I'.
      lwa_keys_selopt-option  = 'EQ'.
      lwa_keys_selopt-low     = <fs_ausp>-objek.
      APPEND lwa_keys_selopt TO lit_keys_selopt.
      CLEAR lwa_keys_selopt.
      ADD 1 TO lv_count.

      IF lv_count EQ 3000.
        SELECT objek atinn atzhl mafid klart adzhl atwrt atflv
          FROM ausp
          APPENDING CORRESPONDING FIELDS OF TABLE lit_ausp
          WHERE objek IN lit_keys_selopt.
        CLEAR: lit_keys_selopt[], lv_count.
      ENDIF.
    ENDLOOP.
    IF lv_count GT 0.
      SELECT objek atinn atzhl mafid klart adzhl atwrt atflv
        FROM ausp
        APPENDING CORRESPONDING FIELDS OF TABLE lit_ausp
        WHERE objek IN lit_keys_selopt.
      CLEAR lv_count.
      FREE  lit_keys_selopt.
    ENDIF.

    DELETE lit_ausp WHERE atinn NOT IN r_atinn.

    IF lit_ausp[] IS NOT INITIAL.

      SORT lit_ausp BY objek atinn.

      lit_ausp_aux = lit_ausp.
      SORT lit_ausp_aux BY atinn.
      DELETE ADJACENT DUPLICATES FROM lit_ausp_aux COMPARING atinn.
      SELECT atinn atnam
        FROM cabn
        INTO TABLE lit_cabn
        FOR ALL ENTRIES IN lit_ausp_aux
        WHERE atinn = lit_ausp_aux-atinn.
      SORT lit_cabn BY atinn.

      lit_ausp_aux = lit_ausp.
      SORT lit_ausp_aux BY atinn atwrt.
      DELETE ADJACENT DUPLICATES FROM lit_ausp_aux COMPARING atinn atwrt.
      SELECT atinn atwrt atzhl adzhl
        FROM cawn  INTO TABLE lit_cawn
        FOR ALL ENTRIES IN lit_ausp_aux
        WHERE atinn = lit_ausp_aux-atinn
          AND atwrt = lit_ausp_aux-atwrt.
      SORT lit_cawn BY atinn atwrt.

      IF NOT lit_cawn[] IS INITIAL.
        SELECT atinn atzhl adzhl atwtb FROM cawnt
          INTO TABLE lit_cawnt
          FOR ALL ENTRIES IN lit_cawn
          WHERE atinn = lit_cawn-atinn
            AND atzhl = lit_cawn-atzhl
            AND spras = sy-langu
            AND adzhl = lit_cawn-adzhl.
        SORT lit_cawnt BY atinn atzhl adzhl.
      ENDIF.

      LOOP AT lit_charg_ausp ASSIGNING <fs_charg_ausp>.

        READ TABLE lit_ausp ASSIGNING <fs_ausp> WITH KEY objek = <fs_charg_ausp>-objek
                                                         atinn = <fs_charg_ausp>-atinn
                                                         BINARY SEARCH.
        IF sy-subrc IS NOT INITIAL.
          CONTINUE.
        ENDIF.

        READ TABLE lit_cabn ASSIGNING <fs_cabn> WITH KEY atinn = <fs_ausp>-atinn BINARY SEARCH.
        IF sy-subrc IS NOT INITIAL.
          CONTINUE.
        ENDIF.

        INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
        <fs_caract_charg>-matnr = <fs_charg_ausp>-matnr.
        <fs_caract_charg>-charg = <fs_charg_ausp>-charg.
        <fs_caract_charg>-atnam = <fs_cabn>-atnam.
        <fs_caract_charg>-atwrt = <fs_ausp>-atwrt.
        <fs_caract_charg>-atflv = <fs_ausp>-atflv.
        READ TABLE lit_cawn ASSIGNING <fs_cawn> WITH KEY atinn = <fs_ausp>-atinn
                                                         atwrt = <fs_ausp>-atwrt BINARY SEARCH.
        IF sy-subrc IS INITIAL.
          READ TABLE lit_cawnt ASSIGNING <fs_cawnt> WITH KEY atinn = <fs_cawn>-atinn
                                                             atzhl = <fs_cawn>-atzhl
                                                             adzhl = <fs_cawn>-adzhl BINARY SEARCH.
          IF sy-subrc IS INITIAL.
            <fs_caract_charg>-atwtb = <fs_cawnt>-atwtb.
          ENDIF.
        ENDIF.

      ENDLOOP.

    ENDIF.

  ENDIF.

  FREE: lit_zppt_mchb_caract,
        lit_mchb_caract_insp,
        lit_inspecao,
        lit_matnr_objek,
        lit_charg_objek,
        lit_charg_ausp,
        lit_objek_ausp,
        lit_ausp,
        lit_ausp_aux,
        lit_inob,
        lit_cabn,
        lit_cawn,
        lit_cawnt,
        r_atinn.

ENDFORM.                    " F_SELECIONA_CARACT_CHARG


