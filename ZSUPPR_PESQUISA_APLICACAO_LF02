FORM f_exibe_mm_acompanhamento .

  TYPES: BEGIN OF ty_acompanhamento,
           data       TYPE zppt_pajt_log-data,
           hora       TYPE zppt_pajt_log-hora,
           usuario    TYPE zppt_pajt_log-usuario,
           situacao   TYPE zppt_pajt_log-situacao,
           werks      TYPE zppt_pajt-werks,
           matnr      TYPE zppt_pajt-matnr,
           charg      TYPE zppt_pajt-charg,
           lgort      TYPE zppt_pajt-lgort,
           clabs      TYPE ze_qtde_lib,
           resbp      TYPE zppt_pajt-resbp,
           maktx      TYPE zppt_pajt-maktx,
           werks_apl  TYPE zppt_pajt-werks_apl,
           matnr_apl  TYPE zppt_pajt-matnr_apl,
           maktx_apl  TYPE zppt_pajt-maktx_apl,
           usuario_qa TYPE zppt_pajt_log-usuario_qa,
           data_qa    TYPE zppt_pajt_log-data_qa,
           hora_qa    TYPE zppt_pajt_log-hora_qa,
           statustxt  TYPE zppt_pajt_log-statustxt,
         END OF ty_acompanhamento.

  DATA: lt_acompanhamento TYPE STANDARD TABLE OF ty_acompanhamento,
        ls_acompanhamento TYPE ty_acompanhamento.

*ler tabela de log de aprovados/reprovados
  SELECT usuario data hora situacao
         werks matnr charg lgort clabs resbp maktx werks_apl matnr_apl maktx_apl
         usuario_qa data_qa hora_qa statustxt
    FROM zppt_pajt_log
    INTO CORRESPONDING FIELDS OF TABLE lt_acompanhamento
    WHERE matnr EQ wa_outtab-matnr
      AND charg EQ wa_outtab-charg.

*ler os pendentes com a qualidade
  SELECT usuario data hora
         werks matnr charg lgort clabs resbp maktx werks_apl matnr_apl maktx_apl
         statustxt
    FROM zppt_pajt
    APPENDING CORRESPONDING FIELDS OF TABLE lt_acompanhamento
    WHERE cprog EQ 'ZSUPPR_PROCESSA_SOLICITACAO_MP'
      AND matnr EQ wa_outtab-matnr
      AND charg EQ wa_outtab-charg.

  LOOP AT lt_acompanhamento INTO ls_acompanhamento WHERE situacao IS INITIAL.
    ls_acompanhamento-situacao = 'EM AVALIAÇÃO'.
    MODIFY lt_acompanhamento FROM ls_acompanhamento.
  ENDLOOP.

  SORT lt_acompanhamento BY data DESCENDING hora DESCENDING.

  IF lt_acompanhamento[] IS NOT INITIAL.

    CALL FUNCTION 'ZSUPP_POPUP_ALV_DISPLAY'
      EXPORTING
        i_start_column = '5'
        i_start_line   = '5'
        i_end_column   = '180'
        i_end_line     = '30'
        i_title        = 'MM - Acompanhamento das solicitações'
        i_multi        = abap_true
      TABLES
        it_alv         = lt_acompanhamento.

  ELSE.
    MESSAGE 'Nenhuma solicitação encontrada!' TYPE 'S' DISPLAY LIKE 'E'.
  ENDIF.

  FREE lt_acompanhamento.

ENDFORM.

*&---------------------------------------------------------------------*
*&      Form  F_PROCESS_MASSA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM f_process_massa .

*PP - Tela de aprov/reprov de alternativos JIT - RDM 252018
  DATA: lwa_pajt      TYPE zppt_pajt,
        lv_seq        TYPE zppt_pajt-seq,
        lv_bdmng      TYPE mchb-clabs,
        lv_first_line TYPE lvc_index.
*PP - Tela de aprov/reprov de alternativos JIT - RDM 252018

  DATA ls_selrow  TYPE lvc_s_row.

  REFRESH gt_rows.
  IF g_tab_appl-subscreen = '0101'.
    CALL METHOD gr_table1->get_selected_rows
      IMPORTING
        et_index_rows = gt_rows.
  ELSEIF g_tab_appl-subscreen = '0102'.
    CALL METHOD gr_table2->get_selected_rows
      IMPORTING
        et_index_rows = gt_rows.
  ELSE.
    CALL METHOD gr_table3->get_selected_rows
      IMPORTING
        et_index_rows = gt_rows.
  ENDIF.

  IF gt_rows[] IS INITIAL.
    MESSAGE e000(su) WITH text-m03.
  ELSE.

    CLEAR: lv_bdmng, lv_first_line.

    READ TABLE gt_rows INTO ls_selrow INDEX 1.

    IF sy-subrc EQ 0.
      lv_first_line = ls_selrow-index.
    ENDIF.

    LOOP AT gt_rows INTO ls_selrow.
      IF g_tab_appl-subscreen = '0101'.
        READ TABLE gt_outtab1 INTO wa_outtab INDEX ls_selrow-index.
      ELSEIF g_tab_appl-subscreen = '0102'.
        READ TABLE gt_outtab2 INTO wa_outtab INDEX ls_selrow-index.
      ELSE.
        READ TABLE gt_outtab3 INTO wa_outtab INDEX ls_selrow-index.
      ENDIF.

      IF lv_first_line = ls_selrow-index OR ( wa_outtab-bdmng IS NOT INITIAL AND lv_bdmng IS INITIAL ).
        lv_bdmng = wa_outtab-bdmng.
      ENDIF.
    ENDLOOP.

    IF lv_bdmng IS INITIAL.
      MESSAGE 'Existe alternativo sem indicação da Qtd.Liberada' TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.

    LOOP AT gt_rows INTO ls_selrow.

      IF g_tab_appl-subscreen = '0101'.
        READ TABLE gt_outtab1 INTO wa_outtab INDEX ls_selrow-index.
      ELSEIF g_tab_appl-subscreen = '0102'.
        READ TABLE gt_outtab2 INTO wa_outtab INDEX ls_selrow-index.
      ELSE.
        READ TABLE gt_outtab3 INTO wa_outtab INDEX ls_selrow-index.
      ENDIF.

      IF NOT sy-subrc IS INITIAL.
        CONTINUE.
      ELSE.
        wa_outtab-bdmng = lv_bdmng.
        IF g_tab_appl-subscreen = '0101'.
          MODIFY gt_outtab1 FROM wa_outtab INDEX sy-tabix TRANSPORTING bdmng.
        ELSEIF g_tab_appl-subscreen = '0102'.
          MODIFY gt_outtab2 FROM wa_outtab INDEX sy-tabix TRANSPORTING bdmng.
        ELSE.
          MODIFY gt_outtab3 FROM wa_outtab INDEX sy-tabix TRANSPORTING bdmng.
        ENDIF.
      ENDIF.

    ENDLOOP.

    IF g_tab_appl-subscreen = '0101'.
      CALL METHOD gr_table1->refresh_table_display.

      CALL METHOD gr_table1->set_selected_rows
        EXPORTING
          it_index_rows = gt_rows.

    ELSEIF g_tab_appl-subscreen = '0102'.
      CALL METHOD gr_table2->refresh_table_display.

      CALL METHOD gr_table2->set_selected_rows
        EXPORTING
          it_index_rows = gt_rows.

    ELSE.
      CALL METHOD gr_table3->refresh_table_display.

      CALL METHOD gr_table3->set_selected_rows
        EXPORTING
          it_index_rows = gt_rows.

