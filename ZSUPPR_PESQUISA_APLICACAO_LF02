FORM f_handle_hotspot_click  USING    p_e_column_id
                                      p_es_row_no_row_id
                                      p_sender.

  DATA: lit_param TYPE TABLE OF rfc_spagpa,
        lwa       LIKE LINE OF lit_param.
*  DATA v_call_oexp TYPE  sibflporb.
  DATA v_call_oexp TYPE char149.

  DATA lv_document TYPE borident-objkey.
  DATA lwa_oest_d  TYPE zppt_oest.


  CASE p_sender.
    WHEN gr_table1.
      READ TABLE gt_outtab1 INTO wa_outtab INDEX p_es_row_no_row_id.
    WHEN gr_table2.
      READ TABLE gt_outtab2 INTO wa_outtab INDEX p_es_row_no_row_id.
    WHEN gr_table3.
      READ TABLE gt_outtab3 INTO wa_outtab INDEX p_es_row_no_row_id.
