*&---------------------------------------------------------------------*
*&      Form  F_SELECIONA_ESTOQUES
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*FORM f_seleciona_estoques .
*
*  DATA  lit_mchbcar TYPE TABLE OF zrnsdt_mchbcar.
*
*  DATA  lv_data_estoque TYPE sy-datum.
*
*  FIELD-SYMBOLS: <fs_mslb>    TYPE mslb,
*                 <fs_mchbcar> TYPE zrnsdt_mchbcar.
*
*  cl_progress_indicator=>progress_indicate(
*    i_text = 'Selecionando os Estoques...'
*    i_output_immediately = abap_true ).
*
*  REFRESH:  it_mchbcar,
*            it_mslb,
*            it_lista_alt,
*            it_pajt_sol_mp.
*
*  SELECT matnr werks lgort charg espessura largura clabs
*    INTO CORRESPONDING FIELDS OF TABLE it_mchbcar
*    FROM zrnsdt_mchbcar
*    WHERE charg IN s_charg
*      AND clabs GE gv_estoque_minimo.
*
*  "estoque especial
*  SELECT matnr werks charg sobkz lifnr lblab
*    INTO CORRESPONDING FIELDS OF TABLE it_mslb
*    FROM mslb
*   WHERE charg IN s_charg
*     AND lblab GE gv_estoque_minimo.
*  IF sy-subrc IS INITIAL.
*    LOOP AT it_mslb ASSIGNING <fs_mslb>.
*      MOVE-CORRESPONDING <fs_mslb> TO wa_mchbcar.
*      MOVE <fs_mslb>-lblab TO wa_mchbcar-clabs.
*      PERFORM f_get_stock_lgort USING wa_mchbcar-charg wa_mchbcar-matnr wa_mchbcar-werks
*                                CHANGING wa_mchbcar-lgort.
*      APPEND wa_mchbcar TO it_mchbcar.
*    ENDLOOP.
*  ENDIF.
*
*  DELETE it_mchbcar WHERE matnr NOT BETWEEN '12000000' AND '12999999' AND
*                          matnr NOT BETWEEN '54000000' AND '54999999' AND
*                          matnr NOT BETWEEN '34000000' AND '34999999' AND
*                          matnr NOT BETWEEN '10000000' AND '11999999' AND "RDM 271193
*                          matnr NOT BETWEEN '50000000' AND '59999999' AND "RDM 271193
*                          matnr NOT BETWEEN '71000000' AND '71999999'. "RDM 271193
*
*
*  "Regra para ESTOQUE ACABADOU OU SEMI-ACABADO:
*  "considerar somente lotes estocados a mais de 90 dias.
*  lit_mchbcar[] = it_mchbcar[].
*  DELETE lit_mchbcar WHERE matnr BETWEEN '12000000' AND '12999999' AND
*                           matnr BETWEEN '10000000' AND '11999999' AND "RDM 271193
*                           matnr BETWEEN '71000000' AND '71999999'. "RDM 271193
*
*  IF lit_mchbcar[] IS NOT INITIAL.
*    lv_data_estoque = sy-datum - 90.
*    LOOP AT lit_mchbcar ASSIGNING <fs_mchbcar>.
*      IF <fs_mchbcar>-ersda > lv_data_estoque.
*        DELETE it_mchbcar WHERE matnr EQ <fs_mchbcar>-matnr AND
*                                charg EQ <fs_mchbcar>-charg.
*      ENDIF.
*    ENDLOOP.
*  ENDIF.
*
*  IF it_mchbcar[] IS NOT INITIAL.
*    SELECT werks matnr charg matnr_pa
*      INTO CORRESPONDING FIELDS OF TABLE it_lista_alt
*      FROM zsuppt_lista_alt
*      FOR ALL ENTRIES IN it_mchbcar
*      WHERE matnr       EQ it_mchbcar-matnr
*        AND charg       EQ it_mchbcar-charg
*        AND desativada  EQ ''.
*
*    SELECT cprog ernam seq matnr charg clabs
*      INTO CORRESPONDING FIELDS OF TABLE it_pajt_sol_mp
*      FROM zppt_pajt
*      FOR ALL ENTRIES IN it_mchbcar
*      WHERE cprog       EQ 'ZSUPPR_PROCESSA_SOLICITACAO_MP'
*        AND matnr       EQ it_mchbcar-matnr
*        AND charg       EQ it_mchbcar-charg.
*
*    SORT it_pajt_sol_mp BY cprog ernam matnr charg clabs.
*    DELETE ADJACENT DUPLICATES FROM it_pajt_sol_mp COMPARING cprog ernam matnr charg clabs.
*
*  ENDIF.
*
*  FREE lit_mchbcar.
*
*ENDFORM.                    " F_SELECIONA_ESTOQUES


*&---------------------------------------------------------------------*
*&      Form  F_SELECIONA_PREV_DEMANDAS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_seleciona_prev_demandas .

  DATA: lv_ano   TYPE n LENGTH 4,
        lv_mes_f TYPE n LENGTH 2,
        lv_mes_t TYPE n LENGTH 2.

  REFRESH:  it_zrnppt_prev.

  lv_ano    = sy-datum(4).
  lv_mes_f  = sy-datum+4(2).
  lv_mes_t  = sy-datum+4(2).

  DO gv_horizonte_demanda TIMES.

    IF lv_mes_t = 12.

      PERFORM f_seleciona_zrnppt_prev USING lv_ano
                                            lv_mes_f
                                            lv_mes_t.
      lv_mes_f = 1.
      lv_mes_t = 1.
      lv_ano   = lv_ano + 1.

    ENDIF.

    lv_mes_t = lv_mes_t + 1.

  ENDDO.

  PERFORM f_seleciona_zrnppt_prev USING lv_ano
                                        lv_mes_f
                                        lv_mes_t.

ENDFORM.                    " F_SELECIONA_PREV_DEMANDAS

*&---------------------------------------------------------------------*
*&      Form  F_SELECIONA_ZRNPPT_PREV
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_seleciona_zrnppt_prev  USING    p_ano
                                       p_mes_f
                                       p_mes_t.

  SELECT *
    FROM zrnppt_prev
    APPENDING TABLE it_zrnppt_prev
    WHERE werks IN s_werks
      AND ano   EQ p_ano
      AND mes   BETWEEN p_mes_f AND p_mes_t
      AND peso > 0
      AND ativo EQ 'S'
      AND matnr BETWEEN '34000000' AND '34999999'.

ENDFORM.                    " F_SELECIONA_ZRNPPT_PREV

*&---------------------------------------------------------------------*
*&      Form  F_SELECIONA_RESERVAS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_seleciona_reservas .

  DATA  lit_resb TYPE STANDARD TABLE OF resb.

  cl_progress_indicator=>progress_indicate(
    i_text = 'Selecionando as Reservas Ativas...'
    i_output_immediately = abap_true ).

  REFRESH:  it_resb_231,
            it_resb_261,
            it_resb_bext.

  SELECT rsnum rspos rsart matnr werks lgort charg bdmng bwart kdauf banfn enmng
    INTO CORRESPONDING FIELDS OF TABLE lit_resb
    FROM resb
    FOR ALL ENTRIES IN it_mchbcar
    WHERE matnr   = it_mchbcar-matnr
      AND werks   = it_mchbcar-werks
      AND xloek   = ''
      AND lgort   = it_mchbcar-lgort
      AND charg   = it_mchbcar-charg
      AND kzear   = ''.
  IF sy-subrc IS INITIAL.

    "Somar qtd reservada e qtd retirada
    CLEAR it_resb_aux[].
    it_resb_aux[] = lit_resb[].
    DELETE it_resb_aux WHERE bwart NE '231'.

    LOOP AT it_resb_aux INTO DATA(ls_resb).

      CLEAR wa_resb_231.
      wa_resb_231-matnr = ls_resb-matnr.
      wa_resb_231-werks = ls_resb-werks.
      wa_resb_231-lgort = ls_resb-lgort.
      wa_resb_231-charg = ls_resb-charg.
      wa_resb_231-bdmng = ls_resb-bdmng.
      wa_resb_231-enmng = ls_resb-enmng.
      COLLECT wa_resb_231 INTO it_resb_231.
    ENDLOOP.

    "Somar qtd reservada e qtd retirada
    CLEAR it_resb_aux[].
    it_resb_aux[] = lit_resb[].
    DELETE it_resb_aux WHERE bwart NE '261'.

    LOOP AT it_resb_aux INTO ls_resb.

      CLEAR wa_resb_261.
      wa_resb_261-matnr = ls_resb-matnr.
      wa_resb_261-werks = ls_resb-werks.
      wa_resb_261-lgort = ls_resb-lgort.
      wa_resb_261-charg = ls_resb-charg.
      wa_resb_261-bdmng = ls_resb-bdmng.
      wa_resb_261-enmng = ls_resb-enmng.
      COLLECT wa_resb_261 INTO it_resb_261.
    ENDLOOP.

    it_resb_bext[] = lit_resb[].
    DELETE it_resb_bext WHERE NOT banfn EQ ''.
  ENDIF.

  FREE lit_resb.

  SELECT werks matnr charg werks_apl matnr_apl
         udate utime clabs resbp
  INTO CORRESPONDING FIELDS OF TABLE it_pajt_log
  FROM zppt_pajt_log
  FOR ALL ENTRIES IN it_mchbcar
  WHERE werks EQ it_mchbcar-werks
    AND matnr EQ it_mchbcar-matnr
    AND charg EQ it_mchbcar-charg
    AND situacao EQ 'APROVADO'.

  IF sy-subrc IS NOT INITIAL. " Descontinuação da tabela zppt_pajt_log, busca na tabela ZPPT_OEST_LOG e inclui na tabela it_pajt_log.

    SELECT werks matnr charg werks_apl matnr_apl
          udate utime clabs resbp
    INTO CORRESPONDING FIELDS OF TABLE it_pajt_log
    FROM zppt_oest_log
    FOR ALL ENTRIES IN it_mchbcar
    WHERE werks EQ it_mchbcar-werks
      AND matnr EQ it_mchbcar-matnr
      AND charg EQ it_mchbcar-charg
      AND situacao EQ 'APROVADO'.

  ENDIF.
  SORT it_pajt_log BY werks matnr charg ASCENDING udate utime DESCENDING.

ENDFORM.                    " F_SELECIONA_RESERVAS

