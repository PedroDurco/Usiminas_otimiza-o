*&---------------------------------------------------------------------*
*&      Form  F_SELECIONA_APLICACAO
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*FORM f_seleciona_aplicacao .
*
*  TYPES: BEGIN OF ty_matnr,
*           matnr TYPE mara-matnr,
*         END OF ty_matnr.
*
*  DATA: lit_matnr TYPE TABLE OF ty_matnr,
*        lit_marc  TYPE TABLE OF marc,
*        lit_mast  TYPE TABLE OF mast,
*        lit_stpo  TYPE TABLE OF stpo.
*
*  FIELD-SYMBOLS: <fs_zrnppt_prev>   TYPE zrnppt_prev,
*                 <fs_matnr>         TYPE ty_matnr,
*                 <fs_mara>          TYPE mara,
*                 <fs_marc>          TYPE marc,
*                 <fs_mast>          TYPE mast,
*                 <fs_stpo>          TYPE stpo,
*                 <fs_lista_tecnica> TYPE zqme_lista_tecnica.
*
*  cl_progress_indicator=>progress_indicate(
*    i_text = 'Selecionando os SKUs e os Componentes...'
*    i_output_immediately = abap_true ).
*
*  REFRESH: it_mara,
*           it_marc,
*           it_lista_tecnica.
*
*  IF s_matnr[] IS INITIAL.
*    s_matnr-sign    = 'I'.
*    s_matnr-option  = 'BT'.
*    s_matnr-low     = '34000000'.
*    s_matnr-high    = '34999999'.
*    APPEND s_matnr.
*  ENDIF.
*
*  SELECT matnr werks strgr
*   FROM marc
*   INTO CORRESPONDING FIELDS OF TABLE lit_marc
*    WHERE matnr IN s_matnr
*      AND werks IN s_werks
*      AND lgpro IN s_lgort.
*
*  LOOP AT lit_marc ASSIGNING <fs_marc> WHERE matnr NOT BETWEEN '34000000' AND '34999999'.
*    INSERT INITIAL LINE INTO TABLE lit_matnr ASSIGNING <fs_matnr>.
*    <fs_matnr>-matnr = <fs_marc>-matnr.
*  ENDLOOP.
*
*  IF lit_matnr[] IS NOT INITIAL.
*
*    SORT lit_matnr BY matnr.
*    DELETE ADJACENT DUPLICATES FROM lit_matnr COMPARING matnr.
*
*    SELECT stlty stlnr stlkn stpoz idnrk
*      FROM stpo
*      INTO CORRESPONDING FIELDS OF TABLE lit_stpo
*      FOR ALL ENTRIES IN lit_matnr
*      WHERE stlty = 'M'
*        AND idnrk = lit_matnr-matnr
*        AND lkenz = ''.
*    IF sy-subrc IS INITIAL.
*      SELECT matnr werks stlan stlnr stlal
*        FROM mast
*        INTO CORRESPONDING FIELDS OF TABLE lit_mast
*        FOR ALL ENTRIES IN lit_stpo
*        WHERE werks IN s_werks
*          AND stlan = '1'
*          AND stlnr = lit_stpo-stlnr.
*    ENDIF.
*
*  ENDIF.
*
*  REFRESH: lit_matnr.
*  LOOP AT lit_marc ASSIGNING <fs_marc> WHERE matnr BETWEEN '34000000' AND '34999999'.
*    INSERT INITIAL LINE INTO TABLE lit_matnr ASSIGNING <fs_matnr>.
*    <fs_matnr>-matnr = <fs_marc>-matnr.
*  ENDLOOP.
*
*  IF lit_matnr[] IS NOT INITIAL.
*
*    SORT lit_matnr BY matnr.
*    DELETE ADJACENT DUPLICATES FROM lit_matnr COMPARING matnr.
*
*    SELECT matnr werks stlan stlnr stlal
*      FROM mast
*      APPENDING CORRESPONDING FIELDS OF TABLE lit_mast
*      FOR ALL ENTRIES IN lit_matnr
*      WHERE matnr = lit_matnr-matnr
*        AND werks IN s_werks
*        AND stlan = '1'.
*    IF sy-subrc IS INITIAL.
*      SELECT stlty stlnr stlkn stpoz idnrk
*        FROM stpo
*        APPENDING CORRESPONDING FIELDS OF TABLE lit_stpo
*        FOR ALL ENTRIES IN lit_mast
*        WHERE stlty = 'M'
*          AND stlnr = lit_mast-stlnr
*          AND lkenz = ''.
*    ENDIF.
*
*  ENDIF.
*
*  SORT lit_mast BY matnr werks.
*  SORT lit_stpo BY stlnr.
*
*  DELETE ADJACENT DUPLICATES FROM lit_mast COMPARING matnr werks.
*  DELETE ADJACENT DUPLICATES FROM lit_stpo COMPARING stlnr.
*
*  REFRESH lit_matnr.
*  LOOP AT lit_mast ASSIGNING <fs_mast>.
*    INSERT INITIAL LINE INTO TABLE lit_matnr ASSIGNING <fs_matnr>.
*    <fs_matnr>-matnr = <fs_mast>-matnr.
*  ENDLOOP.
*
*  CHECK lit_matnr[] IS NOT INITIAL.
*
*  SORT lit_matnr BY matnr.
*  DELETE ADJACENT DUPLICATES FROM lit_matnr COMPARING matnr.
*
*  PERFORM f_seleciona_prev_demandas.
*
*  IF p_gd = 'X'. "Somente com Demanda
*
*    LOOP AT it_zrnppt_prev ASSIGNING <fs_zrnppt_prev>.
*      gv_tabix = sy-tabix.
*      READ TABLE lit_matnr ASSIGNING <fs_matnr>
*                           WITH KEY matnr = <fs_zrnppt_prev>-matnr
*                                    BINARY SEARCH.
*      IF sy-subrc IS NOT INITIAL.
*        DELETE it_zrnppt_prev INDEX gv_tabix.
*      ENDIF.
*    ENDLOOP.
*
*    LOOP AT it_zrnppt_prev ASSIGNING <fs_zrnppt_prev>.
*
*      READ TABLE lit_mast ASSIGNING <fs_mast>
*                          WITH KEY matnr = <fs_zrnppt_prev>-matnr
*                                   werks = <fs_zrnppt_prev>-werks
*                                   BINARY SEARCH.
*      IF sy-subrc IS INITIAL.
*        READ TABLE lit_stpo ASSIGNING <fs_stpo>
*                            WITH KEY stlnr = <fs_mast>-stlnr
*                                     BINARY SEARCH.
*        IF sy-subrc IS INITIAL.
*          INSERT INITIAL LINE INTO TABLE it_lista_tecnica ASSIGNING <fs_lista_tecnica>.
*          <fs_lista_tecnica>-werks  = <fs_mast>-werks.
*          <fs_lista_tecnica>-matnr  = <fs_mast>-matnr.
*          <fs_lista_tecnica>-idnrk  = <fs_stpo>-idnrk.
*        ENDIF.
*      ENDIF.
*
*    ENDLOOP.
*
*  ELSE.
*
*
*    LOOP AT lit_mast ASSIGNING <fs_mast>.
*
*      READ TABLE lit_stpo ASSIGNING <fs_stpo>
*                          WITH KEY stlnr = <fs_mast>-stlnr
*                                   BINARY SEARCH.
*      IF sy-subrc IS INITIAL.
*        INSERT INITIAL LINE INTO TABLE it_lista_tecnica ASSIGNING <fs_lista_tecnica>.
*        <fs_lista_tecnica>-werks  = <fs_mast>-werks.
*        <fs_lista_tecnica>-matnr  = <fs_mast>-matnr.
*        <fs_lista_tecnica>-idnrk  = <fs_stpo>-idnrk.
*      ENDIF.
*
*    ENDLOOP.
*
*  ENDIF.
*
*  REFRESH: it_mara,
*           it_marc.
*
*  CHECK it_lista_tecnica[] IS NOT INITIAL.
*
*  SORT it_lista_tecnica BY werks matnr.
*  DELETE ADJACENT DUPLICATES FROM it_lista_tecnica COMPARING werks matnr.
*
*  SELECT matnr mtart
*    FROM mara
*    INTO CORRESPONDING FIELDS OF TABLE it_mara
*    FOR ALL ENTRIES IN it_lista_tecnica
*    WHERE matnr = it_lista_tecnica-matnr.
*  IF sy-subrc IS INITIAL.
*    SELECT matnr werks strgr
*     FROM marc
*     INTO CORRESPONDING FIELDS OF TABLE it_marc
*     FOR ALL ENTRIES IN it_mara
*     WHERE matnr EQ it_mara-matnr
*       AND werks IN s_werks.
*  ENDIF.
*
*  FREE: lit_matnr, lit_marc, lit_mast, lit_stpo.
*
*ENDFORM.                    " F_SELECIONA_APLICACAO

