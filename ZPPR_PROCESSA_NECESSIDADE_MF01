FORM f_classifica_log  CHANGING p_outtab TYPE ty_outtab
                                p_restrito.

  DATA: lt_resb TYPE TABLE OF resb,
        ls_resb TYPE resb.

  " rdm 324713
  FIND 'NIVEL OLEAMENTO' IN wa_outtab-statustxt.
  IF sy-subrc IS INITIAL.
    p_restrito = ' '.
    CLEAR p_outtab-xloek.
    RETURN.
  ENDIF.
  FIND 'OLEAMENTO' IN wa_outtab-statustxt.
  IF sy-subrc IS INITIAL.
    p_restrito = 'X'.
    CLEAR p_outtab-xloek.
    RETURN.
  ENDIF.
  FIND 'PECA_SEGURANCA' IN wa_outtab-statustxt.
  IF sy-subrc IS INITIAL.
    p_restrito = 'X'.
    CLEAR p_outtab-xloek.
    RETURN.
  ENDIF.

  IF p_outtab-xloek EQ 'P' OR
     p_outtab-xloek EQ 'T'.
    p_restrito = ''.
    RETURN.
  ENDIF.

*PM - Capabilidade - PRJ1372 - 15.03.2022
  IF p_outtab-xloek EQ 'E' OR
     p_outtab-xloek EQ 'C' OR
     p_outtab-xloek EQ 'M' OR
     p_outtab-xloek EQ 'R' OR
     p_outtab-xloek EQ 'A' OR
     p_outtab-xloek EQ 'O'.    " RDM 324713 - SANDRA H
    CLEAR p_outtab-xloek.
    p_restrito = ''.
    RETURN.
  ENDIF.
*PM - Capabilidade - PRJ1372 - 15.03.2022

  FIND 'TOYOTA' IN wa_outtab-statustxt.
  IF sy-subrc IS INITIAL.
    wa_outtab-icon_stt = icon_yellow_light.
    p_restrito = ''.
    RETURN.
  ENDIF.

  FIND 'RESERVA' IN wa_outtab-statustxt.
  IF sy-subrc IS INITIAL.
    SELECT *
      INTO TABLE lt_resb
      FROM resb
      WHERE matnr EQ p_outtab-matnr
        AND werks EQ p_outtab-werks
        AND lgort EQ p_outtab-lgort
        AND charg EQ p_outtab-charg
        AND xloek EQ ''
        AND kzear   = ''.
    wa_outtab-icon_stt = icon_yellow_light.
    p_restrito = ''.
    RETURN.
  ENDIF.

  FIND 'DIMENSIONAL' IN wa_outtab-statustxt.
  IF sy-subrc IS INITIAL AND p_outtab-xloek NE 'D'.
    wa_outtab-icon_stt = icon_yellow_light.
    p_restrito = ''.
    RETURN.
  ENDIF.

  FIND 'ANALISE USINA' IN wa_outtab-statustxt.
  IF sy-subrc IS INITIAL AND p_outtab-xloek NE 'D'.
    wa_outtab-icon_stt = icon_yellow_light.
    p_restrito = ''.
    RETURN.
  ENDIF.

  FIND 'EM APROVAÇAO' IN wa_outtab-statustxt.
  IF sy-subrc IS INITIAL AND p_outtab-xloek NE 'D'.
    wa_outtab-icon_stt = icon_yellow_light.
    p_restrito = ''.
    RETURN.
  ENDIF.

  p_restrito = 'X'.

ENDFORM.                    " F_CLASSIFICA_LOG
