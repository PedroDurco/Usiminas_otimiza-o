FORM f_consiste_oleamento USING p_label
                                p_wa_werks
                                p_wa_matnr
                                p_wa
                                p_wa_mchbcar_charg
                       CHANGING p_charg
                                p_matnr_acabado
                                p_matches
                                p_wa_result.

  CASE p_label.

    WHEN 'MM_OLEAMENTO'.

      IF p_charg IS INITIAL.
        p_charg = 'S'.
      ENDIF.

      IF p_matnr_acabado IS INITIAL.
        p_matnr_acabado = 'S'.
      ENDIF.

      IF p_charg = p_matnr_acabado.
        p_matches = 'X'.
        RETURN.
      ELSE.
        p_matches = space.
      ENDIF.

    WHEN 'MM_NIVEL_OLEAMENTO'.

      IF p_charg IS INITIAL.
        p_charg = 'S'.
      ENDIF.

      IF p_matnr_acabado IS INITIAL.
        p_matnr_acabado = 'S'.
      ENDIF.

      IF p_charg = p_matnr_acabado.
        p_matches = 'X'.
        RETURN.
      ELSE.
        p_matches = space.
      ENDIF.

    WHEN 'MM_PECA_SEGURANCA'.

      IF p_charg IS INITIAL.
        p_charg = 'S'.
      ENDIF.

      IF p_matnr_acabado IS INITIAL.
        p_matnr_acabado = 'S'.
      ENDIF.

      IF p_charg = p_matnr_acabado.
        p_matches = 'X'.
        RETURN.
      ELSE.
        p_matches = space.
      ENDIF.

  ENDCASE.

  IF p_charg <> p_matnr_acabado .

    CASE p_label.

      WHEN 'MM_OLEAMENTO'.
        DATA(lv_texto) = CONV char20( 'Oleamento' ).

      WHEN 'MM_NIVEL_OLEAMENTO'.
        lv_texto = 'Nivel Oleamento'.
        wa_result-xloek     = 'O'.      " RDM 324713 - SANDRA H - farol amarelo

      WHEN 'MM_PECA_SEGURANCA'.
        lv_texto = 'Peça Segurança'.

    ENDCASE.

    MOVE-CORRESPONDING p_wa TO wa_result.

    wa_result-werks_apl = p_wa_werks.
    wa_result-matnr_apl = p_wa_matnr.
*    wa_result-xloek     = 'O'.      " RDM 324713 - SANDRA H

    CONCATENATE lv_texto ' >> Lote:' p_charg 'SKU:' p_matnr_acabado INTO wa_result-log SEPARATED BY space.

    APPEND wa_result TO it_result.

