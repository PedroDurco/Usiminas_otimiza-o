FORM f_grava_tabela_aplicacao USING p_cprog
                                    p_ernam
                                    p_tpmesag.

  DATA: lwa_pajt   TYPE zppt_pajt,
*       Stefanini/Elaine Omine - PRJ1372 - 12/09/2023 - Início
        lwa_sugest TYPE zppt_vf_sugest,
*       Stefanini/Elaine Omine - PRJ1372 - 12/09/2023 - Fim
        lv_seq     TYPE zppt_pajt-seq.

  DATA: lit_oest_log_sum TYPE TABLE OF zppt_oest_log,
        lwa_oest_log_sum TYPE zppt_oest_log.

  DATA: lv_necessidade      TYPE zppt_oest_log-necessidade,
        lv_compra_projetada TYPE p DECIMALS 3.

  SELECT MAX( seq )
    FROM zppt_pajt
    INTO lv_seq
    WHERE cprog EQ p_cprog
      AND ernam EQ p_ernam.

  ADD 1 TO lv_seq.
  MOVE-CORRESPONDING wa_outtab TO lwa_pajt.
  lwa_pajt-cprog    = p_cprog.
  lwa_pajt-ernam    = p_ernam.
  lwa_pajt-seq      = lv_seq.
  lwa_pajt-erdat    = sy-datum.
  lwa_pajt-erzet    = sy-uzeit.
  lwa_pajt-tpmesag  = p_tpmesag.
* Stefanini/Elaine Omine - PRJ1372 - 12/09/2023 - Início
  lwa_pajt-decendio = gv_decendio.

  IF p_ernam EQ 'JOBTNG2'.

    IF it_zrnppt_prev[] IS INITIAL.
      PERFORM f_seleciona_prev_demandas.
    ENDIF.

    CLEAR lwa_sugest.
    MOVE-CORRESPONDING lwa_pajt TO lwa_sugest.

    SELECT *
      FROM  zppt_oest_log
      INTO TABLE @DATA(lit_oest_log)
      WHERE erdat     EQ @lwa_pajt-erdat
        AND werks     EQ @lwa_pajt-werks
        AND matnr     EQ @lwa_pajt-matnr
        AND charg     EQ @lwa_pajt-charg
        AND lgort     EQ @lwa_pajt-lgort
        AND idnrk_apl EQ @lwa_pajt-idnrk_apl
        AND lgort_apl EQ @lwa_pajt-lgort_apl
        AND situacao  EQ 'APROVADO'
        AND ( cprog   EQ 'ZPPR_PROCESSA_NECESSIDADE_MP' OR
              cprog   EQ '' ).

    SORT lit_oest_log BY idnrk_apl matnr charg.
    DELETE ADJACENT DUPLICATES FROM lit_oest_log COMPARING idnrk_apl matnr charg.
    LOOP AT lit_oest_log INTO DATA(wa_oest_log).
      lwa_oest_log_sum-idnrk_apl = wa_oest_log-idnrk_apl.
      lwa_oest_log_sum-clabs     = wa_oest_log-clabs.
      COLLECT lwa_oest_log_sum INTO lit_oest_log_sum.
    ENDLOOP.

    SELECT SINGLE matnr, lote_minimo, necessidade
      INTO @DATA(ls_zppt_gi)
        FROM zppt_gi
          WHERE matnr = @lwa_pajt-idnrk_apl.

    IF sy-subrc IS INITIAL.

      lwa_sugest-saving  = ( ls_zppt_gi-necessidade / ls_zppt_gi-lote_minimo ).
      CALL FUNCTION 'ROUND'
        EXPORTING
          decimals      = 0
          input         = lwa_sugest-saving
          sign          = '+'
        IMPORTING
          output        = lwa_sugest-saving
        EXCEPTIONS
          input_invalid = 1
          overflow      = 2
          type_invalid  = 3
          OTHERS        = 4.
      IF sy-subrc <> 0.
* Implement suitable error handling here
      ENDIF.
      lwa_sugest-saving  = lwa_sugest-saving  * ls_zppt_gi-lote_minimo.

      lwa_sugest-necessidade = ls_zppt_gi-necessidade.
      lwa_sugest-lotemin     = ls_zppt_gi-lote_minimo.

*** Compra projetada
      lwa_sugest-comp_proj = lwa_sugest-saving.

      CLEAR lwa_oest_log_sum.
      READ TABLE lit_oest_log_sum INTO lwa_oest_log_sum
                                  WITH KEY idnrk_apl = lwa_pajt-idnrk_apl.

      "Necessidade² = 9 (Necessidade (-) #Alternativos)
      lv_necessidade      = ls_zppt_gi-necessidade - lwa_oest_log_sum-clabs.
      lv_compra_projetada = ( lv_necessidade / ls_zppt_gi-lote_minimo ).
      IF lv_compra_projetada GT 0.

        CALL FUNCTION 'ROUND'
          EXPORTING
            decimals      = 0
            input         = lv_compra_projetada
            sign          = '+'
          IMPORTING
            output        = lv_compra_projetada
          EXCEPTIONS
            input_invalid = 1
            overflow      = 2
            type_invalid  = 3
            OTHERS        = 4.
        IF sy-subrc <> 0.
        ENDIF.
        lv_compra_projetada = lv_compra_projetada * ls_zppt_gi-lote_minimo.

*        lwa_sugest-saving   = lwa_sugest-comp_proj - lv_compra_projetada.

      ENDIF.

*** Compra Otimizada
      DATA(lv_qtde_lotes) = CONV labst( ls_zppt_gi-necessidade - lwa_pajt-clabs ) / ls_zppt_gi-lote_minimo.
      CALL FUNCTION 'ROUND'
        EXPORTING
          decimals      = 0
          input         = lv_qtde_lotes
          sign          = '+'
        IMPORTING
          output        = lv_qtde_lotes
        EXCEPTIONS
          input_invalid = 1
          overflow      = 2
          type_invalid  = 3
          OTHERS        = 4.
      IF sy-subrc <> 0.
      ENDIF.

      lwa_sugest-comp_otmz = lv_qtde_lotes * ls_zppt_gi-lote_minimo.
      IF lwa_sugest-comp_otmz < 0.
        CLEAR lwa_sugest-comp_otmz.
      ENDIF.

      lwa_sugest-laeda   = sy-datum.
      lwa_sugest-origem  = 'OTIMIZADOR'.
      lwa_sugest-status  = 'PENDENTE'.

    ENDIF.

    READ TABLE it_zrnppt_prev INTO DATA(ls_prev)
        WITH KEY matnr = lwa_pajt-matnr_apl.
*                 werks = lwa_pajt-werks.

    IF sy-subrc IS INITIAL.

      lwa_sugest-kunnr = ls_prev-kunnr.

      SELECT vkbur, vkgrp, spart
        INTO TABLE @DATA(lt_knvv)
          FROM knvv
            WHERE kunnr = @ls_prev-kunnr.

      IF lt_knvv IS NOT INITIAL.

        TRY.

            DATA(ls_knvv) = lt_knvv[ spart = 'JT' ].
            DATA(lv_filtro) = CONV ze_filtro( ls_knvv-vkbur && ls_knvv-vkgrp && ls_knvv-spart ).
            DATA(lv_filtro_2) = CONV ze_filtro( ls_knvv-vkbur && ls_knvv-vkgrp ).

          CATCH cx_sy_itab_line_not_found.

            TRY.
                ls_knvv = lt_knvv[ 1 ].
                lv_filtro = ls_knvv-vkbur && ls_knvv-vkgrp.
              CATCH cx_sy_itab_line_not_found.
            ENDTRY.

        ENDTRY.

        IF lv_filtro IS NOT INITIAL.

          SELECT filtro, valor
            INTO TABLE @DATA(lt_valor)
              FROM zsuget_variaveis
                WHERE filtro = @lv_filtro OR filtro = @lv_filtro_2.

          IF sy-subrc IS INITIAL.
            TRY.
                DATA(ls_valor) = lt_valor[ filtro = lv_filtro ].
              CATCH cx_sy_itab_line_not_found.
                IF lv_filtro_2 IS NOT INITIAL.
                  TRY.
                      ls_valor = lt_valor[ filtro = lv_filtro_2 ].
                    CATCH cx_sy_itab_line_not_found.
                  ENDTRY.
                ENDIF.
            ENDTRY.
          ENDIF.
          lwa_sugest-ger_com = ls_valor-valor(2).
          lwa_sugest-tp_venda = ls_valor-valor+3(2).
          lwa_sugest-grtp_ven = ls_valor-valor+6(2).

        ENDIF.


      ENDIF.

      CLEAR lv_filtro.
      REFRESH lt_knvv.

    ENDIF.

*   Stefanini/Elaine Omine - PRJ1372 - 02/04/2023 - Início
    SELECT SINGLE umrez, umren
      FROM marm
      INTO @DATA(wl_marm)
     WHERE matnr EQ @lwa_pajt-matnr
       AND meinh EQ 'TN'.
    IF sy-subrc EQ 0.
      lwa_sugest-umrez = wl_marm-umrez.
      lwa_sugest-umren = wl_marm-umren.
    ENDIF.
*   Stefanini/Elaine Omine - PRJ1372 - 02/04/2023 - Fim

    INSERT INTO zppt_vf_sugest VALUES lwa_sugest.
  ENDIF.
* Stefanini/Elaine Omine - PRJ1372 - 12/09/2023 - Fim

  INSERT INTO zppt_pajt VALUES lwa_pajt.

  IF sy-subrc EQ 0.
    COMMIT WORK AND WAIT.
  ELSE.
    ROLLBACK WORK.
  ENDIF.

ENDFORM.                    " F_GRAVA_TABELA_APLICACAO

