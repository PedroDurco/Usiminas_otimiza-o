*  FREE it_log_aplicacao.


  IF it_result[] IS NOT INITIAL.

    cl_progress_indicator=>progress_indicate(
      i_text = 'Gerando resultado...'
      i_output_immediately = abap_true ).

    lit_result[] = it_result[].
    SORT lit_result BY matnr.
    DELETE ADJACENT DUPLICATES FROM lit_result COMPARING matnr.

    SELECT *
      FROM makt
      INTO CORRESPONDING FIELDS OF TABLE lit_makt
      FOR ALL ENTRIES IN lit_result
      WHERE matnr = lit_result-matnr
        AND spras = 'PT'.

    lit_result[] = it_result[].
    SORT lit_result BY matnr_apl.
    DELETE ADJACENT DUPLICATES FROM lit_result COMPARING matnr_apl.

    SELECT *
      FROM makt
      APPENDING CORRESPONDING FIELDS OF TABLE lit_makt
      FOR ALL ENTRIES IN lit_result
      WHERE matnr = lit_result-matnr_apl
        AND spras = 'PT'.

    IF it_mslb[] IS NOT INITIAL.
      SELECT lifnr sortl
        FROM lfa1
        INTO CORRESPONDING FIELDS OF TABLE lit_lfa1
        FOR ALL ENTRIES IN it_mslb
        WHERE lifnr = it_mslb-lifnr.
      IF sy-subrc IS INITIAL.
        SORT lit_lfa1 BY lifnr sortl.
      ENDIF.
    ENDIF.

    SORT lit_makt BY matnr.
    SORT it_zrnppt_prev BY werks ano mes matnr.

*    PERFORM analise_alternativos.

    LOOP AT it_result ASSIGNING <fs_result>.

      CLEAR wa_outtab.
      MOVE-CORRESPONDING <fs_result> TO wa_outtab.

      READ TABLE lit_makt ASSIGNING <fs_makt>
                          WITH KEY matnr = <fs_result>-matnr
