FORM f_seleciona_lotes_aplicacao .

  REFRESH:  it_mchbcar,
            it_lista_alt,
            it_lta_reprov.
*            it_grupo_he04.

*  SELECT *
*    INTO TABLE it_grupo_he04
*    FROM zppt_grupo_he04.

  SELECT l~matnr l~werks l~lgort l~charg l~clabs l~ersda m~hierarq_04
    INTO CORRESPONDING FIELDS OF TABLE it_mchbcar
    FROM zppt_lotes_aplic AS l
    INNER JOIN zppt_mchb_caract AS m
            ON l~matnr = m~matnr
           AND l~charg = m~charg
    WHERE l~charg IN s_charg.

* Stefanini/Elaine Omine - PRJ1372 - 11/08/2023 - Início
  SELECT *
    FROM zppt_oest
    INTO TABLE @DATA(tl_oest).
  IF sy-subrc EQ 0 AND it_mchbcar IS NOT INITIAL.
    SORT tl_oest BY werks matnr charg.
    DELETE ADJACENT DUPLICATES FROM tl_oest COMPARING werks matnr charg.
    LOOP AT tl_oest INTO DATA(wl_oest).
      DELETE it_mchbcar WHERE werks = wl_oest-werks
                          AND matnr = wl_oest-matnr
                          AND charg = wl_oest-charg.
    ENDLOOP.
  ENDIF.
* Stefanini/Elaine Omine - PRJ1372 - 11/08/2023 - Início

  IF it_mchbcar[] IS NOT INITIAL.

    SELECT werks matnr charg matnr_pa
      INTO TABLE it_lista_alt
      FROM zsuppt_lista_alt
      FOR ALL ENTRIES IN it_mchbcar
      WHERE matnr       EQ it_mchbcar-matnr
        AND charg       EQ it_mchbcar-charg
        AND desativada  EQ ''.

    SELECT *
      INTO TABLE it_lta_reprov
      FROM zppt_lta_reprov
      FOR ALL ENTRIES IN it_mchbcar
      WHERE idnrk EQ it_mchbcar-matnr
        AND charg EQ it_mchbcar-charg.
  ENDIF.

ENDFORM.                    " F_SELECIONA_LOTES_APLICACAO

