  DATA: lit_gi TYPE TABLE OF zppt_gi,
        lwa_gi TYPE zppt_gi.

  DATA: lit_mp_excesso TYPE TABLE OF ty_mp_excesso,
        lwa_mp_excesso TYPE ty_mp_excesso.

  DATA: lit_mp_falta TYPE TABLE OF ty_mp_falta,
        lwa_mp_falta TYPE ty_mp_falta.

* Início inclusão - 17.03.2023 - PRJ1372 - 5113
  DATA: t_zppt_oest  TYPE TABLE OF zppt_oest WITH HEADER LINE,
        w_mp_excesso TYPE zppt_mp_excesso,
        v_tabix      LIKE sy-tabix,
        v_clabs      TYPE zppt_oest-clabs.
* Fim inclusão - 17.03.2023 - PRJ1372 - 5113

  DATA: lit_t001w TYPE TABLE OF t001w,
        lwa_t001w TYPE t001w.

*PM - Capabilidade - PRJ1372 - 15.03.2022
*  DATA: lv_charg_sd_diametro_interno   TYPE atflv,
*        lv_charg_sd_diametro_externo   TYPE atflv,
*        lv_charg_pdr_consulta_metal    TYPE atwrt,
*        lv_matnr_pdr_consulta_metal    TYPE atwrt,
*        lv_matnr_sd_hierarquia_produto TYPE atwrt,
*        lv_charg_sd_lim_resistencia    TYPE atflv,
*        lv_charg_comp                  TYPE atflv,
*        lv_charg_laminacao             TYPE atwtb,
*        lv_tipo_certificado            TYPE vbap-mvgr1,
*        lv_matnr_produto               TYPE atwtb,
*        lv_charg_produto               TYPE atwtb,
*        lv_matches                     TYPE c,
*        lv_restrito                    TYPE c.
*
*  DATA: lwa_caract_matnr LIKE LINE OF it_caract_matnr,
*        lwa_caract_charg LIKE LINE OF it_caract_charg.
*
*  SORT: it_caract_charg BY matnr charg atnam,
*        it_caract_matnr BY matnr atnam.
*PM - Capabilidade - PRJ1372 - 15.03.2022

  SELECT werks regio
