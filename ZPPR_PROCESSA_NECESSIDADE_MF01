      SELECT *
        FROM zqmt_restr_cli
        INTO TABLE it_zqmt_restr_cli.

      SELECT *
        FROM zqmt_partnumber
        INTO TABLE it_zqmt_partnumber
        FOR ALL ENTRIES IN it_marc
        WHERE matnr_antigo = it_marc-matnr
          AND status IN ('LIB', 'LIR').

      IF sy-subrc IS INITIAL.
        it_zqmt_partnumber_aux[] = it_zqmt_partnumber[].
        SORT it_zqmt_partnumber_aux BY partnumber.
        DELETE ADJACENT DUPLICATES FROM it_zqmt_partnumber_aux COMPARING partnumber.

        SELECT *
          FROM zqmt_partnumber
          INTO TABLE it_zqmt_partnumber_pn
          FOR ALL ENTRIES IN it_zqmt_partnumber_aux
          WHERE partnumber = it_zqmt_partnumber_aux-partnumber.
      ENDIF.

      it_marc_aux[] = it_marc[].
      SORT it_marc_aux BY matnr.
      DELETE it_marc_aux WHERE matnr NOT BETWEEN '34000000' AND '34999999'.

      IF it_marc_aux[] IS NOT INITIAL.

        SORT it_marc_aux BY matnr.
        DELETE ADJACENT DUPLICATES FROM it_marc_aux COMPARING matnr.

        SELECT t~werks, t~matnr, s~datuv, s~idnrk
          FROM mast AS t
          INNER JOIN stpo AS s
          ON s~stlnr = t~stlnr
          INTO TABLE @it_mast
          FOR ALL ENTRIES IN @it_marc_aux
          WHERE t~matnr = @it_marc_aux-matnr
            AND t~werks IN @s_werks
            AND t~stlan = '1'.

        SORT it_mast BY idnrk.
        DELETE it_mast WHERE idnrk NOT BETWEEN '54000000' AND '54999999'.
        SORT it_mast BY idnrk ASCENDING werks ASCENDING datuv DESCENDING.

        IF it_mast[] IS NOT INITIAL.

          SELECT matnr mtart
            FROM mara
            INTO TABLE it_mtart_mast
            FOR ALL ENTRIES IN it_mast
            WHERE matnr = it_mast-idnrk.

        ENDIF.

      ENDIF.

      SORT: it_ztmmsu_controle BY werks lgort,
            it_zppt_restr_entr  BY lamin tipo_prod werks esp_ini esp_fin
                                   larg_ini larg_fin diam_ext_ini diam_ext_fim
                                   diam_int_ini diam_int_fim peso_max,
            it_zqmt_restr_equip BY werks tp_produto,
            it_zrnppt_prev_capa BY matnr,
            it_zqmt_restr_cli   BY werks kunnr bloqueio matnr,
            it_zqmt_partnumber_pn BY partnumber.

    ENDIF.

