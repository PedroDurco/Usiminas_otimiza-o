  SORT lit_tp_planta BY werks werks_camb.

  SELECT *
    INTO TABLE lit_zppt_pajt
    FROM zppt_pajt
    WHERE cprog EQ sy-cprog
*     AND ernam EQ 'JOBTNG1'  " RDM 324713 - Sandra H. - 10/01/2025
     AND ( ernam EQ 'JOBTNG1' OR ernam EQ 'JOBTNG2').


* início RDM RDM 324713 - Sandra H. - 10/01/2025 - não considerar material com saldo 'zero'
  SELECT matnr, werks, lgort, charg, clabs
   INTO TABLE @DATA(lt_mchb)
   FROM mchb
   FOR ALL ENTRIES IN @lit_zppt_pajt
    WHERE matnr EQ @lit_zppt_pajt-matnr
    AND   werks EQ @lit_zppt_pajt-werks
    AND   lgort EQ @lit_zppt_pajt-lgort
    AND   charg EQ @lit_zppt_pajt-charg
    AND   clabs EQ 0.

  LOOP AT lit_zppt_pajt INTO lwa_zppt_pajt.
    v_tabix = sy-tabix.
    READ TABLE lt_mchb WITH KEY matnr = lwa_zppt_pajt-matnr
                                werks = lwa_zppt_pajt-werks
                                lgort = lwa_zppt_pajt-lgort
                                charg = lwa_zppt_pajt-charg TRANSPORTING NO FIELDS.
    IF sy-subrc EQ 0.
      DELETE lit_zppt_pajt INDEX v_tabix.
      CLEAR lwa_zppt_pajt.
    ENDIF.
  ENDLOOP.
* Fim RDM RDM 324713 - Sandra H. - 10/01/2025 - não considerar material com saldo 'zero'

  SELECT matnr werks lgort charg clabs ersda
    INTO CORRESPONDING FIELDS OF TABLE it_mchbcar
    FROM zppt_lotes_aplic.
  SORT it_mchbcar BY matnr charg.

* Stefanini/Elaine Omine - PRJ1372 - 26/07/2023 - Início
  IF lit_zppt_pajt IS NOT INITIAL.
    SELECT stlty, stlnr, stlkn, stpoz, datuv, idnrk
      FROM stpo
      INTO TABLE @DATA(tl_stpo)
       FOR ALL ENTRIES IN @lit_zppt_pajt
     WHERE idnrk EQ @lit_zppt_pajt-matnr.
    IF sy-subrc EQ 0.
      SORT tl_stpo BY idnrk datuv DESCENDING.
      DELETE ADJACENT DUPLICATES FROM tl_stpo COMPARING idnrk.

      SELECT stlty, stlnr, stlal, stlkn, stasz, datuv
        FROM stas
        INTO TABLE @DATA(tl_stas)
         FOR ALL ENTRIES IN @tl_stpo
       WHERE stlty EQ @tl_stpo-stlty
         AND stlnr EQ @tl_stpo-stlnr
         AND stlkn EQ @tl_stpo-stlkn.
      IF sy-subrc EQ 0.
        SORT tl_stas BY stlty stlnr stlkn datuv DESCENDING.
        DELETE ADJACENT DUPLICATES FROM tl_stas COMPARING stlty stlnr stlkn .

        SELECT matnr, werks, stlan, stlnr, stlal
          FROM mast
          INTO TABLE @DATA(tl_mast)
           FOR ALL ENTRIES IN @tl_stas
         WHERE stlnr EQ @tl_stas-stlnr
           AND stlal EQ @tl_stas-stlal.
      ENDIF.
    ENDIF.
    DATA(tl_mast_54) = tl_mast.
    DELETE tl_mast_54 WHERE matnr NP '54*'.
    IF tl_mast_54 IS NOT INITIAL.
      SELECT stlty, stlnr, stlkn, stpoz, datuv, idnrk
        FROM stpo
        INTO TABLE @DATA(tl_stpo_2)
         FOR ALL ENTRIES IN @tl_mast_54
       WHERE idnrk EQ @tl_mast_54-matnr.
      IF sy-subrc EQ 0.
        SORT tl_stpo_2 BY idnrk datuv DESCENDING.
        DELETE ADJACENT DUPLICATES FROM tl_stpo_2 COMPARING idnrk.

        SELECT stlty, stlnr, stlal, stlkn, stasz, datuv
          FROM stas
          INTO TABLE @DATA(tl_stas_2)
           FOR ALL ENTRIES IN @tl_stpo_2
         WHERE stlty EQ @tl_stpo_2-stlty
           AND stlnr EQ @tl_stpo_2-stlnr
           AND stlkn EQ @tl_stpo_2-stlkn.
        IF sy-subrc EQ 0.
          SORT tl_stas_2 BY stlty stlnr stlkn datuv DESCENDING.
          DELETE ADJACENT DUPLICATES FROM tl_stas_2 COMPARING stlty stlnr stlkn .

          SELECT matnr, werks, stlan, stlnr, stlal
            FROM mast
            INTO TABLE @DATA(tl_mast_2)
             FOR ALL ENTRIES IN @tl_stas_2
           WHERE stlnr EQ @tl_stas_2-stlnr
             AND stlal EQ @tl_stas_2-stlal.
        ENDIF.
      ENDIF.
    ENDIF.
    SORT: tl_stpo   BY idnrk,
          tl_stas   BY stlty stlnr stlkn,
          tl_mast   BY stlnr stlal,
          tl_stpo_2 BY idnrk,
          tl_stas_2 BY stlty stlnr stlkn,
          tl_mast_2 BY stlnr stlal.
  ENDIF.
  IF lit_zppt_pajt IS NOT INITIAL.
    SELECT matnr, lgort
      FROM mard
      INTO TABLE @DATA(tl_mard)
       FOR ALL ENTRIES IN @lit_zppt_pajt
     WHERE matnr EQ @lit_zppt_pajt-matnr_apl.
    SORT tl_mard BY matnr.
  ENDIF.
* Stefanini/Elaine Omine - PRJ1372 - 26/07/2023 - Fim

  SORT it_zrnppt_prev BY matnr werks.

  LOOP AT lit_zppt_pajt INTO lwa_zppt_pajt.

