  DATA: BEGIN OF lit_rank_prioridade OCCURS 0,
          werks TYPE marc-werks,
          matnr TYPE marc-matnr,
          idnrk TYPE stpo-idnrk,
*          rankm TYPE zppt_mp_falta-rankm,
          rpdse TYPE zppt_mp_falta-rpdse,
          giroe TYPE zppt_mp_falta-giroe,
          pltes TYPE zppt_mp_falta-pltes,
        END OF lit_rank_prioridade.

  DATA: BEGIN OF lit_log_pe OCCURS 0,
          idnrk TYPE stpo-idnrk,
          matnr TYPE mchb-matnr,
          charg TYPE mchb-charg,
          resul TYPE char03,
        END OF lit_log_pe.

  DATA: lit_cdqua_faixa             TYPE TABLE OF zqmt_cdqua_faixa.

  DATA: lit_result TYPE TABLE OF ty_result,
        lit_makt   TYPE TABLE OF makt,
        lit_lfa1   TYPE TABLE OF lfa1.

  DATA: lwa_caract_matnr LIKE LINE OF it_caract_matnr,
        lwa_caract_charg LIKE LINE OF it_caract_charg.

  DATA: lv_matnr_laminacao             TYPE atwtb,
        lv_charg_laminacao             TYPE atwtb,
        lv_matnr_produto               TYPE atwtb,
        lv_charg_produto               TYPE atwtb,
        lv_matnr_mm_pos_tratamento     TYPE atwrt,
        lv_charg_mm_pos_tratamento     TYPE atwrt,
        lv_matnr_qualidade             TYPE atwrt,
        lv_charg_qualidade             TYPE atwrt,
        lv_qualidade                   TYPE ze_qualidades,
        lv_lines                       TYPE i,
        lv_matches                     TYPE c,
        lv_date_ini                    TYPE sy-datum,
        lv_time_ini                    TYPE sy-uzeit,
        lv_diff                        TYPE tvro-fahztd,
        lv_ano                         TYPE n LENGTH 4,
        lv_mes                         TYPE n LENGTH 2,
        lv_consistencia_toyota         TYPE c,
        lv_consistencia_cdqua          TYPE c,
*       Stefanini/Elaine Omine - PRJ1372 - 27/07/2023 - Início
*        lv_charg_sd_diametro_interno   TYPE atflv,
*        lv_charg_sd_diametro_externo   TYPE atflv,
        lv_charg_pdr_consulta_metal    TYPE atwrt,
        lv_matnr_pdr_consulta_metal    TYPE atwrt,
        lv_matnr_sd_hierarquia_produto TYPE atwrt,
        lv_matnr_sd_diam_int_minimo    TYPE atflv,
        lv_matnr_sd_diam_int_maximo    TYPE atflv,
        lv_matnr_sd_diam_ext_minimo    TYPE atflv,
        lv_matnr_sd_diam_ext_maximo    TYPE atflv,
        lv_matnr_sd_lim_res_minima     TYPE atflv,
        lv_matnr_sd_lim_res_maxima     TYPE atflv,
        lv_matnr_sd_espessura          TYPE atflv,
        lv_matnr_sd_largura            TYPE atflv,
        lv_matnr_sd_comprimento        TYPE atflv,
        lv_alternativo                 TYPE flag.
*        lv_charg_sd_lim_resistencia    TYPE atflv,
*        lv_charg_comp                  TYPE atflv.
*       Stefanini/Elaine Omine - PRJ1372 - 27/07/2023 - Fim

*RDM 260283
  DATA: lv_tipo_certificado         TYPE vbap-mvgr1.
*RDM 260283

  DATA: lv_charg_cnt         TYPE i,
        lv_matnr_cnt         TYPE i,
        lv_charg_cnt_str(10) TYPE c,
        lv_matnr_cnt_str(10) TYPE c,
        lv_charg_devc(100)   TYPE c,
        lv_result            TYPE c.

*RDM 315265
  DATA: lv_restrito TYPE c,
        lv_tabix    TYPE sy-tabix.
*RDM 315265

  FIELD-SYMBOLS: <fs_cdqua_faixa>     TYPE zqmt_cdqua_faixa,
                 <fs_mp_falta>        TYPE zppt_mp_falta,
                 <fs_marc>            TYPE marc,
                 <fs_rank_prioridade> LIKE LINE OF lit_rank_prioridade,
                 <fs_makt>            LIKE LINE OF lit_makt,
                 <fs_lfa1>            LIKE LINE OF lit_lfa1,
                 <fs_result>          TYPE ty_result,
                 <fs_lista_tecnica>   TYPE ty_lista_tecnica,
                 <fs_zrnppt_prev>     TYPE zrnppt_prev,
                 <fs_lista_alt>       TYPE zsuppt_lista_alt,
                 <fs_caract_charg>    LIKE LINE OF it_caract_charg,
                 <fs_caract_matnr>    LIKE LINE OF it_caract_matnr,
                 <fs_mslb>            TYPE mslb.

  REFRESH: it_result.

  SORT it_mp_falta BY matnr.
  SORT it_mchbcar BY ersda.
  SORT it_zrnppt_prev BY werks matnr.
  SORT it_mara BY matnr.
  SORT it_lista_tecnica BY werks matnr.
  SORT it_lta_reprov BY matnr idnrk charg.
  SORT it_inspecao_mp BY inspecao.
  SORT it_caract_charg BY matnr charg atnam.
  SORT it_caract_matnr BY matnr atnam.
  SORT it_mslb BY matnr charg.
  SORT it_laminacao_nova BY matnr.
  SORT it_vsamp_pa BY nr_lote.
* Stefanini/Elaine Omine - 19/07/2023 - Início
  SORT it_marc BY werks matnr.
* Stefanini/Elaine Omine - 19/07/2023 - Fim

*PM - Capabilidade - PRJ1372 - 15.03.2022
  SORT it_resb_231 BY werks matnr charg lgort.
  SORT it_resb_261 BY werks matnr charg lgort.
  SORT it_resb_bext BY matnr charg.
  SORT it_lista_alt BY matnr charg.
*PM - Capabilidade - PRJ1372 - 15.03.2022

  SELECT *
    INTO TABLE lit_cdqua_faixa
    FROM zqmt_cdqua_faixa.
  SORT lit_cdqua_faixa BY cod_qual laminacao.

  LOOP AT it_marc ASSIGNING <fs_marc>.
    READ TABLE it_lista_tecnica ASSIGNING <fs_lista_tecnica> WITH KEY werks = <fs_marc>-werks
                                                                      matnr = <fs_marc>-matnr
                                                                      BINARY SEARCH.
    IF sy-subrc IS INITIAL.
      READ TABLE it_mp_falta ASSIGNING <fs_mp_falta> WITH KEY matnr = <fs_lista_tecnica>-idnrk
                                                              BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        INSERT INITIAL LINE INTO TABLE lit_rank_prioridade ASSIGNING <fs_rank_prioridade>.
        <fs_rank_prioridade>-werks  = <fs_marc>-werks.
        <fs_rank_prioridade>-matnr  = <fs_marc>-matnr.
        <fs_rank_prioridade>-idnrk  = <fs_lista_tecnica>-idnrk.
*        <fs_rank_prioridade>-rankm  = <fs_mp_falta>-rankm.
        <fs_rank_prioridade>-rpdse  = <fs_mp_falta>-rpdse.
        <fs_rank_prioridade>-giroe  = <fs_mp_falta>-giroe.
        <fs_rank_prioridade>-pltes  = <fs_mp_falta>-pltes.
      ENDIF.
    ENDIF.
  ENDLOOP.
*  SORT lit_rank_prioridade BY rankm DESCENDING.

  "Priorização da aplicação dos SKUs:
  "1. Materiais com demanda e sem estoque
  "2. MP com maior giro de estoque (quanto menor o resultado, é mais rapido o consumo)
  "3. MP de menor politica de estoque
  SORT it_mp_falta BY rpdse DESCENDING giroe DESCENDING pltes DESCENDING.
  SORT lit_rank_prioridade BY rpdse DESCENDING giroe DESCENDING pltes DESCENDING.

  " Total de Lotes
  lv_charg_cnt = lines( it_mchbcar ).
  lv_charg_cnt_str = lv_charg_cnt.
  CONDENSE lv_charg_cnt_str.

  " Total de SKUs
  lv_matnr_cnt = lines( it_marc ).
  lv_matnr_cnt_str = lv_matnr_cnt.
  CONDENSE lv_matnr_cnt_str.

  CONCATENATE 'Buscando aplicação para' lv_charg_cnt_str 'lote(s) em' lv_matnr_cnt_str 'SKU(s)' INTO lv_charg_devc SEPARATED BY space.
  cl_progress_indicator=>progress_indicate(
    i_text = lv_charg_devc
    i_output_immediately = abap_true ).

  lv_date_ini = sy-datum.
  lv_time_ini = sy-uzeit.

  LOOP AT it_mp_falta INTO wa_mp_falta.

    LOOP AT lit_rank_prioridade WHERE idnrk = wa_mp_falta-matnr.

      READ TABLE it_marc INTO wa_marc WITH KEY werks = lit_rank_prioridade-werks
                                               matnr = lit_rank_prioridade-matnr
*                                              Stefanini/Elaine Omine - 19/07/2023 - Início
                                               BINARY SEARCH.
*                                              Stefanini/Elaine Omine - 19/07/2023 - Fim
      IF sy-subrc IS NOT INITIAL.
        CONTINUE.
      ENDIF.

      READ TABLE it_mara INTO wa_mara WITH KEY matnr = wa_marc-matnr
                                      BINARY SEARCH.
      IF sy-subrc IS NOT INITIAL.
        CONTINUE.
      ENDIF.

      "Descartar: Se SKU em analise não tiver demanda
*** Felipe Mattos -  S 5000000758: PP - PRJ1372 - DEM6116 - Início
*      IF p_gd = 'X'.
*        READ TABLE it_zrnppt_prev WITH KEY werks = wa_marc-werks
*                                           matnr = wa_marc-matnr
*                                           BINARY SEARCH
*                                           INTO wa_zrnppt_prev.
*        IF sy-subrc IS NOT INITIAL.
*          CONTINUE.
*        ENDIF.
*      ENDIF.
*** Felipe Mattos -  S 5000000758: PP - PRJ1372 - DEM6116 - Fim

      READ TABLE it_lista_tecnica WITH KEY werks = wa_marc-werks
                                           matnr = wa_marc-matnr
                                           INTO wa_lista_tecnica
                                           BINARY SEARCH.
      IF sy-subrc IS NOT INITIAL.
        CONTINUE.
      ENDIF.


      CLEAR: lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'HIERARQ_04'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr TRANSPORTING atwtb.
      lv_matnr_laminacao = lwa_caract_matnr-atwtb.


      CLEAR: lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'HIERARQ_05'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr TRANSPORTING atwtb.
      lv_matnr_produto = lwa_caract_matnr-atwtb.


      CLEAR: lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'MM_POS_TRATAMENTO'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr TRANSPORTING atwrt.
      lv_matnr_mm_pos_tratamento = lwa_caract_matnr-atwrt.

* INICIO: 11Jul2024 - RDM 314427 - RGC8096
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'MM_OLEAMENTO'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr TRANSPORTING atwrt.

      IF sy-subrc EQ 0.

        DATA(lv_matnr_oleamento) = lwa_caract_matnr-atwrt.

      ENDIF.

*      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
*                                          atnam = 'MM_NIVEL_OLEAMENTO'
*                                          BINARY SEARCH
*                                          INTO lwa_caract_matnr TRANSPORTING atwrt.
*
*      IF sy-subrc EQ 0.
*
*        DATA(lv_matnr_nivel_oleamento) = lwa_caract_matnr-atwrt.
*
*      ENDIF.

      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'MM_PECA_SEGURANCA'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr TRANSPORTING atwrt.

      IF sy-subrc EQ 0.

        DATA(lv_matnr_pc_seguranca) = lwa_caract_matnr-atwrt.

      ENDIF.
* FIM: 11Jul2024 - RDM 314427 - RGC8096

      CLEAR: lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'SD_QUALIDADES'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr TRANSPORTING atwrt.
      lv_matnr_qualidade = lwa_caract_matnr-atwrt.

*     Stefanini/Elaine Omine - PRJ1372 - 03/08/2023 - Início
      CLEAR lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'PDR_CONSULTA_METALURGICA'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr.
      lv_matnr_pdr_consulta_metal = lwa_caract_matnr-atwrt.

      CLEAR lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'SD_HIERARQUIA_PRODUTO'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr.
      lv_matnr_sd_hierarquia_produto = lwa_caract_matnr-atwrt.

      CLEAR lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'SD_DIAM_INT_MINIMO'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr.
      lv_matnr_sd_diam_int_minimo = lwa_caract_matnr-atflv.

      CLEAR lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'SD_DIAM_INT_MAXIMO'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr.
      lv_matnr_sd_diam_int_maximo = lwa_caract_matnr-atflv.

      CLEAR lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'SD_DIAM_EXT_MINIMO'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr.
      lv_matnr_sd_diam_ext_minimo = lwa_caract_matnr-atflv.

      CLEAR lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'SD_DIAM_EXT_MAXIMO'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr.
      lv_matnr_sd_diam_ext_maximo = lwa_caract_matnr-atflv.

      CLEAR lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'SD_LIM_RES_MINIMA'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr.
      lv_matnr_sd_lim_res_minima = lwa_caract_matnr-atflv.

      CLEAR: lwa_caract_matnr, lv_matnr_sd_lim_res_maxima.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'SD_LIM_RES_MAXIMA'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr.
      " Se limite máximo = 9999, desconsidera na comparação
      IF lwa_caract_matnr-atflv NE '9999'.
        lv_matnr_sd_lim_res_maxima = lwa_caract_matnr-atflv.
      ENDIF.

      CLEAR lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'SD_ESPESSURA'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr.
      lv_matnr_sd_espessura = lwa_caract_matnr-atflv.

      CLEAR lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'SD_LARGURA'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr.
      lv_matnr_sd_largura = lwa_caract_matnr-atflv.

      CLEAR lwa_caract_matnr.
      READ TABLE it_caract_matnr WITH KEY matnr = wa_marc-matnr
                                          atnam = 'SD_COMPRIMENTO'
                                          BINARY SEARCH
                                          INTO lwa_caract_matnr.
      lv_matnr_sd_comprimento = lwa_caract_matnr-atflv.
*     Stefanini/Elaine Omine - PRJ1372 - 03/08/2023 - Início

      CLEAR:  lv_consistencia_toyota.
      PERFORM f_check_consistencia_toyota USING wa_marc-werks
                                                wa_marc-matnr
                                                wa_mara-mtart
                                                wa_marc-lgpro
                                       CHANGING lv_consistencia_toyota.

*RDM 260283
      CLEAR lv_tipo_certificado.
      CALL FUNCTION 'ZQMF_TIPO_CERTIFICADO'
        EXPORTING
          i_werks                  = wa_marc-werks
          i_matnr                  = wa_marc-matnr
        IMPORTING
          e_mvgr1                  = lv_tipo_certificado
        EXCEPTIONS
          ov_item_nao_existe       = 1
          material_nao_existe      = 2
          informar_item_ov         = 3
          material_ov_divergente   = 4
          centro_ov_divergente     = 5
          informar_centro          = 6
          informar_material        = 7
          informar_ov              = 8
          tipo_nao_encontrado      = 9
          estrategia_nao_encontrad = 10
          OTHERS                   = 11.
      IF sy-subrc <> 0.
* Implement suitable error handling here
      ENDIF.
*RDM 260283


      CLEAR:  lv_consistencia_cdqua.
      READ TABLE lit_cdqua_faixa ASSIGNING <fs_cdqua_faixa> WITH KEY cod_qual  = lv_matnr_qualidade
                                                                     laminacao = lv_matnr_laminacao
                                                                     BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        lv_consistencia_cdqua = 'X'.
      ENDIF.


      CLEAR lv_lines.

      IF lv_alternativo IS INITIAL.
        PERFORM analise_alternativo USING lv_alternativo.
      ENDIF.

*|.....Base dos Lotes
      LOOP AT it_mchbcar INTO wa_mchbcar.

*       Stefanini/Elaine Omine - PRJ1372 - 21/07/2023 - Início
*        "Verificação do tempo de processamento
*        GET TIME. " atualiza as variáveis de sistema
*        CALL FUNCTION 'SD_CALC_DURATION_FROM_DATETIME'
*          EXPORTING
*            i_date1 = lv_date_ini
*            i_time1 = lv_time_ini
*            i_date2 = sy-datum
*            i_time2 = sy-uzeit
*          IMPORTING
*            e_tdiff = lv_diff.
*        IF lv_diff GE p_durat.
*          EXIT.
*        ENDIF.
*       Stefanini/Elaine Omine - PRJ1372 - 21/07/2023 - Fim

*      MESSAGE s398(00)
*          WITH 'Analisando o Lote:'
*               wa_mchbcar-charg
*               space
*               space.


        "Descartar: Se Lote já ficou como restrito para o IDNRK
        READ TABLE it_log_aplicacao WITH KEY idnrk_apl = lit_rank_prioridade-idnrk
                                             matnr     = wa_mchbcar-matnr
                                             charg     = wa_mchbcar-charg
                                    INTO wa_log_aplicacao.
        IF sy-subrc IS INITIAL.
          CONTINUE.
        ENDIF.

        "Descartar: Se material do lote for igual SKU em analise
        IF wa_mchbcar-matnr = wa_mara-matnr.
          PERFORM f_grava_it_log_aplicacao USING  wa_lista_tecnica-idnrk
                                                  wa_marc-matnr
                                                  wa_mchbcar-matnr
                                                  wa_mchbcar-charg
                                                  'SKU igual Material do Lote'.
          CONTINUE.
        ENDIF.

        "Descartar: Se material do lote for igual componente da lista do SKU em analise
        IF wa_mchbcar-matnr = wa_lista_tecnica-idnrk.
          PERFORM f_grava_it_log_aplicacao USING  wa_lista_tecnica-idnrk
                                                  wa_marc-matnr
                                                  wa_mchbcar-matnr
                                                  wa_mchbcar-charg
                                                  'Material do Lote igual Componente da Lista'.
          CONTINUE.
        ENDIF.

        "Descarta: Se Lote x SKU já foi reprovado pela Qualidade
        READ TABLE it_lta_reprov WITH KEY matnr = wa_marc-matnr
                                          idnrk = wa_mchbcar-matnr
                                          charg = wa_mchbcar-charg
                                          BINARY SEARCH
                                          INTO wa_lista_alt.
        IF sy-subrc IS INITIAL.
          PERFORM f_grava_it_log_aplicacao USING  wa_lista_tecnica-idnrk
                                                  wa_marc-matnr
                                                  wa_mchbcar-matnr
                                                  wa_mchbcar-charg
                                                  'Lote reprovado pela Qualidade'.
          CONTINUE.
        ENDIF.

        "Descartar: Se Lote já está como alternativo na GD
        READ TABLE it_lista_alt WITH KEY matnr = wa_mchbcar-matnr
                                         charg = wa_mchbcar-charg
                                         BINARY SEARCH
                                         INTO wa_lista_alt.
        IF sy-subrc IS INITIAL.
          PERFORM f_grava_it_log_aplicacao USING  wa_lista_tecnica-idnrk
                                                  wa_marc-matnr
                                                  wa_mchbcar-matnr
                                                  wa_mchbcar-charg
                                                  'Lote já está como alternativo na GD'.
          CONTINUE.
        ENDIF.

        CLEAR: lwa_caract_charg.
        READ TABLE it_caract_charg WITH KEY matnr = wa_mchbcar-matnr
                                            charg = wa_mchbcar-charg
                                            atnam = 'HIERARQ_05'
                                            BINARY SEARCH
                                            INTO lwa_caract_charg TRANSPORTING atwtb.
        lv_charg_produto = lwa_caract_charg-atwtb.

        "Descartar se SKU for Rolo e Lote for diferente de Bobina ou Rolo
        IF lv_matnr_produto = 'Rolo' AND
           ( lv_charg_produto NE 'Bobinas' AND lv_charg_produto NE 'Rolo' ).
          PERFORM f_grava_it_log_aplicacao USING  wa_lista_tecnica-idnrk
                                                  wa_marc-matnr
                                                  wa_mchbcar-matnr
                                                  wa_mchbcar-charg
                                                  'SKU igual Rolo e Lote diferente de Bobina ou Rolo'.
          CONTINUE.
        ENDIF.

        "Descartar se SKU for Bobina e Lote for diferente de Bobina ou Rolo
        IF lv_matnr_produto = 'Bobinas' AND
           ( lv_charg_produto NE 'Bobinas' AND lv_charg_produto NE 'Rolo' ).
          PERFORM f_grava_it_log_aplicacao USING  wa_lista_tecnica-idnrk
                                                  wa_marc-matnr
                                                  wa_mchbcar-matnr
                                                  wa_mchbcar-charg
                                                  'SKU igual Bobina e Lote diferente de Bobina ou Rolo'.
          CONTINUE.
        ENDIF.

        lv_matches = 'X'.

        "Consistencia Dimensional
        PERFORM f_consiste_dimensional
          USING wa_marc-werks
                wa_marc-matnr
                wa_mchbcar
                lv_matnr_produto
                lv_charg_produto
          CHANGING lv_matches.
        IF lv_matches = 'I'. "Não atende na Espessura ou Largura
          PERFORM f_grava_it_log_aplicacao USING  wa_lista_tecnica-idnrk
                                                  wa_marc-matnr
                                                  wa_mchbcar-matnr
                                                  wa_mchbcar-charg
                                                  'Inconsistencia Dimensional'.
          CONTINUE.
        ENDIF.

        CLEAR: lwa_caract_charg.
        READ TABLE it_caract_charg WITH KEY matnr = wa_mchbcar-matnr
                                            charg = wa_mchbcar-charg
                                            atnam = 'HIERARQ_04'
                                            BINARY SEARCH
                                            INTO lwa_caract_charg TRANSPORTING atwtb.
        lv_charg_laminacao = lwa_caract_charg-atwtb.

        "Consistência Laminação
        PERFORM f_consiste_laminacao
          USING wa_marc-werks
                wa_marc-matnr
                wa_mchbcar
                lv_charg_laminacao
                lv_matnr_laminacao
          CHANGING lv_matches.
        IF lv_matches IS INITIAL.
          PERFORM f_grava_it_log_aplicacao USING  wa_lista_tecnica-idnrk
                                                  wa_marc-matnr
                                                  wa_mchbcar-matnr
                                                  wa_mchbcar-charg
                                                  'Inconsistencia Laminacao'.
          CONTINUE.
        ENDIF.

