                                  WITH KEY werks = <fs_result>-werks_apl
                                           matnr = <fs_result>-matnr_apl
                                           BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-idnrk_apl = <fs_lista_tecnica>-idnrk.
      ENDIF.

      "Demanda Mes
      lv_ano = sy-datum(4).
      lv_mes = sy-datum+4(2).
      READ TABLE it_zrnppt_prev ASSIGNING <fs_zrnppt_prev>
                                WITH KEY werks = <fs_result>-werks_apl
                                         ano   = lv_ano
                                         mes   = lv_mes
                                         matnr = <fs_result>-matnr_apl
                                         BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-prev_org = <fs_zrnppt_prev>-peso.
      ENDIF.

      "Demanda M+1
      lv_mes = lv_mes + 1.
      IF lv_mes = 12.
        lv_ano  = lv_ano + 1.
        lv_mes  = 1.
      ENDIF.
      READ TABLE it_zrnppt_prev ASSIGNING <fs_zrnppt_prev>
                                WITH KEY werks = <fs_result>-werks_apl
                                         ano   = lv_ano
                                         mes   = lv_mes
                                         matnr = <fs_result>-matnr_apl
                                         BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-prev_org1 = <fs_zrnppt_prev>-peso.
      ENDIF.

      "Demanda M+2
      lv_mes = lv_mes + 1.
      IF lv_mes = 12.
        lv_ano  = lv_ano + 1.
        lv_mes  = 1.
      ENDIF.
      READ TABLE it_zrnppt_prev ASSIGNING <fs_zrnppt_prev>
                                WITH KEY werks = <fs_result>-werks_apl
                                         ano   = lv_ano
                                         mes   = lv_mes
                                         matnr = <fs_result>-matnr_apl
                                         BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-prev_org2 = <fs_zrnppt_prev>-peso.
      ENDIF.

      READ TABLE it_mslb ASSIGNING <fs_mslb> WITH KEY matnr = <fs_result>-matnr
                                                      charg = <fs_result>-charg
                                                      BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        READ TABLE lit_lfa1 ASSIGNING <fs_lfa1> WITH KEY lifnr = <fs_mslb>-lifnr.
        IF sy-subrc IS INITIAL.
          wa_outtab-charg_mslb = <fs_lfa1>-sortl.
        ENDIF.
      ENDIF.

      READ TABLE it_caract_charg ASSIGNING <fs_caract_charg>
                                 WITH KEY matnr = <fs_result>-matnr
                                          charg = <fs_result>-charg
                                          atnam = 'SD_SUPERFICIE'
                                          BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-superficie = <fs_caract_charg>-atwtb.
      ENDIF.

      READ TABLE it_caract_matnr ASSIGNING <fs_caract_matnr>
                                 WITH KEY matnr = <fs_result>-matnr_apl
                                          atnam = 'SD_SUPERFICIE'
                                          BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-superficie_apl = <fs_caract_matnr>-atwtb.
      ENDIF.

      "Define Status e Alerta
      IF <fs_result>-log IS INITIAL.

        wa_outtab-icon_stt = icon_green_light.
        TRANSLATE wa_outtab-statustxt TO UPPER CASE.
        APPEND wa_outtab TO gt_outtab1.

      ELSE.

        " verificar se o lote esta reservado
        PERFORM f_check_lote_reservado CHANGING wa_outtab
                                                wa_outtab-xloek.

        wa_outtab-icon_stt  = icon_yellow_light.

*       Stefanini/Elaine Omine - PRJ1372 - 02/08/2023 - Início
*        SPLIT <fs_result>-log AT '>>' INTO wa_outtab-statustxt wa_outtab-log.
        IF wa_outtab-xloek EQ 'E' OR
           wa_outtab-xloek EQ 'C' OR
           wa_outtab-xloek EQ 'R'.
          wa_outtab-statustxt = 'CAPABILIDADE'.
          wa_outtab-log       = <fs_result>-log.
        ELSEIF wa_outtab-xloek EQ 'M'.
          wa_outtab-statustxt = 'CONSULTA'.
          wa_outtab-log       = <fs_result>-log.
        ELSEIF wa_outtab-xloek EQ 'A'.
          wa_outtab-statustxt = 'CERTIFICADO'.
          wa_outtab-log       = <fs_result>-log.
        ELSE.
          SPLIT <fs_result>-log AT '>>' INTO wa_outtab-statustxt wa_outtab-log.
          TRANSLATE wa_outtab-statustxt TO UPPER CASE.
        ENDIF.
*       Stefanini/Elaine Omine - PRJ1372 - 02/08/2023 - Fim

*RDM 315265
*        TRANSLATE wa_outtab-statustxt TO UPPER CASE.
*        APPEND wa_outtab TO gt_outtab2.
*RDM 315265

*RDM 315265
        CLEAR lv_restrito.
        PERFORM f_classifica_log CHANGING wa_outtab
                                          lv_restrito.

        IF lv_restrito IS INITIAL.
          TRANSLATE wa_outtab-statustxt TO UPPER CASE.
          APPEND wa_outtab TO gt_outtab2.
        ELSE.
          wa_outtab-icon_stt  = icon_red_light.
          TRANSLATE wa_outtab-statustxt TO UPPER CASE.
          TRANSLATE wa_outtab-log TO UPPER CASE.
          APPEND wa_outtab TO gt_outtab3. " gt_outtab2. " rdm 324713
        ENDIF.
*RDM 315265

      ENDIF.

    ENDLOOP.

  ENDIF.

*RDM 315265
  "na opção OTIMIZADOR, não pode ter alternativo com restrição
  DATA(lt_outtab2) = gt_outtab2[].
  DELETE lt_outtab2 WHERE icon_stt NE icon_red_light.
  IF lt_outtab2[] IS NOT INITIAL.
    DELETE ADJACENT DUPLICATES FROM lt_outtab2 COMPARING matnr charg matnr_apl.
    SORT lt_outtab2 BY matnr charg matnr_apl.

    LOOP AT gt_outtab1 INTO wa_outtab.
      lv_tabix = sy-tabix.

      READ TABLE lt_outtab2 TRANSPORTING NO FIELDS
                            WITH KEY matnr      = wa_outtab-matnr
                                     charg      = wa_outtab-charg
                                     matnr_apl  = wa_outtab-matnr_apl
                                     BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        DELETE gt_outtab1 INDEX lv_tabix.
      ENDIF.
    ENDLOOP.

    LOOP AT gt_outtab2 INTO wa_outtab.
      lv_tabix = sy-tabix.

      READ TABLE lt_outtab2 TRANSPORTING NO FIELDS
                            WITH KEY matnr      = wa_outtab-matnr
                                     charg      = wa_outtab-charg
                                     matnr_apl  = wa_outtab-matnr_apl
                                     BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        DELETE gt_outtab2 INDEX lv_tabix.
      ENDIF.
    ENDLOOP.

  ENDIF.
*RDM 315265

  FREE: lit_cdqua_faixa, lit_result, lit_makt, lit_lfa1, lit_rank_prioridade, lit_log_pe, it_log_aplicacao.

