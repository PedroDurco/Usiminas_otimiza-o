  DATA: vl_clabs TYPE zppt_oest-clabs.

  SELECT * FROM zppt_oest
    INTO TABLE @DATA(tl_zppt_oest).

  SORT tl_zppt_oest BY werks matnr charg werks_apl matnr_apl.
  DELETE ADJACENT DUPLICATES FROM tl_zppt_oest COMPARING werks matnr charg werks_apl matnr_apl.

  LOOP AT it_mp_falta INTO DATA(wl_mp_falta).

    DATA(vl_tabix) = sy-tabix.

    CLEAR vl_clabs.

    LOOP AT tl_zppt_oest INTO DATA(wl_zppt_oest) WHERE matnr EQ wl_mp_falta-matnr.
      vl_clabs = vl_clabs + wl_zppt_oest-clabs.
    ENDLOOP.

    wl_mp_falta-bdmng = wl_mp_falta-bdmng - vl_clabs.

    IF wl_mp_falta-bdmng LE 0.
      DELETE it_mp_falta INDEX vl_tabix.
    ENDIF.

  ENDLOOP.
* Stefanini/Elaine Omine - PRJ1372 - 14/08/2023 - Fim

  SELECT stlty stlnr stlkn stpoz idnrk
    FROM stpo
    INTO CORRESPONDING FIELDS OF TABLE lit_stpo
    FOR ALL ENTRIES IN it_mp_falta
    WHERE idnrk EQ it_mp_falta-matnr
      AND stlty EQ 'M'
      AND kzkup EQ ''
      AND lkenz EQ ''.
  IF sy-subrc IS INITIAL.
    SELECT matnr werks stlan stlnr stlal
      FROM mast
      INTO CORRESPONDING FIELDS OF TABLE lit_mast
      FOR ALL ENTRIES IN lit_stpo
      WHERE stlnr EQ lit_stpo-stlnr
        AND stlan EQ '1'.

    PERFORM f_seleciona_prev_demandas.

    SORT lit_mast BY matnr werks.
    SORT lit_stpo BY stlnr.
    SORT it_zrnppt_prev BY matnr werks.

    LOOP AT lit_mast ASSIGNING <fs_mast>.

      IF p_gd EQ 'X'.
        READ TABLE it_zrnppt_prev ASSIGNING <fs_zrnppt_prev>
                                  WITH KEY matnr = <fs_mast>-matnr
                                           werks = <fs_mast>-werks
                                  BINARY SEARCH.
        IF sy-subrc IS NOT INITIAL.
          CONTINUE.
        ENDIF.
      ENDIF.

      READ TABLE lit_stpo ASSIGNING <fs_stpo>
                          WITH KEY stlnr = <fs_mast>-stlnr
                                   BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        INSERT INITIAL LINE INTO TABLE it_lista_tecnica ASSIGNING <fs_lista_tecnica>.
        <fs_lista_tecnica>-werks  = <fs_mast>-werks.
        <fs_lista_tecnica>-matnr  = <fs_mast>-matnr.
        <fs_lista_tecnica>-idnrk  = <fs_stpo>-idnrk.
      ENDIF.

    ENDLOOP.

    IF it_lista_tecnica[] IS NOT INITIAL.
      SELECT matnr mtart
        FROM mara
        APPENDING CORRESPONDING FIELDS OF TABLE it_mara
        FOR ALL ENTRIES IN it_lista_tecnica
        WHERE matnr = it_lista_tecnica-matnr.
    ENDIF.

