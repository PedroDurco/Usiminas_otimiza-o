INCLUDE zsuppr_pesquisa_aplicacao_imp4.

** 05/08 - RDM 330447 - início
AT SELECTION-SCREEN OUTPUT.
  LOOP AT SCREEN.
    IF screen-name = 'P_REST'.
      screen-input = 0.
      MODIFY SCREEN.
    ENDIF.
* 12/05/2026 - Nic-Labs - Depósito habilitado somente se Centro informado
    IF screen-name CS 'S_ELGRT'.
      IF s_ewrks[] IS INITIAL.
        screen-input = 0.
      ELSE.
        screen-input = 1.
      ENDIF.
      MODIFY SCREEN.
    ENDIF.
* 12/05/2026 - Nic-Labs - Fim
  ENDLOOP.
** 05/08 - RDM 330447 - FIM

*--------------------------------------------------------------------*
* SELEÇÃO DE DADOS
*--------------------------------------------------------------------*
START-OF-SELECTION.
  IF sy-tcode = 'ZPP_MP_ALTERNATIVA'.
    IF p_uname IS INITIAL.
      p_uname = sy-uname.
    ENDIF.
    PERFORM zf_carrega_resultado_job USING p_uname.
  ELSE.
    PERFORM f_valida_tela_selecao.
    PERFORM f_seleciona_parametros.
    PERFORM f_seleciona_aplicacao.

    IF it_marc[] IS INITIAL.
      MESSAGE 'Nenhuma Aplicação válida!' TYPE 'S' DISPLAY LIKE 'E'.
      LEAVE LIST-PROCESSING.
    ENDIF.

    PERFORM f_processa_aplicacao.

  ENDIF.

*--------------------------------------------------------------------*
* End-of-selection
*--------------------------------------------------------------------*
END-OF-SELECTION.
  IF gv_answer = '2'.
    STOP.
  ENDIF.

  IF gt_outtab1[] IS INITIAL AND
     gt_outtab2[] IS INITIAL AND
     gt_outtab3[] IS INITIAL.

    MESSAGE 'Nenhum Aplicação encontrada!' TYPE 'S' DISPLAY LIKE 'E'.
    LEAVE LIST-PROCESSING.
  ELSE.

*PP - Integração SAPxSistema PA (aproveitamento) - RDM 241927
*    PERFORM f_display_grids.

    IF sy-batch IS INITIAL.
      p_dynnr = '100'.
      PERFORM f_display_grids.
    ELSE.
      LOOP AT gt_outtab1 INTO wa_outtab.
        PERFORM zf_grava_saida.
      ENDLOOP.

      LOOP AT gt_outtab2 INTO wa_outtab.
        PERFORM zf_grava_saida.
      ENDLOOP.

      IF gt_outtab3[] IS NOT INITIAL.
        WRITE: / '--- Resultados Aba 3 (Sem Aplicação) ---'.
        WRITE: / 'Centro', 12 'Material', 32 'Lote', 50 'Depósito', 62 'Estoque'.
        WRITE: / sy-uline(80).
        LOOP AT gt_outtab3 INTO wa_outtab.
          WRITE: / wa_outtab-werks, 12 wa_outtab-matnr, 32 wa_outtab-charg, 50 wa_outtab-lgort, 62 wa_outtab-clabs.
        ENDLOOP.
        WRITE: / |Total registros aba 3: { lines( gt_outtab3 ) }|.
      ENDIF.

      LEAVE PROGRAM.
    ENDIF.
*PP - Integração SAPxSistema PA (aproveitamento) - RDM 241927

  ENDIF.
