FORM zf_grava_saida .
  DATA: lwa_pajt TYPE zppt_pajt,
        lv_seq   TYPE zppt_pajt-seq.

  SELECT MAX( seq )
    FROM zppt_pajt
    INTO lv_seq
    WHERE cprog EQ sy-cprog
      AND ernam EQ sy-uname.

  ADD 1 TO lv_seq.
  MOVE-CORRESPONDING wa_outtab TO lwa_pajt.
  lwa_pajt-cprog  = sy-cprog.
  lwa_pajt-ernam  = sy-uname.
  lwa_pajt-seq    = lv_seq.
  lwa_pajt-erdat  = sy-datum.
  lwa_pajt-erzet  = sy-uzeit.
  INSERT INTO zppt_pajt VALUES lwa_pajt.
  IF sy-subrc EQ 0.
    COMMIT WORK AND WAIT.
  ELSE.
    ROLLBACK WORK.
  ENDIF.
ENDFORM.                    " ZF_GRAVA_SAIDA
