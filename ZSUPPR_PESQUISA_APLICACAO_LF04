      <fs_caract_charg>-atnam = 'HIERARQ_05'.
      <fs_caract_charg>-atwtb = <fs_zppt_mchb_caract>-hierarq_05.

      "SD_QUALIDADES
      INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
      <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
      <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
      <fs_caract_charg>-atnam = 'SD_QUALIDADES'.
      <fs_caract_charg>-atwrt = <fs_zppt_mchb_caract>-sd_qualidades.

      "MM_POS_TRATAMENTO
      INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
      <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
      <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
      <fs_caract_charg>-atnam = 'MM_POS_TRATAMENTO'.
      <fs_caract_charg>-atwrt = <fs_zppt_mchb_caract>-mm_pos_tratamento.

      INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
      <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
      <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
      <fs_caract_charg>-atnam = 'MM_OLEAMENTO'.
      <fs_caract_charg>-atwrt = <fs_zppt_mchb_caract>-mm_oleamento.

      INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
      <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
      <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
      <fs_caract_charg>-atnam = 'MM_NIVEL_OLEAMENTO'.
      <fs_caract_charg>-atwrt = <fs_zppt_mchb_caract>-mm_nivel_oleamento.

      INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
      <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
      <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
      <fs_caract_charg>-atnam = 'MM_PECA_SEGURANCA'.
      <fs_caract_charg>-atwrt = <fs_zppt_mchb_caract>-mm_peca_seguranca.

      "SD_DIAMETRO_INTERNO
      INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
      <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
      <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
      <fs_caract_charg>-atnam = 'SD_DIAMETRO_INTERNO'.
      <fs_caract_charg>-atflv = <fs_zppt_mchb_caract>-sd_diametro_interno.

      "SD_DIAMETRO_EXTERNO
      INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
      <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
      <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
      <fs_caract_charg>-atnam = 'SD_DIAMETRO_EXTERNO'.
      <fs_caract_charg>-atflv = <fs_zppt_mchb_caract>-sd_diametro_externo.

      "PDR_CONSULTA_METALURGICA
      INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
      <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
      <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
      <fs_caract_charg>-atnam = 'PDR_CONSULTA_METALURGICA'.
      <fs_caract_charg>-atwrt = <fs_zppt_mchb_caract>-pdr_consulta_metalurgica.

      "SD_LIM_RESISTENCIA
      INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
      <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
      <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
      <fs_caract_charg>-atnam = 'SD_LIM_RESISTENCIA'.
      <fs_caract_charg>-atflv = <fs_zppt_mchb_caract>-sd_lim_resistencia.

      "SD_HIERARQUIA_PRODUTO
      INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
      <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
      <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
      <fs_caract_charg>-atnam = 'SD_HIERARQUIA_PRODUTO'.
      <fs_caract_charg>-atwrt = <fs_zppt_mchb_caract>-sd_hierarquia_produto.
    ELSE.
      INSERT INITIAL LINE INTO TABLE lit_matnr_objek ASSIGNING <fs_matnr_objek>.
      <fs_matnr_objek>-objek = <fs_mchbcar>-matnr.

      INSERT INITIAL LINE INTO TABLE lit_charg_objek ASSIGNING <fs_charg_objek>.
      lv_objek    = <fs_mchbcar>-matnr.
      lv_objek+18 = <fs_mchbcar>-charg.
      <fs_charg_objek>-objek = lv_objek.
    ENDIF.
  ENDLOOP.

  IF lit_matnr_objek[] IS NOT INITIAL.
    SORT lit_matnr_objek BY objek.
    DELETE ADJACENT DUPLICATES FROM lit_matnr_objek COMPARING objek.
    SELECT objek cuobj
      FROM inob
      INTO TABLE lit_inob
      FOR ALL ENTRIES IN lit_matnr_objek
      WHERE obtab = 'MARA'
        AND objek EQ lit_matnr_objek-objek
        AND klart = '023'.
  ENDIF.

  IF lit_charg_objek[] IS NOT INITIAL.
    SORT lit_charg_objek BY objek.
    DELETE ADJACENT DUPLICATES FROM lit_charg_objek COMPARING objek.
    SELECT objek cuobj
      FROM inob
      APPENDING TABLE lit_inob
      FOR ALL ENTRIES IN lit_charg_objek
      WHERE obtab = 'MCH1'
        AND objek EQ lit_charg_objek-objek
        AND klart = '023'.
  ENDIF.

  IF lit_inob[] IS NOT INITIAL.
    SORT lit_inob BY objek.
    REFRESH it_atinn.
    PERFORM f_add_atinn USING 'SD_NUMERO_INSPECAO'.
    PERFORM f_add_atinn USING 'SD_TOL_MAX_ESPESSURA'.
    PERFORM f_add_atinn USING 'SD_TOL_MIN_ESPESSURA'.
    PERFORM f_add_atinn USING 'SD_ESPESSURA'.
    PERFORM f_add_atinn USING 'SD_TOL_MIN_LARGURA'.
    PERFORM f_add_atinn USING 'SD_LARGURA'.
    PERFORM f_add_atinn USING 'SD_COMPRIMENTO'.
    PERFORM f_add_atinn USING 'SD_REVESTIMENTO_INFERIOR'.
    PERFORM f_add_atinn USING 'SD_REVESTIMENTO_SUPERIOR'.
    PERFORM f_add_atinn USING 'MM_REVESTIMENTO_TOTAL'.
    PERFORM f_add_atinn USING 'SD_QUALIDADES'.
    PERFORM f_add_atinn USING 'SD_DIAMETRO_INTERNO'.
    PERFORM f_add_atinn USING 'SD_DIAMETRO_EXTERNO'.
    PERFORM f_add_atinn USING 'PDR_CONSULTA_METALURGICA'.
    PERFORM f_add_atinn USING 'SD_LIM_RESISTENCIA'.
    PERFORM f_add_atinn USING 'SD_HIERARQUIA_PRODUTO'.

    LOOP AT it_atinn INTO lwa_atinn.
      r_atinn-sign    = 'I'.
      r_atinn-option  = 'EQ'.
      r_atinn-low     = lwa_atinn-atinn.
      APPEND r_atinn.
    ENDLOOP.

    LOOP AT it_mchbcar ASSIGNING <fs_mchbcar>.
      lv_objek        = <fs_mchbcar>-matnr.
      lv_objek+18     = <fs_mchbcar>-charg.

      READ TABLE lit_inob ASSIGNING <fs_inob> WITH KEY objek = lv_objek BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        LOOP AT it_atinn ASSIGNING <fs_atinn>.
          INSERT INITIAL LINE INTO TABLE lit_charg_ausp ASSIGNING <fs_charg_ausp>.
          <fs_charg_ausp>-objek = <fs_inob>-cuobj.
          <fs_charg_ausp>-klart = '023'.
          <fs_charg_ausp>-matnr = <fs_mchbcar>-matnr.
          <fs_charg_ausp>-charg = <fs_mchbcar>-charg.
          <fs_charg_ausp>-atinn = <fs_atinn>-atinn.
        ENDLOOP.
      ENDIF.
    ENDLOOP.

    REFRESH it_atinn.
    PERFORM f_add_atinn USING 'SD_SUPERFICIE'.
    PERFORM f_add_atinn USING 'HIERARQ_04'.
    PERFORM f_add_atinn USING 'HIERARQ_05'.
    PERFORM f_add_atinn USING 'MM_POS_TRATAMENTO'.
    PERFORM f_add_atinn USING 'MM_OLEAMENTO'.
    PERFORM f_add_atinn USING 'MM_NIVEL_OLEAMENTO'.
    PERFORM f_add_atinn USING 'MM_PECA_SEGURANCA'.

    LOOP AT it_atinn INTO lwa_atinn.
      r_atinn-sign    = 'I'.
      r_atinn-option  = 'EQ'.
      r_atinn-low     = lwa_atinn-atinn.
      APPEND r_atinn.
    ENDLOOP.

    LOOP AT it_mchbcar ASSIGNING <fs_mchbcar>.
      lv_objek        = <fs_mchbcar>-matnr.
      LOOP AT it_atinn ASSIGNING <fs_atinn>.
        "classe 001
        INSERT INITIAL LINE INTO TABLE lit_charg_ausp ASSIGNING <fs_charg_ausp>.
        <fs_charg_ausp>-objek = <fs_mchbcar>-matnr.
        <fs_charg_ausp>-klart = '001'.
        <fs_charg_ausp>-matnr = <fs_mchbcar>-matnr.
        <fs_charg_ausp>-charg = <fs_mchbcar>-charg.
        <fs_charg_ausp>-atinn = <fs_atinn>-atinn.

        "classe 023
        READ TABLE lit_inob ASSIGNING <fs_inob> WITH KEY objek = lv_objek BINARY SEARCH.
        IF sy-subrc IS INITIAL.
          INSERT INITIAL LINE INTO TABLE lit_charg_ausp ASSIGNING <fs_charg_ausp>.
          <fs_charg_ausp>-objek = <fs_inob>-cuobj.
          <fs_charg_ausp>-klart = '023'.
          <fs_charg_ausp>-matnr = <fs_mchbcar>-matnr.
          <fs_charg_ausp>-charg = <fs_mchbcar>-charg.
          <fs_charg_ausp>-atinn = <fs_atinn>-atinn.
        ENDIF.
      ENDLOOP.
    ENDLOOP.

    CHECK lit_charg_ausp[] IS NOT INITIAL.

    lit_objek_ausp[] = lit_charg_ausp[].
    SORT lit_charg_ausp BY objek.
    DELETE ADJACENT DUPLICATES FROM lit_objek_ausp COMPARING objek.

    LOOP AT lit_objek_ausp ASSIGNING <fs_ausp>.
      lwa_keys_selopt-sign    = 'I'.
      lwa_keys_selopt-option  = 'EQ'.
      lwa_keys_selopt-low     = <fs_ausp>-objek.
      APPEND lwa_keys_selopt TO lit_keys_selopt.
      CLEAR lwa_keys_selopt.
      ADD 1 TO lv_count.

      IF lv_count EQ 3000.
        SELECT objek
               atinn
               atzhl
               mafid
               klart
               adzhl
               atwrt
               atflv
          FROM ausp
          APPENDING TABLE lit_ausp
          WHERE objek IN lit_keys_selopt.
        CLEAR: lit_keys_selopt[], lv_count.
      ENDIF.
    ENDLOOP.
    IF lv_count GT 0.
      SELECT objek
             atinn
             atzhl
             mafid
             klart
             adzhl
             atwrt
             atflv
        FROM ausp
        APPENDING TABLE lit_ausp
        WHERE objek IN lit_keys_selopt.
      CLEAR lv_count.
      FREE  lit_keys_selopt.
    ENDIF.

    DELETE lit_ausp WHERE atinn NOT IN r_atinn.
    IF lit_ausp[] IS NOT INITIAL.
      SORT lit_ausp BY objek atinn.

      lit_ausp_aux = lit_ausp.
      SORT lit_ausp_aux BY atinn.
      DELETE ADJACENT DUPLICATES FROM lit_ausp_aux COMPARING atinn.
      SELECT atinn atnam
        FROM cabn
        INTO TABLE lit_cabn
        FOR ALL ENTRIES IN lit_ausp_aux
        WHERE atinn = lit_ausp_aux-atinn.
      SORT lit_cabn BY atinn.

      lit_ausp_aux = lit_ausp.
      SORT lit_ausp_aux BY atinn atwrt.
      DELETE ADJACENT DUPLICATES FROM lit_ausp_aux COMPARING atinn atwrt.
      SELECT atinn atwrt atzhl adzhl
        FROM cawn  INTO TABLE lit_cawn
        FOR ALL ENTRIES IN lit_ausp_aux
        WHERE atinn = lit_ausp_aux-atinn
          AND atwrt = lit_ausp_aux-atwrt.
      SORT lit_cawn BY atinn atwrt.

      IF NOT lit_cawn[] IS INITIAL.
        SELECT atinn atzhl adzhl atwtb FROM cawnt
          INTO TABLE lit_cawnt
          FOR ALL ENTRIES IN lit_cawn
          WHERE atinn = lit_cawn-atinn
            AND atzhl = lit_cawn-atzhl
            AND spras = sy-langu
            AND adzhl = lit_cawn-adzhl.
        SORT lit_cawnt BY atinn atzhl adzhl.
      ENDIF.

      LOOP AT lit_charg_ausp ASSIGNING <fs_charg_ausp>.
        READ TABLE lit_ausp ASSIGNING <fs_ausp> WITH KEY objek = <fs_charg_ausp>-objek
                                                         atinn = <fs_charg_ausp>-atinn
                                                         BINARY SEARCH.
        IF sy-subrc IS NOT INITIAL.
          CONTINUE.
        ENDIF.

        READ TABLE lit_cabn ASSIGNING <fs_cabn> WITH KEY atinn = <fs_ausp>-atinn BINARY SEARCH.
        IF sy-subrc IS NOT INITIAL.
          CONTINUE.
        ENDIF.

        INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
        <fs_caract_charg>-matnr = <fs_charg_ausp>-matnr.
        <fs_caract_charg>-charg = <fs_charg_ausp>-charg.
        <fs_caract_charg>-atnam = <fs_cabn>-atnam.
        <fs_caract_charg>-atwrt = <fs_ausp>-atwrt.
        <fs_caract_charg>-atflv = <fs_ausp>-atflv.
        READ TABLE lit_cawn ASSIGNING <fs_cawn> WITH KEY atinn = <fs_ausp>-atinn
                                                         atwrt = <fs_ausp>-atwrt BINARY SEARCH.
        IF sy-subrc IS INITIAL.
          READ TABLE lit_cawnt ASSIGNING <fs_cawnt> WITH KEY atinn = <fs_cawn>-atinn
                                                             atzhl = <fs_cawn>-atzhl
                                                             adzhl = <fs_cawn>-adzhl BINARY SEARCH.
          IF sy-subrc IS INITIAL.
            <fs_caract_charg>-atwtb = <fs_cawnt>-atwtb.
          ENDIF.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDIF.

  FREE: lit_zppt_mchb_caract,
        lit_mchb_caract_insp,
        lit_inspecao,
        lit_matnr_objek,
        lit_charg_objek,
        lit_charg_ausp,
        lit_objek_ausp,
        lit_ausp,
        lit_ausp_aux,
        lit_inob,
        lit_cabn,
        lit_cawn,
        lit_cawnt,
        r_atinn.
ENDFORM.                    " F_SELECIONA_CARACT_CHARG
