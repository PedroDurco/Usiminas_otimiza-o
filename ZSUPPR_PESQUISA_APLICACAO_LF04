        wa_outtab-mark = 'X'.
        IF g_tab_appl-subscreen = '0101'.
          MODIFY gt_outtab1 FROM wa_outtab INDEX sy-tabix TRANSPORTING mark.
        ELSEIF g_tab_appl-subscreen = '0102'.
          MODIFY gt_outtab2 FROM wa_outtab INDEX sy-tabix TRANSPORTING mark.
        ELSE.
          MODIFY gt_outtab3 FROM wa_outtab INDEX sy-tabix TRANSPORTING mark.
        ENDIF.
      ENDIF.

      SELECT MAX( seq )
        FROM zppt_pajt
        INTO lv_seq
        WHERE cprog EQ 'ZSUPPR_PROCESSA_SOLICITACAO_MP'.

      ADD 1 TO lv_seq.
      MOVE-CORRESPONDING wa_outtab TO lwa_pajt.
      lwa_pajt-clabs    = wa_outtab-bdmng.
      IF wa_outtab-bdmng < wa_outtab-clabs.
        lwa_pajt-resbp = 'X'. "Reserva parcial do lote
