      lwa_pajt-seq      = lv_seq.
      lwa_pajt-erdat    = sy-datum.
      lwa_pajt-erzet    = sy-uzeit.
      lwa_pajt-usuario  = sy-uname.
      lwa_pajt-data     = sy-datum.
      lwa_pajt-hora     = sy-uzeit.
      INSERT zppt_pajt FROM lwa_pajt.
      COMMIT WORK.

      "Adicionar registro na ZPPT_OEST
      SELECT MAX( seq )
        FROM zppt_oest
        INTO lv_seq
        WHERE cprog EQ 'ZSUPPR_PROCESSA_SOLICITACAO_MP'.

