      "SD_TOL_MAX_ESPESSURA
      INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
      <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
