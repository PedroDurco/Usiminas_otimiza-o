      ELSEIF g_tab_appl-subscreen = '0102'.
        READ TABLE gt_outtab2 INTO wa_outtab INDEX ls_selrow-index.
      ELSE.
        READ TABLE gt_outtab3 INTO wa_outtab INDEX ls_selrow-index.
      ENDIF.

      IF NOT sy-subrc IS INITIAL.
        CONTINUE.
