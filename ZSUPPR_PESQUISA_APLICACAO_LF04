*FORM f_seleciona_reservas .
*  DATA lit_resb TYPE STANDARD TABLE OF ty_resb.
*
*  cl_progress_indicator=>progress_indicate(
*    i_text = 'Selecionando as Reservas Ativas...'
*    i_output_immediately = abap_true ).
*
*  REFRESH:  it_resb_231,
*            it_resb_261,
*            it_resb_bext.
*
*  SELECT rsnum
*         rspos
*         rsart
*         matnr
*         werks
*         lgort
*         charg
*         baugr
*         bwart
*         bdmng
*         enmng
*         banfn
*         ebeln
*         kdauf
*    INTO TABLE lit_resb
