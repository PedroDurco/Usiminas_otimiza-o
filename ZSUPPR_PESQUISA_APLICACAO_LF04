FORM f_carrega_pendente_qualidade .
  DATA: lit_zppt_oest TYPE TABLE OF zppt_oest,
        lwa_zppt_oest TYPE zppt_oest.

  DATA: lit_marc TYPE STANDARD TABLE OF ty_marc,
        lwa_marc LIKE LINE OF lit_marc.

  REFRESH gt_outtab3.

  SELECT *
    FROM zppt_oest
    INTO TABLE lit_zppt_oest.

  IF lit_zppt_oest[] IS NOT INITIAL.
    SELECT matnr
           werks
           lgpro
           strgr
      FROM marc
      INTO TABLE lit_marc
      FOR ALL ENTRIES IN lit_zppt_oest
      WHERE matnr = lit_zppt_oest-matnr_apl
        AND werks = lit_zppt_oest-werks_apl.
    SORT lit_marc BY matnr werks.
  ENDIF.

  LOOP AT lit_zppt_oest INTO lwa_zppt_oest.
    MOVE-CORRESPONDING lwa_zppt_oest TO wa_outtab.
    IF wa_outtab-lgort_apl IS INITIAL.
      READ TABLE lit_marc INTO lwa_marc WITH KEY matnr = lwa_zppt_oest-matnr_apl
                                                 werks = lwa_zppt_oest-werks_apl
                                                 BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-lgort_apl = lwa_marc-lgpro.
      ENDIF.
    ENDIF.
    APPEND wa_outtab TO gt_outtab3.
    CLEAR wa_outtab.
  ENDLOOP.
ENDFORM.                    " F_CARREGA_PENDENTE_QUALIDADE
