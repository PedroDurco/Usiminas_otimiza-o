FORM f_seleciona_zrnppt_prev USING p_ano
                                   p_mes_f
                                   p_mes_t.
  SELECT *
    FROM zrnppt_prev
    APPENDING TABLE it_zrnppt_prev
    WHERE werks IN s_werks
      AND ano   EQ p_ano
      AND mes   BETWEEN p_mes_f AND p_mes_t
      AND peso > 0
      AND ativo EQ 'S'
      AND matnr BETWEEN '34000000' AND '34999999'.
ENDFORM.                    " F_SELECIONA_ZRNPPT_PREV
