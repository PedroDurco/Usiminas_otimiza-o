*&---------------------------------------------------------------------*
FORM f_consiste_reserva_op  USING p_werks
                                  p_matnr
                                  p_wa_mchbcar LIKE wa_mchbcar
                         CHANGING p_matches.

  READ TABLE it_resb_261 INTO wa_resb
        WITH KEY werks = p_wa_mchbcar-werks
                 matnr = p_wa_mchbcar-matnr
                 charg = p_wa_mchbcar-charg
                 BINARY SEARCH.
  IF sy-subrc IS INITIAL.
    p_matches = ''.
    MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
    wa_result-werks_apl = p_werks.
    wa_result-matnr_apl = p_matnr.
    wa_result-log       = 'RESERVA >> Lote com Reserva Ativa (TP 261)'.
    wa_result-xloek     = 'X'.
    APPEND wa_result TO it_result.
    CLEAR wa_result.
    RETURN.
  ENDIF.

  " Filter batches reserved for Requisition
  READ TABLE it_resb_bext INTO wa_resb
        WITH KEY matnr = p_wa_mchbcar-matnr
                 charg = p_wa_mchbcar-charg
                 BINARY SEARCH.
  IF sy-subrc IS INITIAL.
    p_matches = ''.
    MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
    wa_result-werks_apl = p_werks.
    wa_result-matnr_apl = p_matnr.
    IF wa_resb-banfn  IS NOT INITIAL OR wa_resb-ebeln IS NOT INITIAL.
      wa_result-log       = 'Reserva >> Reserva desconhecida'.
    ELSE.
      wa_result-log       = 'Reserva >> Item em pedido BEXT'.
    ENDIF.
    wa_result-xloek     = 'X'.
    APPEND wa_result TO it_result.
    CLEAR wa_result.
    RETURN.
  ENDIF.

  READ TABLE it_resb_231 INTO wa_resb
        WITH KEY werks = p_wa_mchbcar-werks
                 matnr = p_wa_mchbcar-matnr
                 charg = p_wa_mchbcar-charg
                 BINARY SEARCH.
  IF sy-subrc IS INITIAL.
    p_matches = ''.
    MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
    wa_result-werks_apl = p_werks.
    wa_result-matnr_apl = p_matnr.
    wa_result-log       = 'RESERVA >> Lote está como alternativo na GD (TP 231)'.
    wa_result-xloek     = 'X'.

    IF wa_resb-kdauf = 'EMPRODUÇÃO'.
      READ TABLE it_pajt_log TRANSPORTING NO FIELDS WITH KEY werks = p_wa_mchbcar-werks
                                                             matnr = p_wa_mchbcar-matnr
                                                             charg = p_wa_mchbcar-charg.
      IF sy-subrc IS INITIAL.
        wa_result-log       = 'RESERVA >> Lote está como alternativo na GD (TP 231)'.
      ENDIF.
    ENDIF.

    APPEND wa_result TO it_result.
    CLEAR wa_result.
    RETURN.
  ENDIF.

  READ TABLE it_lista_alt TRANSPORTING NO FIELDS WITH KEY matnr = p_wa_mchbcar-matnr
                                                          charg = p_wa_mchbcar-charg
                                                          BINARY SEARCH.
  IF sy-subrc IS INITIAL.
    p_matches = ''.
    MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
    wa_result-werks_apl = p_werks.
    wa_result-matnr_apl = p_matnr.
    wa_result-log       = 'RESERVA >> Lote está como alternativo na GD'.
    wa_result-xloek     = 'X'.
    APPEND wa_result TO it_result.
    CLEAR wa_result.
    RETURN.
  ENDIF.

  SELECT COUNT( * )
    FROM zppt_oest
   WHERE matnr_apl EQ @p_matnr
     AND werks_apl EQ @p_werks.
  IF sy-subrc IS INITIAL.
    p_matches = ''.
    MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
    wa_result-werks_apl = p_werks.
    wa_result-matnr_apl = p_matnr.
    wa_result-log       = 'EM APROVAÇAO >> Lote liberado por OM'.
    CLEAR wa_result-xloek.
    APPEND wa_result TO it_result.
    CLEAR wa_result.
    RETURN.
  ENDIF.
ENDFORM.                    " F_CONSISTE_RESERVA_OP
*&---------------------------------------------------------------------*
*&      Form  F_CONSISTE_REVESTIMENTO
*&---------------------------------------------------------------------*
FORM f_consiste_revestimento USING p_werks
                                   p_matnr
                                   p_wa_mchbcar LIKE wa_mchbcar
                          CHANGING p_matches.
  DATA: lit_pn        TYPE TABLE OF zqmt_partnumber,
        lit_caract_ma TYPE TABLE OF zrnmme_poa_caract_ma.

  DATA: lwa_pn           LIKE LINE OF lit_pn,
        lwa_caract_ma    TYPE zrnmme_poa_caract_ma,
        lwa_caract_charg LIKE LINE OF it_caract_charg,
        lwa_caract_matnr LIKE LINE OF it_caract_matnr,
        lwa_rest_qualid  TYPE zmmt_rest_qualid,
        lwa_rest_revest  TYPE zmmt_rest_revest.

  DATA: lv_laminacao_nova    TYPE zpp_de_lamin,
        lv_qualidade         TYPE ze_qualidades,
        lv_ind_prod          TYPE zmmt_rest_qualid-ind_produto,
        lv_revestimento      TYPE atwrt,
        lv_atinn             TYPE cabn-atinn,
        lv_log               TYPE ze_log_petiq,
        lv_erro_revestimento TYPE c.

  DATA: lv_car_rev_sup_min TYPE zrnqmt_cert_ite-ens_sup,
        lv_car_rev_sup_max TYPE zrnqmt_cert_ite-ens_sup,
        lv_car_rev_inf_min TYPE zrnqmt_cert_ite-ens_inf,
        lv_car_rev_inf_max TYPE zrnqmt_cert_ite-ens_inf,
        lv_car_rev_tot_min TYPE zrnqmt_cert_ite-ens_tot,
        lv_car_rev_tot_max TYPE zrnqmt_cert_ite-ens_tot.

  DATA: lv_charg_revestimento_inferior TYPE zrnqmt_cert_ite-ens_inf,
        lv_charg_revestimento_superior TYPE zrnqmt_cert_ite-ens_sup,
        lv_charg_revestimento_total    TYPE zrnqmt_cert_ite-ens_tot.

  CLEAR wa_laminacao_nova.
  READ TABLE it_laminacao_nova INTO wa_laminacao_nova
        WITH KEY matnr = p_matnr.
  IF sy-subrc IS NOT INITIAL.
    CALL FUNCTION 'ZQMF_BUSCA_LAMINACAO'
      EXPORTING
        im_matnr                     = p_matnr
        im_werks                     = p_werks
      IMPORTING
        ex_laminacao_nova            = wa_laminacao_nova-laminacao_nova
      EXCEPTIONS
        estrategia_nao_tratada       = 1
        material_nao_encontrado      = 2
        mais_de_uma_laminacao        = 3
        nenhuma_laminacao_encontrada = 4
        OTHERS                       = 5.
    IF sy-subrc EQ 0.
      wa_laminacao_nova-matnr = p_matnr.
      APPEND wa_laminacao_nova TO it_laminacao_nova.
    ENDIF.
  ENDIF.
  lv_laminacao_nova = wa_laminacao_nova-laminacao_nova.

* Consiste apenas laminação do tipo EG ou ZN
  IF lv_laminacao_nova NE 'EG' AND
     lv_laminacao_nova NE 'ZN'.
    RETURN.
  ENDIF.

  CLEAR zqmt_partnumber-partnumber.
  SELECT SINGLE *
    FROM zqmt_partnumber
    WHERE matnr_antigo = p_matnr
      AND status IN ('LIB', 'LIR').
  IF sy-subrc IS INITIAL.
    SELECT *
      FROM zqmt_partnumber
      INTO TABLE lit_pn
      WHERE partnumber EQ zqmt_partnumber-partnumber.

    READ TABLE lit_pn INTO lwa_pn WITH KEY atnam = 'SD_TOL_REV_MIN_INFERIOR'.
    IF sy-subrc IS INITIAL.
      CONDENSE lwa_pn-resul.
      REPLACE ',' WITH '.' INTO lwa_pn-resul.
      lv_car_rev_inf_min = lwa_pn-resul.
    ENDIF.
    READ TABLE lit_pn INTO lwa_pn WITH KEY atnam = 'SD_TOL_REV_MAX_INFERIOR'.
    IF sy-subrc IS INITIAL.
      CONDENSE lwa_pn-resul.
      REPLACE ',' WITH '.' INTO lwa_pn-resul.
      lv_car_rev_inf_max = lwa_pn-resul.
    ENDIF.
    READ TABLE lit_pn INTO lwa_pn WITH KEY atnam = 'SD_TOL_REV_MIN_SUPERIOR'.
    IF sy-subrc IS INITIAL.
      CONDENSE lwa_pn-resul.
      REPLACE ',' WITH '.' INTO lwa_pn-resul.
      lv_car_rev_sup_min = lwa_pn-resul.
    ENDIF.
    READ TABLE lit_pn INTO lwa_pn WITH KEY atnam = 'SD_TOL_REV_MAX_SUPERIOR'.
    IF sy-subrc IS INITIAL.
      CONDENSE lwa_pn-resul.
      REPLACE ',' WITH '.' INTO lwa_pn-resul.
      lv_car_rev_sup_max = lwa_pn-resul.
    ENDIF.
    READ TABLE lit_pn INTO lwa_pn WITH KEY atnam = 'PDR_TOL_REV_MIN_TOTAL'.
    IF sy-subrc IS INITIAL.
      CONDENSE lwa_pn-resul.
      REPLACE ',' WITH '.' INTO lwa_pn-resul.
      lv_car_rev_tot_min = lwa_pn-resul.
    ENDIF.
    READ TABLE lit_pn INTO lwa_pn WITH KEY atnam = 'PDR_TOL_REV_MAX_TOTAL'.
    IF sy-subrc IS INITIAL.
      CONDENSE lwa_pn-resul.
      REPLACE ',' WITH '.' INTO lwa_pn-resul.
      lv_car_rev_tot_max = lwa_pn-resul.
    ENDIF.
  ELSE.
    "Obter Revestimento do 12k da Lista Tecnica
    CLEAR wa_lista_tecnica.
    READ TABLE it_lista_tecnica WITH KEY werks = p_werks
                                         matnr = p_matnr
                                         BINARY SEARCH
                                         INTO wa_lista_tecnica.
    IF sy-subrc IS INITIAL.
      CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
        EXPORTING
          input  = 'MM_REVESTIMENTO'
        IMPORTING
          output = lv_atinn.

      REFRESH lit_caract_ma.
      CALL FUNCTION 'ZRNMMF_SEARCH_CMAT'
        EXPORTING
          matnr                     = wa_lista_tecnica-idnrk
          klart                     = '023'
          idioma                    = sy-langu
          caracteristica            = lv_atinn
        TABLES
          itab_mat                  = lit_caract_ma
        EXCEPTIONS
          matnr_not_found           = 1
          matnr_or_mara_not_found   = 2
          caracteristicas_not_found = 3
          classe_not_found          = 4
          OTHERS                    = 5.

      CLEAR: lv_revestimento, lwa_caract_ma.
      READ TABLE lit_caract_ma INTO lwa_caract_ma INDEX 1.
      lv_revestimento = lwa_caract_ma-atwrt.

    ENDIF.

    "Obter Qualidade do 34k
    CLEAR lwa_caract_matnr.
    READ TABLE it_caract_matnr WITH KEY matnr = p_matnr
                                        atnam = 'SD_QUALIDADES'
                                        BINARY SEARCH
                                        INTO lwa_caract_matnr TRANSPORTING atwrt.
    MOVE lwa_caract_matnr-atwrt TO lv_qualidade.

    "Obter Ind.Prod/Familia do 34k
    CLEAR lwa_caract_matnr.
    READ TABLE it_caract_matnr WITH KEY matnr = p_matnr
                                        atnam = 'HIERARQ_02'
                                        BINARY SEARCH
                                        INTO lwa_caract_matnr TRANSPORTING atwtb.
    CONDENSE lwa_caract_matnr-atwtb.
    TRANSLATE lwa_caract_matnr-atwtb TO UPPER CASE.
    lv_ind_prod = lwa_caract_matnr-atwtb.

    CLEAR: lwa_rest_qualid, lwa_rest_revest.
    SELECT SINGLE *
      INTO lwa_rest_qualid
      FROM zmmt_rest_qualid
      WHERE tp_laminacao  = lv_laminacao_nova
        AND qualidades    = lv_qualidade
        AND ind_produto   = lv_ind_prod.
    IF sy-subrc IS INITIAL.
      SELECT SINGLE *
        INTO lwa_rest_revest
        FROM zmmt_rest_revest
        WHERE tp_laminacao = lv_laminacao_nova
          AND normarevest  = lwa_rest_qualid-normarevest
          AND revestimento = lv_revestimento.
      IF sy-subrc IS INITIAL.
        lv_car_rev_inf_min = lwa_rest_revest-revest_infer_min.
        lv_car_rev_inf_max = lwa_rest_revest-revest_infer_max.
        lv_car_rev_sup_min = lwa_rest_revest-revest_sup_min.
        lv_car_rev_sup_max = lwa_rest_revest-revest_sup_max.
        lv_car_rev_tot_min = lwa_rest_revest-revest_tot_min.
        lv_car_rev_tot_max = lwa_rest_revest-revest_tot_max.
      ELSE.
        lv_log = 'Falha na busca das Tols. de Revest - CT02'.
        lv_erro_revestimento = 'X'.
      ENDIF.
    ENDIF.
  ENDIF.

  IF lv_erro_revestimento = 'X'.
    p_matches = ''.
    MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
    wa_result-werks_apl = p_werks.
    wa_result-matnr_apl = p_matnr.
    CONCATENATE 'Revestimento >>' lv_log INTO wa_result-log SEPARATED BY space.
    APPEND wa_result TO it_result.
    CLEAR wa_result.
  ELSE.
* 1. SD_REVESTIMENTO_INFERIOR
    IF lv_laminacao_nova EQ 'EG'.
      CLEAR lwa_caract_charg.
      READ TABLE it_caract_charg WITH KEY matnr = p_wa_mchbcar-matnr
                                          charg = p_wa_mchbcar-charg
                                          atnam = 'SD_REVESTIMENTO_INFERIOR'
                                          BINARY SEARCH
                                          INTO lwa_caract_charg TRANSPORTING atwrt.
      CONDENSE lwa_caract_charg-atwrt.
      REPLACE ',' WITH '.' INTO lwa_caract_charg-atwrt.
      MOVE lwa_caract_charg-atwrt TO lv_charg_revestimento_inferior.

      IF lv_car_rev_inf_min IS NOT INITIAL AND
         lv_car_rev_inf_max IS INITIAL.
        lv_car_rev_inf_max = '999'.
      ENDIF.

      IF lv_car_rev_inf_min IS NOT INITIAL OR
         lv_car_rev_inf_max IS NOT INITIAL.
        IF lv_charg_revestimento_inferior LT lv_car_rev_inf_min OR
           lv_charg_revestimento_inferior GT lv_car_rev_inf_max.
          CONCATENATE 'REVESTIMENTO INFERIOR' 'fora dos limites de Tol.' INTO lv_log SEPARATED BY space.
          p_matches = ''.
          MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
          wa_result-werks_apl = p_werks.
          wa_result-matnr_apl = p_matnr.
          CONCATENATE 'Revestimento >>' lv_log INTO wa_result-log SEPARATED BY space.
          APPEND wa_result TO it_result.
          CLEAR wa_result.
        ENDIF.
      ENDIF.
    ENDIF.

* 2. SD_REVESTIMENTO_SUPERIOR
    IF lv_laminacao_nova EQ 'EG'.
      CLEAR lwa_caract_charg.
      READ TABLE it_caract_charg WITH KEY matnr = p_wa_mchbcar-matnr
                                          charg = p_wa_mchbcar-charg
                                          atnam = 'SD_REVESTIMENTO_SUPERIOR'
                                          BINARY SEARCH
                                          INTO lwa_caract_charg TRANSPORTING atwrt.
      CONDENSE lwa_caract_charg-atwrt.
      REPLACE ',' WITH '.' INTO lwa_caract_charg-atwrt.
      MOVE lwa_caract_charg-atwrt TO lv_charg_revestimento_superior.

      IF lv_car_rev_sup_min IS NOT INITIAL AND
         lv_car_rev_sup_max IS INITIAL.
        lv_car_rev_sup_max = '999'.
      ENDIF.

      IF lv_car_rev_sup_min IS NOT INITIAL OR
         lv_car_rev_sup_max IS NOT INITIAL.
        IF lv_charg_revestimento_superior LT lv_car_rev_sup_min OR
           lv_charg_revestimento_superior GT lv_car_rev_sup_max.
          CONCATENATE 'REVESTIMENTO SUPERIOR' 'fora dos limites de Tol.' INTO lv_log SEPARATED BY space.
          p_matches = ''.
          MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
          wa_result-werks_apl = p_werks.
          wa_result-matnr_apl = p_matnr.
          CONCATENATE 'Revestimento >>' lv_log INTO wa_result-log SEPARATED BY space.
          APPEND wa_result TO it_result.
          CLEAR wa_result.
        ENDIF.
      ENDIF.
    ENDIF.

*3. MM_REVESTIMENTO_TOTAL
    IF lv_laminacao_nova EQ 'ZN'.
*** caso não tenha informação de revestimento total e tenha informação nos revestimentos inferiores e superiores,
*** considerar a somatoria desses revestimentos como consistencia no revestimento total
      CLEAR lwa_caract_charg.
      READ TABLE it_caract_charg WITH KEY matnr = p_wa_mchbcar-matnr
                                          charg = p_wa_mchbcar-charg
                                          atnam = 'MM_REVESTIMENTO_TOTAL'
                                          BINARY SEARCH
                                          INTO lwa_caract_charg TRANSPORTING atwrt.
      CONDENSE lwa_caract_charg-atwrt.
      REPLACE ',' WITH '.' INTO lwa_caract_charg-atwrt.
      MOVE lwa_caract_charg-atwrt TO lv_charg_revestimento_total.

      IF lv_car_rev_tot_min IS INITIAL.
        lv_car_rev_tot_min = lv_car_rev_inf_min + lv_car_rev_sup_min.
      ENDIF.

      IF lv_car_rev_tot_max IS INITIAL.
        IF lv_car_rev_inf_max IS NOT INITIAL OR
           lv_car_rev_sup_max IS NOT INITIAL.
          IF lv_car_rev_inf_max = '999' OR
             lv_car_rev_sup_max = '999'.
            lv_car_rev_tot_max = '999'.
          ELSE.
            lv_car_rev_tot_max = lv_car_rev_inf_max + lv_car_rev_sup_max.
          ENDIF.
        ENDIF.
      ENDIF.

      IF lv_car_rev_tot_min IS NOT INITIAL AND
        lv_car_rev_tot_max IS INITIAL.
        lv_car_rev_tot_max = '999'.
      ENDIF.
      IF lv_car_rev_tot_min IS NOT INITIAL OR
         lv_car_rev_tot_max IS NOT INITIAL.
        IF lv_charg_revestimento_total LT lv_car_rev_tot_min OR
           lv_charg_revestimento_total GT lv_car_rev_tot_max.
          CONCATENATE 'REVESTIMENTO TOTAL' 'fora dos limites de Tol.' INTO lv_log SEPARATED BY space.
          p_matches = ''.
          MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
          wa_result-werks_apl = p_werks.
          wa_result-matnr_apl = p_matnr.
          CONCATENATE 'Revestimento >>' lv_log INTO wa_result-log SEPARATED BY space.
          APPEND wa_result TO it_result.
          CLEAR wa_result.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.
  FREE: lit_pn, lit_caract_ma.
ENDFORM.                    " F_CONSISTE_REVESTIMENTO
*&---------------------------------------------------------------------*
*&      Form  F_CONSISTE_SUPERFICIE
*&---------------------------------------------------------------------*
FORM f_consiste_superficie  USING p_werks TYPE marc-werks
                                  p_matnr
                                  p_wa_mchbcar LIKE wa_mchbcar
                         CHANGING p_matches.
  DATA: lit_caract_ma TYPE TABLE OF zrnmme_poa_caract_ma,
        lit_caract_mp TYPE TABLE OF zrnmme_poa_caract_lo.

  DATA lwa_caract_matnr LIKE LINE OF it_caract_matnr.

  DATA lv_laminacao TYPE atwrt.

  CLEAR lwa_caract_matnr.
  READ TABLE it_caract_matnr WITH KEY matnr = p_matnr
                                      atnam = 'HIERARQ_04 '
                                      BINARY SEARCH
                                      INTO lwa_caract_matnr .

  lv_laminacao = lwa_caract_matnr-atwrt.

  DATA lv_consistencia TYPE char03.
  CALL FUNCTION 'ZPPF_CONSISTE_SUPERFICIE'
    EXPORTING
      i_matnr_mp     = p_wa_mchbcar-matnr
      i_matnr_pa     = p_matnr
      i_laminacao    = lv_laminacao
      i_charg        = p_wa_mchbcar-charg
    IMPORTING
      e_consistencia = lv_consistencia
    TABLES
      it_caract_mp   = lit_caract_mp
      it_caract_pa   = lit_caract_ma.

  IF lv_consistencia = 'NAO'.
    CLEAR p_matches.

    MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
    wa_result-werks_apl = p_werks.
    wa_result-matnr_apl = p_matnr.
    CONCATENATE 'Superficie' '>> Lote:' p_wa_mchbcar-charg 'SKU:' p_matnr  INTO wa_result-log SEPARATED BY space.
    APPEND wa_result TO it_result.
    CLEAR wa_result.
  ELSE.
    p_matches = 'S'.
  ENDIF.
ENDFORM.
