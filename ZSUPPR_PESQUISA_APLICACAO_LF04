FORM f_analise_financeira  CHANGING p_wa_outtab TYPE ty_outtab.
  DATA: lt_margfin_in TYPE zsusde_margfin_in_t,
        ls_margfin_in TYPE zsusde_margfin_in,
        lt_margfin_ou TYPE zsusde_margfin_ou_t,
        ls_margfin_ou TYPE zsusde_margfin_ou.

  CLEAR: lt_margfin_in[], ls_margfin_in, lt_margfin_ou[], ls_margfin_ou.

  IF wa_outtab-xloek EQ 'E'.
    ls_margfin_in-capabil   = 'NOK'.
  ELSEIF wa_outtab-xloek EQ 'C'.
    ls_margfin_in-capabil   = 'NOK'.
  ELSEIF wa_outtab-xloek EQ 'R'.
    ls_margfin_in-capabil   = 'NOK'.
  ELSEIF wa_outtab-xloek EQ 'A'.
    ls_margfin_in-capabil   = 'OK'.
  ELSEIF wa_outtab-xloek EQ 'M'.
    ls_margfin_in-capabil   = 'OK'.
  ELSEIF wa_outtab-xloek EQ 'P'.
    ls_margfin_in-capabil   = 'OK'.
  ELSEIF wa_outtab-xloek EQ 'T'.
    ls_margfin_in-capabil   = 'OK'.
  ELSEIF wa_outtab-xloek EQ 'X'.
    ls_margfin_in-capabil   = 'OK'.
  ELSE.
    ls_margfin_in-capabil   = 'OK'.
  ENDIF.

  READ TABLE it_zrnppt_prev_capa INTO DATA(ls_zrnppt_prev_capa) WITH KEY werks = p_wa_outtab-werks_apl
                                                                         matnr = p_wa_outtab-matnr_apl BINARY SEARCH.
  IF sy-subrc EQ 0.
    ls_margfin_in-pesokg = ls_zrnppt_prev_capa-peso_peca.
  ENDIF.

  ls_margfin_in-werks     = p_wa_outtab-werks.
  ls_margfin_in-lgort     = p_wa_outtab-lgort.
  ls_margfin_in-matnr     = p_wa_outtab-matnr.
  ls_margfin_in-charg     = p_wa_outtab-charg.
  ls_margfin_in-clabs     = p_wa_outtab-clabs.
  ls_margfin_in-werks_apl = p_wa_outtab-werks_apl.
  ls_margfin_in-matnr_apl = p_wa_outtab-matnr_apl.
  ls_margfin_in-idnrk_apl = p_wa_outtab-idnrk_apl.
  APPEND ls_margfin_in TO lt_margfin_in.

  CALL FUNCTION 'ZSUPPF_MATALT_FINANCEIRO'
    EXPORTING
      margfin_in = lt_margfin_in
    IMPORTING
      margfin_ou = lt_margfin_ou.

  READ TABLE it_result_nok TRANSPORTING NO FIELDS WITH KEY matnr     = p_wa_outtab-matnr
                                                           charg     = p_wa_outtab-charg
                                                           matnr_apl = p_wa_outtab-matnr_apl BINARY SEARCH.
  IF sy-subrc EQ 0.
    p_wa_outtab-capabil = 'NOK'.
  ELSE.
    p_wa_outtab-capabil = ls_margfin_in-capabil.
  ENDIF.

  READ TABLE lt_margfin_ou INTO ls_margfin_ou INDEX 1.
  IF sy-subrc EQ 0.
    p_wa_outtab-zicm_mp_ent    = ls_margfin_ou-zicm_mp_ent.
    p_wa_outtab-zicm_pa_vend   = ls_margfin_ou-zicm_pa_vend.
    p_wa_outtab-zrecolh_gov    = ls_margfin_ou-zrecolh_gov.
    p_wa_outtab-zreceita_if    = ls_margfin_ou-zreceita_if.
    p_wa_outtab-vbeln_ref      = ls_margfin_ou-vbeln_ref.
    p_wa_outtab-zpreco_mp      = ls_margfin_ou-zpreco_mp.
    p_wa_outtab-zpreco_mp_alt  = ls_margfin_ou-zpreco_mp_alt.
    p_wa_outtab-zdelta_mp_pr   = ls_margfin_ou-zdelta_mp_pr.
    p_wa_outtab-zcust_frete_ov = ls_margfin_ou-zcust_frete_ov.
    p_wa_outtab-zperc_permeta  = ls_margfin_ou-zperc_permeta.
    p_wa_outtab-zvl_permeta    = ls_margfin_ou-zvl_permeta.
    p_wa_outtab-zcust_tot      = ls_margfin_ou-zcust_tot.
    p_wa_outtab-zimpac_tot     = ls_margfin_ou-zimpac_tot.
    p_wa_outtab-zpeso_mp_alt   = ls_margfin_ou-zpeso_mp_alt.
    p_wa_outtab-zimpac_mp_tot  = ls_margfin_ou-zimpac_mp_tot.
    p_wa_outtab-zval_mp_alter  = ls_margfin_ou-zval_mp_alter.
    p_wa_outtab-zdem_vig       = ls_margfin_ou-zdem_vig.
    p_wa_outtab-ztmp_estoq     = ls_margfin_ou-ztmp_estoq.
    p_wa_outtab-zdesp_finan    = ls_margfin_ou-zdesp_finan.
    p_wa_outtab-zbenefic       = ls_margfin_ou-zbenefic.
  ENDIF.
