*&---------------------------------------------------------------------*
*&      Form  F_GET_STOCK_LGORT
*&---------------------------------------------------------------------*
FORM f_get_stock_lgort  USING    p_charg
                                 p_matnr
                                 p_werks
                        CHANGING p_lgort.
  DATA: doc_id   TYPE mblnr,
        rowcount TYPE i.

  SELECT mkpf~mblnr lgort
  FROM mseg
  INNER JOIN mkpf
  ON mkpf~mblnr = mseg~mblnr
  AND mkpf~mjahr = mseg~mjahr
  INTO (doc_id, p_lgort)
  WHERE ( mseg~bwart = '101'
     OR mseg~bwart = '105'
     OR mseg~bwart = '913'
     OR mseg~bwart = '911'
     OR mseg~bwart = '309'
     OR mseg~bwart = '311'
     OR mseg~bwart = '861' )
    AND mseg~matnr = p_matnr
    AND mseg~werks = p_werks
    AND mseg~charg = p_charg
    AND mseg~shkzg = 'S'
  ORDER BY mkpf~cpudt DESCENDING mkpf~cputm DESCENDING.
    SELECT SINGLE COUNT(*)
    FROM mseg
    INTO rowcount
    WHERE mseg~smbln = doc_id.
    IF rowcount = 0.
      EXIT.
    ENDIF.
  ENDSELECT.
ENDFORM.                    " F_GET_STOCK_LGORT
