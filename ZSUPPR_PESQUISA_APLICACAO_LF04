*&      Form  F_ATUALIZA_SALDO_ESTOQUES
*&---------------------------------------------------------------------*
FORM f_atualiza_saldo_estoques .
  DATA lv_bdmng TYPE resb-bdmng.

  FIELD-SYMBOLS <fs_mchbcar> TYPE zrnsdt_mchbcar.

  SORT it_pajt_sol_mp BY matnr charg.

  IF it_mchbcar IS NOT INITIAL.
    SELECT *
      FROM zppt_oest
      INTO TABLE @DATA(tl_oest)
       FOR ALL ENTRIES IN @it_mchbcar
     WHERE matnr EQ @it_mchbcar-matnr
       AND charg EQ @it_mchbcar-charg.
    SORT tl_oest BY werks matnr charg clabs.
    DELETE ADJACENT DUPLICATES FROM tl_oest COMPARING werks matnr charg clabs.
    SORT it_resb_aux BY matnr charg baugr bwart.
  ENDIF.
  SORT it_resb_bext BY matnr charg.

  LOOP AT it_mchbcar ASSIGNING <fs_mchbcar>.
    CLEAR lv_bdmng.
    SELECT SUM( clabs )
      INTO @DATA(lv_clabs)
      FROM mchb
     WHERE matnr EQ @<fs_mchbcar>-matnr
       AND charg EQ @<fs_mchbcar>-charg
       AND clabs GT 0.
    IF lv_clabs IS INITIAL.
      CLEAR <fs_mchbcar>.
    ENDIF.

    LOOP AT it_resb_aux INTO DATA(wl_resb) WHERE matnr EQ <fs_mchbcar>-matnr
                                             AND charg EQ <fs_mchbcar>-charg
                                             AND bwart IS NOT INITIAL.
      lv_bdmng = ( wl_resb-bdmng - wl_resb-enmng ) + lv_bdmng.
    ENDLOOP.

    LOOP AT tl_oest INTO DATA(wl_oest) WHERE matnr EQ <fs_mchbcar>-matnr
                                         AND charg EQ <fs_mchbcar>-charg.
      lv_bdmng = wl_oest-clabs - lv_bdmng.
    ENDLOOP.

    <fs_mchbcar>-clabs = lv_clabs - lv_bdmng.

    IF <fs_mchbcar>-clabs LE 0.
      <fs_mchbcar>-clabs = 0.
    ENDIF.
    READ TABLE it_resb_bext INTO wa_resb WITH KEY matnr = <fs_mchbcar>-matnr
                                                  charg = <fs_mchbcar>-charg
                                                  BINARY SEARCH.
    IF sy-subrc IS INITIAL.
      <fs_mchbcar>-clabs = 0.
    ENDIF.
  ENDLOOP.

  DELETE it_mchbcar WHERE matnr IS INITIAL.
ENDFORM.
