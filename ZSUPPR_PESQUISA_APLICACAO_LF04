*&      Form  F_HANDLE_HOTSPOT_CLICK
*&---------------------------------------------------------------------*
FORM f_handle_hotspot_click  USING    p_e_column_id
                                      p_es_row_no_row_id
                                      p_sender.
  DATA: lit_param TYPE TABLE OF rfc_spagpa,
        lwa       LIKE LINE OF lit_param.

  CASE p_sender.
    WHEN gr_table1.
      READ TABLE gt_outtab1 INTO wa_outtab INDEX p_es_row_no_row_id.
    WHEN gr_table2.
      READ TABLE gt_outtab2 INTO wa_outtab INDEX p_es_row_no_row_id.
  ENDCASE.

  CASE p_e_column_id.
    WHEN 'MATNR'.
      IF wa_outtab-matnr IS NOT INITIAL.
        IF g_tab_appl-subscreen NE '0202'.
          SET PARAMETER ID 'MAT' FIELD wa_outtab-matnr.
          SET PARAMETER ID 'WRK' FIELD wa_outtab-werks.
          SET PARAMETER ID 'CHA' FIELD ''.
          CALL TRANSACTION 'MMBE'.
        ELSE.
          CLEAR lit_param[].
          lwa-parid = 'MAT'.
          lwa-parval = wa_outtab-matnr.
          APPEND lwa TO lit_param.

          CALL FUNCTION 'ABAP4_CALL_TRANSACTION' STARTING NEW TASK 'MM02'
            EXPORTING
              tcode                   = 'MM02'
              skip_screen             = 'X'
            TABLES
              spagpa_tab              = lit_param
            EXCEPTIONS
              call_transaction_denied = 1
              tcode_invalid           = 2
              OTHERS                  = 3.
          IF sy-subrc <> 0.
            MESSAGE 'Não foi possível abrir a transação MM02!' TYPE 'S'.
          ENDIF.
        ENDIF.
      ENDIF.
    WHEN 'CHARG'.
      IF wa_outtab-charg IS NOT INITIAL.
        SET PARAMETER ID 'WRK' FIELD wa_outtab-werks.
        SET PARAMETER ID 'MAT' FIELD wa_outtab-matnr.
        SET PARAMETER ID 'CHA' FIELD wa_outtab-charg.
        IF g_tab_appl-subscreen NE '0202'.
          CALL TRANSACTION 'MSC3N' AND SKIP FIRST SCREEN.
        ELSE.
          CLEAR lit_param[].
          lwa-parid = 'WRK'.
          lwa-parval = wa_outtab-werks.
          APPEND lwa TO lit_param.

          lwa-parid = 'MAT'.
          lwa-parval = wa_outtab-matnr.
          APPEND lwa TO lit_param.

          lwa-parid = 'CHA'.
          lwa-parval = wa_outtab-charg.
          APPEND lwa TO lit_param.

          CALL FUNCTION 'ABAP4_CALL_TRANSACTION' STARTING NEW TASK 'MSC2N'
            EXPORTING
              tcode                   = 'MSC2N'
              skip_screen             = 'X'
            TABLES
              spagpa_tab              = lit_param
            EXCEPTIONS
              call_transaction_denied = 1
              tcode_invalid           = 2
              OTHERS                  = 3.
          IF sy-subrc <> 0.
            MESSAGE 'Não foi possível abrir a transação MSC2N!' TYPE 'S'.
          ENDIF.
        ENDIF.
      ENDIF.
    WHEN 'MATNR_APL'.
      IF wa_outtab-matnr_apl IS NOT INITIAL.
        IF g_tab_appl-subscreen NE '0202'.
          SET PARAMETER ID 'MAT' FIELD wa_outtab-matnr_apl.
          SET PARAMETER ID 'WRK' FIELD wa_outtab-werks_apl.
          SET PARAMETER ID 'CHA' FIELD ''.
          CALL TRANSACTION 'MMBE'.
        ELSE.
          CLEAR lit_param[].
          lwa-parid = 'MAT'.
          lwa-parval = wa_outtab-matnr_apl.
          APPEND lwa TO lit_param.

          CALL FUNCTION 'ABAP4_CALL_TRANSACTION' STARTING NEW TASK 'MM02'
            EXPORTING
              tcode                   = 'MM02'
              skip_screen             = 'X'
            TABLES
              spagpa_tab              = lit_param
            EXCEPTIONS
              call_transaction_denied = 1
              tcode_invalid           = 2
              OTHERS                  = 3.
          IF sy-subrc <> 0.
            MESSAGE 'Não foi possível abrir a transação MM02!' TYPE 'S'.
          ENDIF.
        ENDIF.
      ENDIF.
    WHEN 'IDNRK_APL'.
      IF wa_outtab-matnr IS NOT INITIAL.
        IF g_tab_appl-subscreen NE '0202'.
          SET PARAMETER ID 'MAT' FIELD wa_outtab-idnrk_apl.
          SET PARAMETER ID 'WRK' FIELD wa_outtab-werks.
          SET PARAMETER ID 'CHA' FIELD ''.
          CALL TRANSACTION 'MMBE'.
        ELSE.
          CLEAR lit_param[].
          lwa-parid = 'MAT'.
          lwa-parval = wa_outtab-idnrk_apl.
          APPEND lwa TO lit_param.

          CALL FUNCTION 'ABAP4_CALL_TRANSACTION' STARTING NEW TASK 'MM02'
            EXPORTING
              tcode                   = 'MM02'
              skip_screen             = 'X'
            TABLES
              spagpa_tab              = lit_param
            EXCEPTIONS
              call_transaction_denied = 1
              tcode_invalid           = 2
              OTHERS                  = 3.
          IF sy-subrc <> 0.
            MESSAGE 'Não foi possível abrir a transação MM02!' TYPE 'S'.
          ENDIF.
        ENDIF.
      ENDIF.
    WHEN 'CLABS'.
      PERFORM f_exibe_mm_acompanhamento.
  ENDCASE.
