      <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
      <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
      <fs_caract_charg>-atnam = 'SD_SUPERFICIE'.
      <fs_caract_charg>-atwtb = <fs_zppt_mchb_caract>-sd_superficie.

      "HIERARQ_04
      INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
      <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
      <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
      <fs_caract_charg>-atnam = 'HIERARQ_04'.
      <fs_caract_charg>-atwtb = <fs_zppt_mchb_caract>-hierarq_04.

