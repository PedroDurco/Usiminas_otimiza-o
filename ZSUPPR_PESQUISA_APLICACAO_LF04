*&      Form  PROCESSA_ESTOQUE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM processa_estoque .

  DATA lit_mchbcar TYPE TABLE OF zrnsdt_mchbcar.
  DATA lv_data_estoque TYPE sy-datum.
  FIELD-SYMBOLS: <fs_mslb>    TYPE mslb,
                 <fs_mchbcar> TYPE zrnsdt_mchbcar.

  cl_progress_indicator=>progress_indicate( i_text = 'Processando os Estoques...'
                                            i_output_immediately = abap_true ).

  REFRESH:  it_mchbcar,
            it_mslb,
            it_lista_alt,
            it_pajt_sol_mp.

*  SELECT matnr werks lgort charg espessura largura clabs
*    INTO CORRESPONDING FIELDS OF TABLE it_mchbcar
*    FROM zrnsdt_mchbcar
*    WHERE charg IN s_charg
*      AND werks IN s_ewrks       "12/05/2026 - Nic-Labs - Filtro Centro Estoque
*      AND lgort IN s_elgrt       "12/05/2026 - Nic-Labs - Filtro Depósito Estoque
*      AND clabs GE gv_estoque_minimo.
*
*  "estoque especial
*  SELECT matnr werks charg sobkz lifnr lblab
*    INTO CORRESPONDING FIELDS OF TABLE it_mslb
*    FROM mslb
*   WHERE charg IN s_charg
*     AND werks IN s_ewrks       "12/05/2026 - Nic-Labs - Filtro Centro Estoque
*     AND lblab GE gv_estoque_minimo.
*  IF sy-subrc IS INITIAL.
*    LOOP AT it_mslb ASSIGNING <fs_mslb>.
*      MOVE-CORRESPONDING <fs_mslb> TO wa_mchbcar.
*      MOVE <fs_mslb>-lblab TO wa_mchbcar-clabs.
*      PERFORM f_get_stock_lgort USING wa_mchbcar-charg wa_mchbcar-matnr wa_mchbcar-werks
*                                CHANGING wa_mchbcar-lgort.
*      APPEND wa_mchbcar TO it_mchbcar.
*    ENDLOOP.
*  ENDIF.
*
*  DELETE it_mchbcar WHERE matnr NOT BETWEEN '12000000' AND '12999999' AND
*                          matnr NOT BETWEEN '54000000' AND '54999999' AND
*                          matnr NOT BETWEEN '34000000' AND '34999999' AND
*                          matnr NOT BETWEEN '10000000' AND '11999999' AND "RDM 271193
*                          matnr NOT BETWEEN '50000000' AND '59999999' AND "RDM 271193
*                          matnr NOT BETWEEN '71000000' AND '71999999'. "RDM 271193
*
*  "Registro do otimizador que está pendente de aprovação não é relevante para aplicação e consulta
*  SELECT *
*    FROM zppt_oest
*    INTO TABLE @DATA(tl_oest)
*   WHERE cprog EQ 'ZPPR_PROCESSA_NECESSIDADE_MP'.
*  IF sy-subrc EQ 0.
*    SORT tl_oest BY matnr charg.
*    DELETE ADJACENT DUPLICATES FROM tl_oest COMPARING matnr charg.
*    LOOP AT tl_oest INTO DATA(wl_oest).
*      DELETE it_mchbcar WHERE matnr EQ wl_oest-matnr
*                          AND charg EQ wl_oest-charg.
*    ENDLOOP.
*  ENDIF.
*
*  "Regra para ESTOQUE ACABADOU OU SEMI-ACABADO:
*  "considerar somente lotes estocados a mais de 90 dias.
*  lit_mchbcar[] = it_mchbcar[].
*  DELETE lit_mchbcar WHERE matnr BETWEEN '12000000' AND '12999999' AND
*                           matnr BETWEEN '10000000' AND '11999999' AND "RDM 271193
*                           matnr BETWEEN '71000000' AND '71999999'. "RDM 271193
*
*  IF lit_mchbcar[] IS NOT INITIAL.
*    lv_data_estoque = sy-datum - 90.
*    LOOP AT lit_mchbcar ASSIGNING <fs_mchbcar>.
*      IF <fs_mchbcar>-ersda > lv_data_estoque.
*        DELETE it_mchbcar WHERE matnr EQ <fs_mchbcar>-matnr AND
*                                charg EQ <fs_mchbcar>-charg.
*      ENDIF.
*    ENDLOOP.
*  ENDIF.

  IF it_mchbcar[] IS NOT INITIAL.
    SELECT *
      INTO TABLE it_lista_alt
      FROM zsuppt_lista_alt
      FOR ALL ENTRIES IN it_mchbcar
      WHERE matnr       EQ it_mchbcar-matnr
        AND charg       EQ it_mchbcar-charg
        AND desativada  EQ ''.

    SELECT *
      INTO TABLE it_pajt_sol_mp
      FROM zppt_pajt
      FOR ALL ENTRIES IN it_mchbcar
      WHERE cprog       NE 'ZPPR_PROCESSA_NECESSIDADE_MP'
        AND matnr       EQ it_mchbcar-matnr
        AND charg       EQ it_mchbcar-charg.

    SORT it_pajt_sol_mp BY cprog ernam matnr charg clabs.
    DELETE ADJACENT DUPLICATES FROM it_pajt_sol_mp COMPARING cprog ernam matnr charg clabs.
  ENDIF.

  FREE lit_mchbcar.

ENDFORM.

*&---------------------------------------------------------------------*
*&      Form  F_PROCESSA_ESTOQUE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM f_processa_aplicacao .

  DATA:
    lv_cont      TYPE i,
    lv_cont_task TYPE i,
    lv_taskname  TYPE string,
    lv_bg_seq    TYPE i,
    lv_bg_task   TYPE string,
    lv_bg_prog   TYPE sy-repid VALUE 'ZSUPPR_PESQ_APL_BG_WRP',
    lv_bg_key    TYPE c LENGTH 60,
    lv_jobname   TYPE tbtcjob-jobname,
    lv_jobcount  TYPE tbtcjob-jobcount,
    lv_msg       TYPE string.

  DATA:
    lt_marc TYPE ztt_marc_lotes.

  LOOP AT it_marc ASSIGNING FIELD-SYMBOL(<fs_marc>).

    ADD 1 TO lv_cont.

    APPEND <fs_marc> TO lt_marc.

    IF lv_cont EQ p_qtdest.

      DO 3 TIMES.
        WAIT UP TO 5 SECONDS.
      ENDDO.

      IF sy-batch IS INITIAL.

        ADD 1  TO lv_cont_task.
        lv_taskname = |TASK_{ lv_cont_task }|.

        DO.
          CALL FUNCTION 'ZPPF_PROCESSA_PACOTES_LOTE'
            STARTING NEW TASK lv_taskname
            DESTINATION IN GROUP DEFAULT
            PERFORMING f_rfc_callback ON END OF TASK
            EXPORTING
              i_su                  = r_su
              i_usi                 = r_usi
              i_ambos               = r_ambos
              i_max_ln              = p_max_ln
              i_gd                  = p_gd
              i_rest                = p_rest
              i_task                = abap_true
            TABLES
              s_charg               = s_charg
              s_ewrks               = s_ewrks
              s_elgrt               = s_elgrt
              s_werks               = s_werks
              s_matnr               = s_matnr
              t_marc                = lt_marc
              t_zrnppt_prev         = it_zrnppt_prev
            EXCEPTIONS
              communication_failure = 1
              system_failure        = 2
              resource_failure      = 3.

          IF sy-subrc = 3.
            "Sem recurso disponível — aguarda e refaz a mesma chamada
            WAIT FOR ASYNCHRONOUS TASKS UNTIL gv_running LT p_task.
            CONTINUE.
          ENDIF.

          EXIT.
        ENDDO.

        IF sy-subrc = 0.
          ADD 1 TO gv_running.
        ENDIF.

      ELSE.
        ADD 1 TO lv_bg_seq.
        lv_jobname = |BG_{ sy-datum }_{ sy-uzeit }_{ lv_bg_seq }|.
        lv_bg_key  = |BG_{ sy-datum }{ sy-uzeit }_{ lv_bg_seq }|.

        EXPORT r_su          = r_su
               r_usi         = r_usi
               r_ambos       = r_ambos
               p_max_ln      = p_max_ln
               p_gd          = p_gd
               p_rest        = p_rest
               s_charg       = s_charg[]
               s_ewrks       = s_ewrks[]
               s_elgrt       = s_elgrt[]
               s_werks       = s_werks[]
               s_matnr       = s_matnr[]
               t_marc        = lt_marc[]
               t_zrnppt_prev = it_zrnppt_prev[]
          TO DATABASE indx(zp) ID lv_bg_key.

        IF sy-subrc <> 0.
          lv_msg = |[BG-JOB PAYLOAD ERRO] Key={ lv_bg_key } Subrc={ sy-subrc }|.
          PERFORM f_log_exec USING lv_msg.
          CONTINUE.
        ENDIF.

        CALL FUNCTION 'JOB_OPEN'
          EXPORTING
            jobname          = lv_jobname
          IMPORTING
            jobcount         = lv_jobcount
          EXCEPTIONS
            cant_create_job  = 1
            invalid_job_data = 2
            jobname_missing  = 3
            OTHERS           = 4.

        IF sy-subrc = 0.
          SUBMIT (lv_bg_prog)
            WITH p_key = lv_bg_key
            VIA JOB lv_jobname NUMBER lv_jobcount
            AND RETURN.

          IF sy-subrc = 0.
            CALL FUNCTION 'JOB_CLOSE'
              EXPORTING
                jobname              = lv_jobname
                jobcount             = lv_jobcount
                strtimmed            = 'X'
              EXCEPTIONS
                cant_start_immediate = 1
                invalid_startdate    = 2
                jobname_missing      = 3
                job_close_failed     = 4
                job_nosteps          = 5
                job_notex            = 6
                lock_failed          = 7
                OTHERS               = 8.

            IF sy-subrc = 0.
              lv_msg = |[BG-JOB ABERTO] Job={ lv_jobname }/{ lv_jobcount }|.
              PERFORM f_log_exec USING lv_msg.
            ELSE.
              lv_msg = |[BG-JOB CLOSE ERRO] Job={ lv_jobname }/{ lv_jobcount } Subrc={ sy-subrc }|.
              PERFORM f_log_exec USING lv_msg.
            ENDIF.
          ELSE.
            lv_msg = |[BG-JOB SUBMIT ERRO] Job={ lv_jobname }/{ lv_jobcount } Prog={ lv_bg_prog } Subrc={ sy-subrc }|.
            PERFORM f_log_exec USING lv_msg.
          ENDIF.
        ELSE.
          lv_msg = |[BG-JOB OPEN ERRO] Job={ lv_jobname } Subrc={ sy-subrc }|.
          PERFORM f_log_exec USING lv_msg.
        ENDIF.
      ENDIF.

      CLEAR lv_cont.
      FREE: lt_marc.

    ENDIF.

    AT LAST.

      DO 3 TIMES.
        WAIT UP TO 5 SECONDS.
      ENDDO.

      IF lt_marc[] IS NOT INITIAL.

        IF sy-batch IS INITIAL.

          ADD 1  TO lv_cont_task.
          lv_taskname = |TASK_{ lv_cont_task }|.

          DO.
            CALL FUNCTION 'ZPPF_PROCESSA_PACOTES_LOTE'
              STARTING NEW TASK lv_taskname
              DESTINATION IN GROUP DEFAULT
              PERFORMING f_rfc_callback ON END OF TASK
              EXPORTING
                i_su                  = r_su
                i_usi                 = r_usi
                i_ambos               = r_ambos
                i_max_ln              = p_max_ln
                i_gd                  = p_gd
                i_rest                = p_rest
                i_task                = abap_true
              TABLES
                s_charg               = s_charg
                s_ewrks               = s_ewrks
                s_elgrt               = s_elgrt
                s_werks               = s_werks
                s_matnr               = s_matnr
                t_marc                = lt_marc
                t_zrnppt_prev         = it_zrnppt_prev
              EXCEPTIONS
                communication_failure = 1
                system_failure        = 2
                resource_failure      = 3.

            IF sy-subrc = 3.
              "Sem recurso disponível — aguarda e refaz a mesma chamada
              WAIT FOR ASYNCHRONOUS TASKS UNTIL gv_running LT p_task.
              CONTINUE.
            ENDIF.

            EXIT.
          ENDDO.

          IF sy-subrc = 0.
            ADD 1 TO gv_running.
          ENDIF.

        ELSE.
          ADD 1 TO lv_bg_seq.
          lv_jobname = |BG_{ sy-datum }_{ sy-uzeit }_{ lv_bg_seq }|.
          lv_bg_key  = |BG_{ sy-datum }{ sy-uzeit }_{ lv_bg_seq }|.

          EXPORT r_su          = r_su
                 r_usi         = r_usi
                 r_ambos       = r_ambos
                 p_max_ln      = p_max_ln
                 p_gd          = p_gd
                 p_rest        = p_rest
                 s_charg       = s_charg[]
                 s_ewrks       = s_ewrks[]
                 s_elgrt       = s_elgrt[]
                 s_werks       = s_werks[]
                 s_matnr       = s_matnr[]
                 t_marc        = lt_marc[]
                 t_zrnppt_prev = it_zrnppt_prev[]
            TO DATABASE indx(zp) ID lv_bg_key.

          IF sy-subrc <> 0.
            lv_msg = |[BG-JOB PAYLOAD ERRO] Key={ lv_bg_key } Subrc={ sy-subrc }|.
            PERFORM f_log_exec USING lv_msg.
            CONTINUE.
          ENDIF.

          CALL FUNCTION 'JOB_OPEN'
            EXPORTING
              jobname          = lv_jobname
            IMPORTING
              jobcount         = lv_jobcount
            EXCEPTIONS
              cant_create_job  = 1
              invalid_job_data = 2
              jobname_missing  = 3
              OTHERS           = 4.

          IF sy-subrc = 0.
            SUBMIT (lv_bg_prog)
              WITH p_key = lv_bg_key
              VIA JOB lv_jobname NUMBER lv_jobcount
              AND RETURN.

            IF sy-subrc = 0.
              CALL FUNCTION 'JOB_CLOSE'
                EXPORTING
                  jobname              = lv_jobname
                  jobcount             = lv_jobcount
                  strtimmed            = 'X'
                EXCEPTIONS
                  cant_start_immediate = 1
                  invalid_startdate    = 2
                  jobname_missing      = 3
                  job_close_failed     = 4
                  job_nosteps          = 5
                  job_notex            = 6
                  lock_failed          = 7
                  OTHERS               = 8.

              IF sy-subrc = 0.
                lv_msg = |[BG-JOB ABERTO] Job={ lv_jobname }/{ lv_jobcount }|.
                PERFORM f_log_exec USING lv_msg.
              ELSE.
                lv_msg = |[BG-JOB CLOSE ERRO] Job={ lv_jobname }/{ lv_jobcount } Subrc={ sy-subrc }|.
                PERFORM f_log_exec USING lv_msg.
              ENDIF.
            ELSE.
              lv_msg = |[BG-JOB SUBMIT ERRO] Job={ lv_jobname }/{ lv_jobcount } Prog={ lv_bg_prog } Subrc={ sy-subrc }|.
              PERFORM f_log_exec USING lv_msg.
            ENDIF.
          ELSE.
            lv_msg = |[BG-JOB OPEN ERRO] Job={ lv_jobname } Subrc={ sy-subrc }|.
            PERFORM f_log_exec USING lv_msg.
          ENDIF.
        ENDIF.

        CLEAR lv_cont.
        FREE: lt_marc.

      ENDIF.

    ENDAT.

    IF gv_running GE p_task.
      WAIT FOR ASYNCHRONOUS TASKS UNTIL gv_running LT p_task.
    ENDIF.

  ENDLOOP.

  WAIT FOR ASYNCHRONOUS TASKS UNTIL gv_running EQ 0.

  CLEAR: lv_cont_task, lv_cont_task.
  FREE: lt_marc, it_mchbcar.

*  PERFORM f_adequa_tabelas_saida.


ENDFORM.

*&---------------------------------------------------------------------*
*&      Form  F_RFC_CALLBACK
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_rfc_callback USING taskname.

  DATA:
    lt_outtab1  TYPE ztt_pesquisa_aplicacao,
    lt_outtab2  TYPE ztt_pesquisa_aplicacao,
    lt_outtab3  TYPE ztt_pesquisa_aplicacao,
    lv_msg_comm TYPE c LENGTH 200,
    lv_msg_sys  TYPE c LENGTH 200,
    lv_before1  TYPE i,
    lv_before2  TYPE i,
    lv_before3  TYPE i,
    lv_msg      TYPE string.

  lv_before1 = lines( gt_outtab1 ).
  lv_before2 = lines( gt_outtab2 ).
  lv_before3 = lines( gt_outtab3 ).

  RECEIVE RESULTS FROM FUNCTION 'ZPPF_PROCESSA_PACOTES_LOTE'
    TABLES
      t_outtab1 = lt_outtab1
      t_outtab2 = lt_outtab2
      t_outtab3 = lt_outtab3
    EXCEPTIONS
      communication_failure = 1 MESSAGE lv_msg_comm
      system_failure        = 2 MESSAGE lv_msg_sys
      OTHERS                = 3.

  IF sy-subrc <> 0.
    IF sy-subrc = 1.
      lv_msg = |RFC Comm Error ({ taskname }): { lv_msg_comm }|.
      PERFORM f_log_exec USING lv_msg.
    ELSEIF sy-subrc = 2.
      lv_msg = |RFC System Error ({ taskname }): { lv_msg_sys }|.
      PERFORM f_log_exec USING lv_msg.
    ELSE.
      lv_msg = |RFC Error ({ taskname }): subrc={ sy-subrc }|.
      PERFORM f_log_exec USING lv_msg.
    ENDIF.
  ELSE.
    lv_msg = |RFC OK ({ taskname }): Out1={ lines( lt_outtab1 ) } Out2={ lines( lt_outtab2 ) } Out3={ lines( lt_outtab3 ) }|.
    PERFORM f_log_exec USING lv_msg.
  ENDIF.

  gv_running = gv_running - 1.

  APPEND LINES OF lt_outtab1 TO gt_outtab1.
  APPEND LINES OF lt_outtab2 TO gt_outtab2.
  APPEND LINES OF lt_outtab3 TO gt_outtab3.

  lv_msg = |RFC MERGE ({ taskname }): GT1 { lv_before1 }->{ lines( gt_outtab1 ) } GT2 { lv_before2 }->{ lines( gt_outtab2 ) } GT3 { lv_before3 }->{ lines( gt_outtab3 ) }|.
  PERFORM f_log_exec USING lv_msg.

  FREE: lt_outtab1, lt_outtab2, lt_outtab3.

ENDFORM.

*&---------------------------------------------------------------------*
*&      Form  F_LOG_EXEC
*&---------------------------------------------------------------------*
FORM f_log_exec USING iv_msg TYPE string.

  DATA: lv_jobname  TYPE tbtcjob-jobname,
        lv_jobcount TYPE tbtcjob-jobcount,
        lv_log      TYPE string.

  IF sy-batch = 'X'.
    CALL FUNCTION 'GET_JOB_RUNTIME_INFO'
      IMPORTING
        jobname         = lv_jobname
        jobcount        = lv_jobcount
      EXCEPTIONS
        no_runtime_info = 1
        OTHERS          = 2.

    IF sy-subrc = 0.
      lv_log = |[JOB { lv_jobname }/{ lv_jobcount }] { iv_msg }|.
    ELSE.
      lv_log = |[JOB N/A] { iv_msg }|.
    ENDIF.

    MESSAGE lv_log TYPE 'S'.
  ELSE.
    WRITE: / iv_msg.
  ENDIF.

ENDFORM.

