FORM f_rastrabilidade_oleo TABLES it_caract_matnr STRUCTURE zrnmme_poa_caract_ma
                            USING lwa_rastreabilidade TYPE ty_rastreabilidade
                                  p_wa_mchbcar LIKE wa_mchbcar
                                  p_matnr
                                  p_werks
                         CHANGING lwa_caract_matnr TYPE zrnmme_poa_caract_ma
                                  p_matches
                                  lv_matches.
  DATA: BEGIN OF t_itab_lot OCCURS 1.
          INCLUDE STRUCTURE zrnmme_poa_caract_lo.
        DATA: END OF t_itab_lot.

  READ TABLE it_caract_matnr WITH KEY matnr = p_matnr
                                          atnam = 'MM_OLEAMENTO'
                                          INTO lwa_caract_matnr TRANSPORTING atwrt.

  IF sy-subrc EQ 0.
    DATA(lv_matnr_oleamento_acabado) =  lwa_caract_matnr-atwrt.
  ELSE.
    lv_matnr_oleamento_acabado = space.
  ENDIF.

** Nivel oleamento
*  READ TABLE it_caract_matnr WITH KEY matnr = p_matnr
*                                      atnam = 'MM_NIVEL_OLEAMENTO'
*                                      INTO lwa_caract_matnr TRANSPORTING atwrt.
*
*  IF sy-subrc EQ 0.
*    DATA(lv_matnr_nivel_oleo_acabado) =  lwa_caract_matnr-atwrt.
*  ELSE.
*    lv_matnr_nivel_oleo_acabado = space.
*  ENDIF.

* Peça segurança
  READ TABLE it_caract_matnr WITH KEY matnr = p_matnr
                                      atnam = 'MM_PECA_SEGURANCA'
       INTO lwa_caract_matnr TRANSPORTING atwrt.

  IF sy-subrc EQ 0.
    DATA(lv_matnr_peca_acabado) =  lwa_caract_matnr-atwrt.
  ELSE.
    lv_matnr_peca_acabado = space.
  ENDIF.

  REFRESH: t_itab_lot.

  CALL FUNCTION 'ZRNMMF_SEARCH_CLOT'
    EXPORTING
      matnr    = lwa_rastreabilidade-matnr
      klart    = '023'
      charg    = lwa_rastreabilidade-charg
      idioma   = sy-langu
    TABLES
      itab_lot = t_itab_lot.

  READ TABLE t_itab_lot WITH KEY atnam = 'MM_OLEAMENTO'
                                 matnr = lwa_rastreabilidade-matnr
                                 charg = lwa_rastreabilidade-charg.
  IF sy-subrc EQ 0.
    DATA(lv_charg_oleamento) = t_itab_lot-atwrt.
  ELSE.
    IF lv_matnr_oleamento_acabado NE space.
      p_matches = ''.
      MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
      wa_result-werks_apl = p_werks.
      wa_result-matnr_apl = p_matnr.
      CONCATENATE 'Divergência de oleamento >>' ''  INTO wa_result-log SEPARATED BY space.
      APPEND wa_result TO it_result.
      CLEAR wa_result.
    ENDIF.
  ENDIF.

* Quimico
  IF ( lv_charg_oleamento IS NOT INITIAL AND lv_matnr_oleamento_acabado IS NOT INITIAL ).
    PERFORM f_consiste_oleamento IN PROGRAM zppr_processa_necessidade_mp
            USING 'MM_OLEAMENTO'
                  p_werks
                  p_matnr
                  p_wa_mchbcar
                  p_wa_mchbcar-charg
            CHANGING lv_charg_oleamento
                     lv_matnr_oleamento_acabado
                     lv_matches
                     wa_result.

    IF wa_result IS  NOT INITIAL.
      APPEND wa_result TO it_result.
    ENDIF.
  ENDIF.

  IF lv_matches IS INITIAL.
    PERFORM f_grava_it_log_aplicacao USING  wa_lista_tecnica-idnrk
                                            lwa_rastreabilidade-matnr
                                            lwa_rastreabilidade-charg.
  ENDIF.

  CLEAR lv_charg_oleamento.

***** Nivel oleamento
*  READ TABLE t_itab_lot WITH KEY atnam = 'MM_NIVEL_OLEAMENTO'
*                                 matnr = lwa_rastreabilidade-matnr
*                                 charg = lwa_rastreabilidade-charg.
*
*  IF sy-subrc EQ 0.
*    DATA(lv_charg_nivel_oleamento) = t_itab_lot-atwrt.
*  ELSE.
*    IF lv_matnr_oleamento_acabado  NE space.
*      p_matches = ''.
*      MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
*      wa_result-werks_apl = p_werks.
*      wa_result-matnr_apl = p_matnr.
*      CONCATENATE 'Divergência de nivel oleamento >>' ''  INTO wa_result-log SEPARATED BY space.
*      APPEND wa_result TO it_result.
*      CLEAR wa_result.
*    ENDIF.
*  ENDIF.

* Quimico
*  IF ( lv_charg_nivel_oleamento IS NOT INITIAL AND lv_matnr_nivel_oleo_acabado  IS NOT INITIAL ).
*    PERFORM f_consiste_oleamento IN PROGRAM zppr_processa_necessidade_mp
*            USING 'MM_NIVEL_OLEAMENTO'
*                  p_werks
*                  p_matnr
*                  p_wa_mchbcar
*                  p_wa_mchbcar-charg
*            CHANGING lv_charg_nivel_oleamento
*                     lv_matnr_nivel_oleo_acabado
*                     lv_matches
*                     wa_result.
*
*    IF wa_result IS  NOT INITIAL.
*      APPEND wa_result TO it_result.
*    ENDIF.
*  ENDIF.
*
*  IF lv_matches IS INITIAL.
*    PERFORM f_grava_it_log_aplicacao USING  wa_lista_tecnica-idnrk
*                                            lwa_rastreabilidade-matnr
*                                            lwa_rastreabilidade-charg.
*  ENDIF.
*
*  CLEAR: lv_charg_nivel_oleamento, lv_matnr_nivel_oleo_acabado.

***** Peça segurança
  READ TABLE t_itab_lot WITH KEY atnam = 'MM_PECA_SEGURANCA'
                                 matnr = lwa_rastreabilidade-matnr
                                 charg = lwa_rastreabilidade-charg.
  IF sy-subrc EQ 0.
    DATA(lv_charg_peca) = t_itab_lot-atwrt.
  ELSE.
    IF lv_matnr_peca_acabado  NE space.
      p_matches = ''.
      MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
      wa_result-werks_apl = p_werks.
      wa_result-matnr_apl = p_matnr.
      CONCATENATE 'Divergência peça segurança >>' ''  INTO wa_result-log SEPARATED BY space.
      APPEND wa_result TO it_result.
      CLEAR wa_result.
    ENDIF.
  ENDIF.

* Quimico
  IF ( lv_charg_peca IS NOT INITIAL AND lv_matnr_peca_acabado IS NOT INITIAL ).
    PERFORM f_consiste_oleamento IN PROGRAM zppr_processa_necessidade_mp
            USING 'MM_PECA_SEGURANCA'
                  p_werks
                  p_matnr
                  p_wa_mchbcar
                  p_wa_mchbcar-charg
            CHANGING lv_charg_peca
                     lv_matnr_peca_acabado
                     lv_matches
                     wa_result.

    IF wa_result IS  NOT INITIAL.
      APPEND wa_result TO it_result.
    ENDIF.
  ENDIF.

  IF lv_matches IS INITIAL.
    PERFORM f_grava_it_log_aplicacao USING  wa_lista_tecnica-idnrk
                                            lwa_rastreabilidade-matnr
                                            lwa_rastreabilidade-charg.
    CLEAR: lv_charg_oleamento, lv_matnr_peca_acabado, lv_charg_peca.
  ENDIF.

  SORT it_result.
  DELETE ADJACENT DUPLICATES FROM it_result COMPARING ALL FIELDS.

* 31Jul2024 RGC8096 RDM
  LOOP AT it_result INTO DATA(w_result).
    IF w_result-matnr = w_result-matnr_apl.
      DELETE it_result INDEX sy-tabix.
      CLEAR w_result.
    ENDIF.
  ENDLOOP.

  EXPORT it_result FROM it_result TO MEMORY ID 'RESULT'.
ENDFORM.
*&---------------------------------------------------------------------*
*&      Form  F_REPROVAR_200
*&---------------------------------------------------------------------*
FORM f_reprovar_200 .
  DATA: lit_zppt_gi TYPE STANDARD TABLE OF ty_zppt_gi,
        lwa_zppt_gi LIKE LINE OF lit_zppt_gi.

  DATA lwa_zppt_lta_reprov  TYPE zppt_lta_reprov.
  DATA lwa_zppt_oest_log    TYPE zppt_oest_log.

  DATA ls_selrow  TYPE lvc_s_row.

  REFRESH gt_rows.
  IF g_tab_appl-subscreen = '0201'.
    CALL METHOD gr_table1->get_selected_rows
      IMPORTING
        et_index_rows = gt_rows.
  ELSE.
    CALL METHOD gr_table2->get_selected_rows
      IMPORTING
        et_index_rows = gt_rows.
  ENDIF.

  IF gt_rows[] IS INITIAL.
    MESSAGE e000(su) WITH text-m02.
  ELSE.
    SELECT matnr
           deposito
           lote_minimo
           necessidade
      FROM zppt_gi
      INTO TABLE lit_zppt_gi.

    SORT lit_zppt_gi BY matnr.

    LOOP AT gt_rows INTO ls_selrow.
      IF g_tab_appl-subscreen = '0201'.
        READ TABLE gt_outtab1 INTO wa_outtab INDEX ls_selrow-index.
      ELSE.
        READ TABLE gt_outtab2 INTO wa_outtab INDEX ls_selrow-index.
      ENDIF.

      IF NOT sy-subrc IS INITIAL.
        CONTINUE.
      ENDIF.

      wa_outtab-mark = 'X'.
      IF g_tab_appl-subscreen = '0201'.
        MODIFY gt_outtab1 FROM wa_outtab INDEX sy-tabix TRANSPORTING mark.
      ELSE.
        MODIFY gt_outtab2 FROM wa_outtab INDEX sy-tabix TRANSPORTING mark.
      ENDIF.

      "INSERE NA TABELA ZPPT_LTA_REPROV para não sugerir novamente
      lwa_zppt_lta_reprov-mandt   = sy-mandt.
      lwa_zppt_lta_reprov-idnrk   = wa_outtab-matnr.
      lwa_zppt_lta_reprov-charg   = wa_outtab-charg.
      lwa_zppt_lta_reprov-matnr   = wa_outtab-matnr_apl.
      lwa_zppt_lta_reprov-usuario = sy-uname.
      lwa_zppt_lta_reprov-data    = sy-datum.
      INSERT INTO zppt_lta_reprov VALUES lwa_zppt_lta_reprov.

      "APAGA NA TABELA ZPPT_OEST
      DELETE FROM zppt_oest WHERE werks EQ wa_outtab-werks
                              AND matnr EQ wa_outtab-matnr
                              AND charg EQ wa_outtab-charg
                              AND werks_apl EQ wa_outtab-werks_apl
                              AND matnr_apl EQ wa_outtab-matnr_apl.

      "INSERE REGISTRO NA TABELA ZPPT_OEST_LOG
      MOVE-CORRESPONDING wa_outtab TO lwa_zppt_oest_log.

      READ TABLE lit_zppt_gi INTO lwa_zppt_gi
                             WITH KEY matnr = wa_outtab-idnrk_apl BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        lwa_zppt_oest_log-lgort_apl   = lwa_zppt_gi-deposito.
        lwa_zppt_oest_log-lote_minimo = lwa_zppt_gi-lote_minimo.
        lwa_zppt_oest_log-necessidade = lwa_zppt_gi-necessidade.
      ENDIF.

      lwa_zppt_oest_log-erdat       = sy-datum.
      lwa_zppt_oest_log-usuario_qa  = sy-uname.
      lwa_zppt_oest_log-data_qa     = sy-datum.
      lwa_zppt_oest_log-hora_qa     = sy-uzeit.
      lwa_zppt_oest_log-situacao    = 'REPROVADO'.
      INSERT INTO zppt_oest_log VALUES lwa_zppt_oest_log.

      COMMIT WORK AND WAIT.
      CLEAR: wa_outtab.
    ENDLOOP.

    IF g_tab_appl-subscreen = '0201'.
      DELETE gt_outtab1 WHERE mark = 'X'.
      CALL METHOD gr_table1->refresh_table_display.
    ELSE.
      DELETE gt_outtab2 WHERE mark = 'X'.
      CALL METHOD gr_table2->refresh_table_display.
    ENDIF.
  ENDIF.
  FREE lit_zppt_gi.
ENDFORM.                    " F_REPROVAR_200
