FORM f_consiste_deposito USING p_werks
                               p_matnr
                               p_wa_mchbcar LIKE wa_mchbcar.

  SELECT COUNT( * )
    FROM t001l
   WHERE werks EQ @p_werks
     AND lgort EQ @p_wa_mchbcar-lgort.
  IF sy-subrc IS NOT INITIAL.
    MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
