*&      Form  F_SELECIONA_CARACT_MATNR
*&---------------------------------------------------------------------*
FORM f_seleciona_caract_matnr .
  TYPES: BEGIN OF ty_matnr_objek,
           objek TYPE inob-objek,
         END OF ty_matnr_objek,

         BEGIN OF ty_ausp,
           objek TYPE ausp-objek,
           atinn TYPE ausp-atinn,
           atzhl TYPE ausp-atzhl,
           mafid TYPE ausp-mafid,
           klart TYPE ausp-klart,
           adzhl TYPE ausp-adzhl,
           atwrt TYPE ausp-atwrt,
           atflv TYPE ausp-atflv,
           matnr TYPE mara-matnr,
         END OF ty_ausp,

         BEGIN OF ty_inob,
           cuobj TYPE inob-cuobj,
           objek TYPE inob-objek,
         END OF ty_inob,

         BEGIN OF ty_cabn,
           atinn TYPE cabn-atinn,
           atnam TYPE cabn-atnam,
           atfor TYPE cabn-atfor,
         END OF ty_cabn,

         BEGIN OF ty_cawn,
           atinn TYPE cawn-atinn,
           atwrt TYPE cawn-atwrt,
           atzhl TYPE cawn-atzhl,
           adzhl TYPE cawn-adzhl,
         END OF ty_cawn,

         BEGIN OF ty_cawnt,
           atinn TYPE cawnt-atinn,
           atzhl TYPE cawnt-atzhl,
           adzhl TYPE cawnt-adzhl,
           atwtb TYPE cawnt-atwtb,
         END OF ty_cawnt.

  DATA: lit_matnr_objek TYPE TABLE OF ty_matnr_objek,
        lit_matnr_ausp  TYPE TABLE OF ty_ausp,
        lit_ausp        TYPE TABLE OF ty_ausp,
        lit_ausp_aux    TYPE TABLE OF ty_ausp,
        lit_inob        TYPE TABLE OF ty_inob,
        lit_cabn        TYPE TABLE OF ty_cabn,
        lit_cawn        TYPE TABLE OF ty_cawn,
        lit_cawnt       TYPE TABLE OF ty_cawnt.

  DATA: lv_cuobj_023    TYPE inob-cuobj.

  FIELD-SYMBOLS: <fs_mara>         LIKE LINE OF it_mara,
                 <fs_matnr_objek>  TYPE ty_matnr_objek,
                 <fs_atinn>        TYPE zsusde_caract_int,
                 <fs_ausp>         TYPE ty_ausp,
                 <fs_matnr_ausp>   TYPE ty_ausp,
                 <fs_inob>         TYPE ty_inob,
                 <fs_cabn>         TYPE ty_cabn,
                 <fs_cawn>         TYPE ty_cawn,
                 <fs_cawnt>        TYPE ty_cawnt,
                 <fs_caract_matnr> LIKE LINE OF it_caract_matnr.

  cl_progress_indicator=>progress_indicate(
    i_text = 'Selecionando as caract dos SKUs...'
    i_output_immediately = abap_true ).

  REFRESH: it_caract_matnr,
           it_atinn.

  PERFORM f_add_atinn USING 'SD_TOL_MAX_ESPESSURA'.
  PERFORM f_add_atinn USING 'SD_TOL_MIN_ESPESSURA'.
  PERFORM f_add_atinn USING 'SD_ESPESSURA'.
  PERFORM f_add_atinn USING 'SD_TOL_MIN_LARGURA'.
  PERFORM f_add_atinn USING 'SD_LARGURA'.
  PERFORM f_add_atinn USING 'SD_QUALIDADES'.
  PERFORM f_add_atinn USING 'SD_SUPERFICIE'.
  PERFORM f_add_atinn USING 'HIERARQ_02'.
  PERFORM f_add_atinn USING 'HIERARQ_04'.
  PERFORM f_add_atinn USING 'HIERARQ_05'.
  PERFORM f_add_atinn USING 'HIERARQ_08'.
  PERFORM f_add_atinn USING 'MM_POS_TRATAMENTO'.
  PERFORM f_add_atinn USING 'MM_OLEAMENTO'.
  PERFORM f_add_atinn USING 'MM_NIVEL_OLEAMENTO'.
  PERFORM f_add_atinn USING 'MM_PECA_SEGURANCA'.
  PERFORM f_add_atinn USING 'SD_COMPRIMENTO'.
  PERFORM f_add_atinn USING 'SD_DIAMETRO_INTERNO'.
  PERFORM f_add_atinn USING 'SD_DIAMETRO_EXTERNO'.
  PERFORM f_add_atinn USING 'PDR_CONSULTA_METALURGICA'.
  PERFORM f_add_atinn USING 'SD_LIM_RESISTENCIA'.
  PERFORM f_add_atinn USING 'SD_HIERARQUIA_PRODUTO'.
  PERFORM f_add_atinn USING: 'SD_DIAM_EXT_MAXIMO',
                             'SD_DIAM_INT_MINIMO',
                             'SD_DIAM_EXT_MINIMO',
                             'SD_DIAM_INT_MAXIMO',
                             'SD_LIM_RES_MAXIMA',
                             'SD_LIM_RES_MINIMA'.

  SORT it_mtart_mast BY matnr.

  LOOP AT it_mast INTO DATA(wa_mast).
    INSERT INITIAL LINE INTO TABLE it_mara ASSIGNING <fs_mara>.
    <fs_mara>-matnr = wa_mast-idnrk.

    READ TABLE it_mtart_mast INTO DATA(wa_tart_mast) WITH KEY matnr = <fs_mara>-matnr BINARY SEARCH.
    IF sy-subrc EQ 0.
      <fs_mara>-mtart = wa_tart_mast-mtart.
    ENDIF.
  ENDLOOP.

  LOOP AT it_mara ASSIGNING <fs_mara>.
    INSERT INITIAL LINE INTO TABLE lit_matnr_objek ASSIGNING <fs_matnr_objek>.
    <fs_matnr_objek>-objek = <fs_mara>-matnr.
  ENDLOOP.

  SELECT cuobj objek
    FROM inob
    INTO TABLE lit_inob
    FOR ALL ENTRIES IN lit_matnr_objek
    WHERE obtab = 'MARA'
      AND objek = lit_matnr_objek-objek
      AND klart = '023'.
  SORT lit_inob BY objek.

  LOOP AT it_mara ASSIGNING <fs_mara>.
    "classe 023
    CLEAR lv_cuobj_023.
    READ TABLE lit_inob ASSIGNING <fs_inob> WITH KEY objek = <fs_mara>-matnr BINARY SEARCH.
    IF sy-subrc IS INITIAL.
      lv_cuobj_023 = <fs_inob>-cuobj.
    ENDIF.

    IF <fs_mara>-mtart EQ 'ZFEJ'.
      LOOP AT it_atinn ASSIGNING <fs_atinn>.
        "classe 001
        INSERT INITIAL LINE INTO TABLE lit_matnr_ausp ASSIGNING <fs_matnr_ausp>.
        <fs_matnr_ausp>-matnr = <fs_mara>-matnr.
        <fs_matnr_ausp>-atinn = <fs_atinn>-atinn.
        <fs_matnr_ausp>-objek = <fs_mara>-matnr.
        <fs_matnr_ausp>-klart = '001'.

        "classe 023
        IF lv_cuobj_023 IS NOT INITIAL.
          INSERT INITIAL LINE INTO TABLE lit_matnr_ausp ASSIGNING <fs_matnr_ausp>.
          <fs_matnr_ausp>-matnr = <fs_mara>-matnr.
          <fs_matnr_ausp>-atinn = <fs_atinn>-atinn.
          <fs_matnr_ausp>-objek = lv_cuobj_023.
          <fs_matnr_ausp>-klart = '023'.
        ENDIF.
      ENDLOOP.
    ELSEIF <fs_mara>-mtart EQ 'ZALJ' OR <fs_mara>-mtart EQ 'ZMAJ'.
      "classe 023
      IF lv_cuobj_023 IS NOT INITIAL.
        LOOP AT it_atinn ASSIGNING <fs_atinn>.
          INSERT INITIAL LINE INTO TABLE lit_matnr_ausp ASSIGNING <fs_matnr_ausp>.
          <fs_matnr_ausp>-matnr = <fs_mara>-matnr.
          <fs_matnr_ausp>-atinn = <fs_atinn>-atinn.
          <fs_matnr_ausp>-objek = lv_cuobj_023.
          <fs_matnr_ausp>-klart = '023'.
        ENDLOOP.
      ENDIF.
    ENDIF.
  ENDLOOP.

  CHECK lit_matnr_ausp[] IS NOT INITIAL.

  SORT lit_matnr_ausp BY objek atinn.

  SELECT objek atinn atzhl mafid klart adzhl atwrt atflv
    FROM ausp
    INTO TABLE lit_ausp
    FOR ALL ENTRIES IN lit_matnr_ausp
    WHERE objek EQ lit_matnr_ausp-objek
      AND atinn EQ lit_matnr_ausp-atinn.

  IF lit_ausp[] IS NOT INITIAL.
    SORT lit_ausp BY objek atinn.
    lit_ausp_aux = lit_ausp.
    SORT lit_ausp_aux BY atinn.
    DELETE ADJACENT DUPLICATES FROM lit_ausp_aux COMPARING atinn.
    SELECT atinn atnam atfor
      FROM cabn
      INTO TABLE lit_cabn
      FOR ALL ENTRIES IN lit_ausp_aux
      WHERE atinn = lit_ausp_aux-atinn.
    SORT lit_cabn BY atinn.

    lit_ausp_aux = lit_ausp.
    SORT lit_ausp_aux BY atinn atwrt.
    DELETE ADJACENT DUPLICATES FROM lit_ausp_aux COMPARING atinn atwrt.
    SELECT atinn atwrt atzhl adzhl
      FROM cawn
      INTO TABLE lit_cawn
      FOR ALL ENTRIES IN lit_ausp_aux
      WHERE atinn = lit_ausp_aux-atinn
        AND atwrt = lit_ausp_aux-atwrt.
    SORT lit_cawn BY atinn atwrt.

    IF NOT lit_cawn[] IS INITIAL.
      SELECT atinn atzhl adzhl atwtb
        FROM cawnt
        INTO TABLE lit_cawnt
        FOR ALL ENTRIES IN lit_cawn
        WHERE atinn = lit_cawn-atinn
          AND atzhl = lit_cawn-atzhl
          AND spras = sy-langu
          AND adzhl = lit_cawn-adzhl.
      SORT lit_cawnt BY atinn atzhl adzhl.
    ENDIF.

    LOOP AT lit_matnr_ausp ASSIGNING <fs_matnr_ausp>.
      READ TABLE lit_ausp ASSIGNING <fs_ausp> WITH KEY objek = <fs_matnr_ausp>-objek
                                                       atinn = <fs_matnr_ausp>-atinn
                                                       BINARY SEARCH.
      IF sy-subrc IS NOT INITIAL.
        CONTINUE.
      ENDIF.

      READ TABLE lit_cabn ASSIGNING <fs_cabn> WITH KEY atinn = <fs_ausp>-atinn BINARY SEARCH.
      IF sy-subrc IS NOT INITIAL.
        CONTINUE.
      ENDIF.

      INSERT INITIAL LINE INTO TABLE it_caract_matnr ASSIGNING <fs_caract_matnr>.
      <fs_caract_matnr>-matnr = <fs_matnr_ausp>-matnr.
      <fs_caract_matnr>-atnam = <fs_cabn>-atnam.
      <fs_caract_matnr>-atwrt = <fs_ausp>-atwrt.
      <fs_caract_matnr>-atflv = <fs_ausp>-atflv.
      READ TABLE lit_cawn ASSIGNING <fs_cawn> WITH KEY atinn = <fs_ausp>-atinn
                                                       atwrt = <fs_ausp>-atwrt BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        READ TABLE lit_cawnt ASSIGNING <fs_cawnt> WITH KEY atinn = <fs_cawn>-atinn
                                                           atzhl = <fs_cawn>-atzhl
                                                           adzhl = <fs_cawn>-adzhl BINARY SEARCH.
        IF sy-subrc IS INITIAL.
          <fs_caract_matnr>-atwtb = <fs_cawnt>-atwtb.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDIF.

  FREE: lit_matnr_objek,
        lit_matnr_ausp,
        lit_ausp,
        lit_ausp_aux,
        lit_inob,
        lit_cabn,
        lit_cawn,
        lit_cawnt.
ENDFORM.                    " F_SELECIONA_CARACT_MATNR
