FORM f_vsamp_pa .
  FIELD-SYMBOLS: <fs_vsamp_pa> TYPE zsuppt_vsamp_pa,
                 <fs_mchbcar>  TYPE zrnsdt_mchbcar.

  SELECT *
    FROM zsuppt_vsamp_pa
    INTO TABLE it_vsamp_pa
    WHERE nr_lote IN s_charg.
  IF sy-subrc IS INITIAL.
    SORT it_mchbcar BY matnr charg.
    LOOP AT it_vsamp_pa ASSIGNING <fs_vsamp_pa>.
      gv_tabix = sy-tabix.
      READ TABLE it_mchbcar WITH KEY matnr = <fs_vsamp_pa>-cd_material
                                     charg = <fs_vsamp_pa>-nr_lote
                                     ASSIGNING <fs_mchbcar>
                                     BINARY SEARCH.
      IF NOT sy-subrc IS INITIAL.
        DELETE it_vsamp_pa INDEX gv_tabix.
      ENDIF.
    ENDLOOP.
  ENDIF.
ENDFORM.                    " F_VSAMP_PA
