FORM f_consiste_qualidade  USING    p_werks
                                    p_matnr
                                    p_wa_mchbcar LIKE wa_mchbcar
                                    p_charg_qualidade
                                    p_matnr_qualidade
                                    p_consistencia_cdqua
                           CHANGING p_matches.
  IF p_charg_qualidade EQ p_matnr_qualidade.
    RETURN.
  ELSE.
    IF p_consistencia_cdqua IS NOT INITIAL.
      p_matches = ''.
      MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
      wa_result-werks_apl = p_werks.
      wa_result-matnr_apl = p_matnr.
      wa_result-log       = 'Qualidade >> Qualidade restrita para receber aplicação'.
      wa_result-idnrk_apl = wa_lista_tecnica-idnrk.
      wa_result-lgort_apl = wa_marc-lgpro.
      APPEND wa_result TO it_result.
      CLEAR wa_result.
    ELSE.
      wa_result-idnrk_apl = wa_lista_tecnica-idnrk.
      wa_result-lgort_apl = wa_marc-lgpro.
      MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
      wa_result-werks_apl = p_werks.
      wa_result-matnr_apl = p_matnr.
      wa_result-log       = 'Exige certificado de Usina'.
      wa_result-xloek     = 'A'.
      APPEND wa_result TO it_result.
      CLEAR wa_result.
    ENDIF.
  ENDIF.
ENDFORM.                    " F_CONSISTE_QUALIDADE
