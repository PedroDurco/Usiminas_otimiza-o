*&---------------------------------------------------------------------*
FORM f_seleciona_reservas .
  DATA lit_resb TYPE STANDARD TABLE OF ty_resb.

  cl_progress_indicator=>progress_indicate(
    i_text = 'Selecionando as Reservas Ativas...'
    i_output_immediately = abap_true ).

  REFRESH:  it_resb_231,
            it_resb_261,
            it_resb_bext.

  SELECT rsnum
         rspos
         rsart
         matnr
         werks
         lgort
         charg
         baugr
         bwart
         bdmng
         enmng
         banfn
         ebeln
         kdauf
    INTO TABLE lit_resb
    FROM resb
    FOR ALL ENTRIES IN it_mchbcar
    WHERE matnr EQ it_mchbcar-matnr
      AND werks EQ it_mchbcar-werks
      AND xloek EQ ''
      AND charg EQ it_mchbcar-charg
      AND kzear EQ ''.
  IF sy-subrc IS INITIAL.
    "Somar qtd reservada e qtd retirada
    CLEAR it_resb_aux[].
    it_resb_aux[] = lit_resb[].
    DELETE it_resb_aux WHERE bwart NE '231'.

    LOOP AT it_resb_aux INTO DATA(ls_resb).
      CLEAR wa_resb_231.
      wa_resb_231-matnr = ls_resb-matnr.
      wa_resb_231-werks = ls_resb-werks.
      wa_resb_231-lgort = ls_resb-lgort.
      wa_resb_231-charg = ls_resb-charg.
      wa_resb_231-bdmng = ls_resb-bdmng.
      wa_resb_231-enmng = ls_resb-enmng.
      COLLECT wa_resb_231 INTO it_resb_231.
    ENDLOOP.

    "Somar qtd reservada e qtd retirada
    CLEAR it_resb_aux[].
    it_resb_aux[] = lit_resb[].
    DELETE it_resb_aux WHERE bwart NE '261'.

    LOOP AT it_resb_aux INTO ls_resb.
      CLEAR wa_resb_261.
      wa_resb_261-matnr = ls_resb-matnr.
      wa_resb_261-werks = ls_resb-werks.
      wa_resb_261-lgort = ls_resb-lgort.
      wa_resb_261-charg = ls_resb-charg.
      wa_resb_261-bdmng = ls_resb-bdmng.
      wa_resb_261-enmng = ls_resb-enmng.
      COLLECT wa_resb_261 INTO it_resb_261.
    ENDLOOP.

    it_resb_bext[] = lit_resb[].
    DELETE it_resb_bext WHERE bwart EQ '261' OR bwart = '231'.
    it_resb_aux[] = lit_resb[].
  ENDIF.

  FREE lit_resb.

  SELECT werks matnr charg werks_apl matnr_apl
         udate utime clabs resbp
  INTO CORRESPONDING FIELDS OF TABLE it_pajt_log
  FROM zppt_pajt_log
  FOR ALL ENTRIES IN it_mchbcar
  WHERE werks EQ it_mchbcar-werks
    AND matnr EQ it_mchbcar-matnr
    AND charg EQ it_mchbcar-charg
    AND situacao EQ 'APROVADO'.
  IF sy-subrc IS NOT INITIAL. " Descontinuidade da tabela ZPPT_PAJT_LOG
    SELECT werks matnr charg werks_apl matnr_apl
           udate utime clabs resbp
    INTO CORRESPONDING FIELDS OF TABLE it_pajt_log
    FROM zppt_oest_log
    FOR ALL ENTRIES IN it_mchbcar
    WHERE werks EQ it_mchbcar-werks
      AND matnr EQ it_mchbcar-matnr
      AND charg EQ it_mchbcar-charg
      AND situacao EQ 'APROVADO'.
  ENDIF.
  SORT it_pajt_log BY werks matnr charg ASCENDING udate utime DESCENDING.
ENDFORM.                    " F_SELECIONA_RESERVAS
