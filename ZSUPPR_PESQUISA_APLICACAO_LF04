    ENDIF.

    SORT lit_makt BY matnr.
    SORT it_zrnppt_prev BY werks ano mes matnr.
    SORT it_lista_alt BY matnr charg.

    "Montar uma tabela com todos os registros que são capabil NOK
    it_result_nok[] = it_result[].
    SORT it_result_nok BY xloek.
    DELETE it_result_nok WHERE xloek = 'A' OR xloek = 'M' OR xloek = 'P' OR xloek = 'T' OR xloek = 'X' OR xloek = ' '.
    SORT it_result_nok BY matnr charg matnr_apl.

    LOOP AT it_result ASSIGNING <fs_result>.

      CLEAR wa_outtab.
      MOVE-CORRESPONDING <fs_result> TO wa_outtab.

      READ TABLE lit_makt ASSIGNING <fs_makt>
                          WITH KEY matnr = <fs_result>-matnr
                          BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-maktx = <fs_makt>-maktx.
      ENDIF.

      READ TABLE lit_makt ASSIGNING <fs_makt>
                          WITH KEY matnr = <fs_result>-matnr_apl
                          BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-maktx_apl = <fs_makt>-maktx.
      ENDIF.

      READ TABLE it_lista_tecnica ASSIGNING <fs_lista_tecnica>
                                  WITH KEY werks = <fs_result>-werks_apl
                                           matnr = <fs_result>-matnr_apl
                                           BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-idnrk_apl = <fs_lista_tecnica>-idnrk.
      ENDIF.

*     Stefanini/Elaine Omine - PRJ1372 - 03/08/2023 - Início
      READ TABLE it_marc INTO wa_marc WITH KEY matnr = <fs_result>-matnr_apl
                                               werks = <fs_result>-werks_apl
                                               BINARY SEARCH.
      IF sy-subrc EQ 0.
        wa_outtab-lgort_apl = wa_marc-lgpro.
      ENDIF.
*     Stefanini/Elaine Omine - PRJ1372 - 03/08/2023 - Fim

      "Demanda Mes
      lv_ano = sy-datum(4).
      lv_mes = sy-datum+4(2).
      READ TABLE it_zrnppt_prev ASSIGNING <fs_zrnppt_prev>
                                WITH KEY werks = <fs_result>-werks_apl
                                         ano   = lv_ano
                                         mes   = lv_mes
                                         matnr = <fs_result>-matnr_apl
                                         BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-prev_org = <fs_zrnppt_prev>-peso.
      ENDIF.

      "Demanda M+1
      lv_mes = lv_mes + 1.
      IF lv_mes = 12.
        lv_ano  = lv_ano + 1.
        lv_mes  = 1.
      ENDIF.
      READ TABLE it_zrnppt_prev ASSIGNING <fs_zrnppt_prev>
                                WITH KEY werks = <fs_result>-werks_apl
                                         ano   = lv_ano
                                         mes   = lv_mes
                                         matnr = <fs_result>-matnr_apl
                                         BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-prev_org1 = <fs_zrnppt_prev>-peso.
      ENDIF.

      "Demanda M+2
      lv_mes = lv_mes + 1.
      IF lv_mes = 12.
        lv_ano  = lv_ano + 1.
        lv_mes  = 1.
      ENDIF.
      READ TABLE it_zrnppt_prev ASSIGNING <fs_zrnppt_prev>
                                WITH KEY werks = <fs_result>-werks_apl
                                         ano   = lv_ano
                                         mes   = lv_mes
                                         matnr = <fs_result>-matnr_apl
                                         BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-prev_org2 = <fs_zrnppt_prev>-peso.
      ENDIF.

      READ TABLE it_mslb ASSIGNING <fs_mslb> WITH KEY matnr = <fs_result>-matnr
                                                      charg = <fs_result>-charg
                                                      BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        READ TABLE lit_lfa1 ASSIGNING <fs_lfa1> WITH KEY lifnr = <fs_mslb>-lifnr.
        IF sy-subrc IS INITIAL.
          wa_outtab-charg_mslb = <fs_lfa1>-sortl.
        ENDIF.
      ENDIF.

      READ TABLE it_caract_charg ASSIGNING <fs_caract_charg>
                                 WITH KEY matnr = <fs_result>-matnr
                                          charg = <fs_result>-charg
                                          atnam = 'SD_SUPERFICIE'
                                          BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-superficie = <fs_caract_charg>-atwtb.
      ENDIF.

      READ TABLE it_caract_matnr ASSIGNING <fs_caract_matnr>
                                 WITH KEY matnr = <fs_result>-matnr_apl
                                          atnam = 'SD_SUPERFICIE'
                                          BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        wa_outtab-superficie_apl = <fs_caract_matnr>-atwtb.
      ENDIF.

*     Stefanini/Elaine Omine - PRJ1372 - 23/08/2023 - Início
      "Campos de analise financeira na consulta dos materiais alternativos
*      PERFORM f_analise_financeira CHANGING wa_outtab.
      "Análise financeira será executada no botão Calcular e não mais para todos os registros
      READ TABLE it_result_nok TRANSPORTING NO FIELDS WITH KEY matnr     = wa_outtab-matnr
                                                               charg     = wa_outtab-charg
                                                               matnr_apl = wa_outtab-matnr_apl BINARY SEARCH.
      IF sy-subrc EQ 0.
        wa_outtab-capabil = 'NOK'.
      ELSE.
        IF wa_outtab-xloek EQ 'E' OR
           wa_outtab-xloek EQ 'C' OR
           wa_outtab-xloek EQ 'R'.
          wa_outtab-capabil = 'NOK'.
        ELSE.
          wa_outtab-capabil = 'OK'.
        ENDIF.
      ENDIF.
*     Stefanini/Elaine Omine - PRJ1372 - 23/08/2023 - Fim

      "Define Status e Alerta
      IF <fs_result>-log IS INITIAL.
        wa_outtab-tpmesag  = '1'.
        wa_outtab-icon_stt = icon_green_light.
        TRANSLATE wa_outtab-statustxt TO UPPER CASE.
        APPEND wa_outtab TO gt_outtab1.
      ELSE.
        wa_outtab-icon_stt  = icon_yellow_light.

*PM - Capabilidade - PRJ1372 - 15.03.2022
        IF wa_outtab-xloek EQ 'E'.
          wa_outtab-statustxt = 'CAPABILIDADE'.
          wa_outtab-icon_stt  = icon_yellow_light.
        ELSEIF wa_outtab-xloek EQ 'C'.
          wa_outtab-statustxt = 'CAPABILIDADE'.
          wa_outtab-icon_stt  = icon_yellow_light.
        ELSEIF wa_outtab-xloek EQ 'M'.
          wa_outtab-statustxt = 'CONSULTA'.
          wa_outtab-icon_stt  = icon_yellow_light.
        ELSEIF wa_outtab-xloek EQ 'R'.
          wa_outtab-statustxt = 'CAPABILIDADE'.
          wa_outtab-icon_stt  = icon_yellow_light.
        ELSEIF wa_outtab-xloek EQ 'A'.
          wa_outtab-statustxt = 'CERTIFICADO'.
          wa_outtab-icon_stt  = icon_yellow_light.
        ELSE.
          SPLIT <fs_result>-log AT '>>' INTO wa_outtab-statustxt wa_outtab-log.
          TRANSLATE wa_outtab-statustxt TO UPPER CASE.
        ENDIF.
*PM - Capabilidade - PRJ1372 - 15.03.2022

        PERFORM f_classifica_log CHANGING wa_outtab
                                          lv_restrito.

        " verificar se o lote esta reservado
        PERFORM f_check_lote_reservado CHANGING wa_outtab
                                                wa_outtab-xloek.
        IF wa_outtab-xloek NE 'X'.
          CLEAR wa_outtab-xloek.
        ENDIF.

        IF lv_restrito IS INITIAL.
          wa_outtab-tpmesag  = '2'.
          APPEND wa_outtab TO gt_outtab2.
        ELSE.
          wa_outtab-icon_stt  = icon_red_light.
          TRANSLATE wa_outtab-statustxt TO UPPER CASE.
          TRANSLATE wa_outtab-log TO UPPER CASE.

          wa_outtab-tpmesag  = '3'.
          APPEND wa_outtab TO gt_outtab3.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDIF.

  "reorganização dos registros da aba: Liberado
  SORT gt_outtab2 BY werks matnr charg werks_apl matnr_apl.
  SORT gt_outtab3 BY werks matnr charg werks_apl matnr_apl.
  CLEAR: gt_outtab2_aux[], gt_outtab3_aux[].

  LOOP AT gt_outtab1 ASSIGNING <fs_outtab>.
    gv_tabix = sy-tabix.
    "Restrito
    READ TABLE gt_outtab3 TRANSPORTING NO FIELDS
                          WITH KEY werks = <fs_outtab>-werks
                                   matnr = <fs_outtab>-matnr
                                   charg = <fs_outtab>-charg
                                   werks_apl = <fs_outtab>-werks_apl
                                   matnr_apl = <fs_outtab>-matnr_apl
                                   BINARY SEARCH.
    IF sy-subrc IS INITIAL.
      DELETE gt_outtab1 INDEX gv_tabix.
      CONTINUE.
    ENDIF.

    "Sujeito a aprovação
    READ TABLE gt_outtab2 TRANSPORTING NO FIELDS
                          WITH KEY werks = <fs_outtab>-werks
                                   matnr = <fs_outtab>-matnr
                                   charg = <fs_outtab>-charg
                                   werks_apl = <fs_outtab>-werks_apl
                                   matnr_apl = <fs_outtab>-matnr_apl
                                   BINARY SEARCH.
    IF sy-subrc IS INITIAL.
      DELETE gt_outtab1 INDEX gv_tabix.
      CONTINUE.
    ENDIF.
  ENDLOOP.

  "reorganização dos registros da aba: Sujeito aprovação
  SORT gt_outtab3 BY werks matnr charg werks_apl matnr_apl.

  LOOP AT gt_outtab2 ASSIGNING <fs_outtab>.
    gv_tabix = sy-tabix.
    "Restrito
    READ TABLE gt_outtab3 TRANSPORTING NO FIELDS
                          WITH KEY werks = <fs_outtab>-werks
                                   matnr = <fs_outtab>-matnr
                                   charg = <fs_outtab>-charg
                                   werks_apl = <fs_outtab>-werks_apl
                                   matnr_apl = <fs_outtab>-matnr_apl
                                   BINARY SEARCH.
    IF sy-subrc IS INITIAL.
      MOVE-CORRESPONDING <fs_outtab> TO wa_outtab.
      APPEND wa_outtab TO gt_outtab3_aux.
      DELETE gt_outtab2 INDEX gv_tabix.
      CONTINUE.
    ENDIF.
  ENDLOOP.

  APPEND LINES OF gt_outtab2_aux TO gt_outtab2.
  APPEND LINES OF gt_outtab3_aux TO gt_outtab3.

  SORT gt_outtab1 BY werks matnr charg werks_apl matnr_apl.
  SORT gt_outtab2 BY werks matnr charg werks_apl matnr_apl.
  SORT gt_outtab3 BY werks matnr charg werks_apl matnr_apl.

  FREE: lit_result, lit_makt, lit_lfa1.
ENDFORM.                    " F_ANALISA_APLICACAO_ESTOQUE
