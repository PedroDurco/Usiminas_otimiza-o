*&---------------------------------------------------------------------*
FORM f_seleciona_caract_charg .
  TYPES: BEGIN OF ty_inspecao,
           insp TYPE ausp-atwrt,
         END OF ty_inspecao,

         BEGIN OF ty_objek,
           objek TYPE inob-objek,
         END OF ty_objek,

         BEGIN OF ty_ausp,
           objek TYPE ausp-objek,
           atinn TYPE ausp-atinn,
           atzhl TYPE ausp-atzhl,
           mafid TYPE ausp-mafid,
           klart TYPE ausp-klart,
           adzhl TYPE ausp-adzhl,
           atwrt TYPE ausp-atwrt,
           atflv TYPE ausp-atflv,
           matnr TYPE mara-matnr,
           charg TYPE mchb-charg,
         END OF ty_ausp,

         BEGIN OF ty_inob,
           objek TYPE inob-objek,
           cuobj TYPE inob-cuobj,
         END OF ty_inob,

         BEGIN OF ty_cabn,
           atinn TYPE cabn-atinn,
           atnam TYPE cabn-atnam,
           atfor TYPE cabn-atfor,
         END OF ty_cabn,

         BEGIN OF ty_cawn,
           atinn TYPE  cawn-atinn,
           atwrt TYPE  cawn-atwrt,
           atzhl TYPE  cawn-atzhl,
           adzhl TYPE  cawn-adzhl,
         END OF ty_cawn,

         BEGIN OF ty_cawnt,
           atinn TYPE  cawnt-atinn,
           atzhl TYPE  cawnt-atzhl,
           adzhl TYPE  cawnt-adzhl,
           atwtb TYPE  cawnt-atwtb,
         END OF ty_cawnt.

  DATA: lit_zppt_mchb_caract TYPE TABLE OF zppt_mchb_caract,
        lit_mchb_caract_insp TYPE TABLE OF zppt_mchb_caract,
        lit_inspecao         TYPE TABLE OF ty_inspecao,
        lit_matnr_objek      TYPE TABLE OF ty_objek,
        lit_charg_objek      TYPE TABLE OF ty_objek,
        lit_charg_ausp       TYPE TABLE OF ty_ausp,
        lit_objek_ausp       TYPE TABLE OF ty_ausp,
        lit_ausp             TYPE TABLE OF ty_ausp,
        lit_ausp_aux         TYPE TABLE OF ty_ausp,
        lit_inob             TYPE TABLE OF ty_inob,
        lit_cabn             TYPE TABLE OF ty_cabn,
        lit_cawn             TYPE TABLE OF ty_cawn,
        lit_cawnt            TYPE TABLE OF ty_cawnt,
        lit_keys_selopt      TYPE TABLE OF rsdsselopt.

  DATA: lwa_inspecao    TYPE ty_inspecao,
        lwa_atinn       TYPE zsusde_caract_int,
        lwa_keys_selopt TYPE rsdsselopt.

  DATA: lv_objek TYPE inob-objek,
        lv_count TYPE sy-tabix.

  FIELD-SYMBOLS: <fs_zppt_mchb_caract> TYPE zppt_mchb_caract,
                 <fs_matnr_objek>      TYPE ty_objek,
                 <fs_charg_objek>      TYPE ty_objek,
                 <fs_inob>             TYPE ty_inob,
                 <fs_atinn>            TYPE zsusde_caract_int,
                 <fs_ausp>             TYPE ty_ausp,
                 <fs_charg_ausp>       TYPE ty_ausp,
                 <fs_cabn>             TYPE ty_cabn,
                 <fs_cawn>             TYPE ty_cawn,
                 <fs_cawnt>            TYPE ty_cawnt,
                 <fs_caract_charg>     LIKE LINE OF it_caract_charg.

  RANGES: r_atinn FOR zsusde_caract_int.

  cl_progress_indicator=>progress_indicate(
    i_text = 'Selecionando as caract dos Estoques...'
    i_output_immediately = abap_true ).

  REFRESH:  it_inspecao_mp,
            it_caract_charg.

  SELECT *
    FROM zppt_mchb_caract
    INTO TABLE lit_zppt_mchb_caract
     FOR ALL ENTRIES IN it_mchbcar
   WHERE matnr EQ it_mchbcar-matnr
     AND charg EQ it_mchbcar-charg.

  "Para materiais Acabados ou Semi Acabados
  "o sistema terá que obter as caract da Materia-Prima utilizada
  "para consistir a Prova de Erro
  lit_mchb_caract_insp[] = lit_zppt_mchb_caract[].
  DELETE lit_mchb_caract_insp WHERE matnr BETWEEN '10000000' AND '12999999' OR
                                    matnr BETWEEN '71000000' AND '71999999'. "RDM 271193
  IF lit_mchb_caract_insp[] IS NOT INITIAL.
    LOOP AT lit_mchb_caract_insp ASSIGNING <fs_zppt_mchb_caract>.
      "INSPECAO 1
      IF <fs_zppt_mchb_caract>-sd_numero_inspecao_1 IS NOT INITIAL.
        lwa_inspecao-insp = lcl_prog=>split_single( <fs_zppt_mchb_caract>-sd_numero_inspecao_1 ).
        IF lwa_inspecao-insp IS NOT INITIAL AND lwa_inspecao-insp NE '-'.
          APPEND lwa_inspecao TO lit_inspecao.
        ENDIF.
      ENDIF.

      "INSPECAO 2
      IF <fs_zppt_mchb_caract>-sd_numero_inspecao_2 IS NOT INITIAL.
        lwa_inspecao-insp = lcl_prog=>split_single( <fs_zppt_mchb_caract>-sd_numero_inspecao_2 ).
        IF lwa_inspecao-insp IS NOT INITIAL AND lwa_inspecao-insp NE '-'.
          APPEND lwa_inspecao TO lit_inspecao.
        ENDIF.
      ENDIF.

      "INSPECAO 3
      IF <fs_zppt_mchb_caract>-sd_numero_inspecao_3 IS NOT INITIAL.
        lwa_inspecao-insp = lcl_prog=>split_single( <fs_zppt_mchb_caract>-sd_numero_inspecao_3 ).
        IF lwa_inspecao-insp IS NOT INITIAL AND lwa_inspecao-insp NE '-'.
          APPEND lwa_inspecao TO lit_inspecao.
        ENDIF.
      ENDIF.

      "INSPECAO 4
      IF <fs_zppt_mchb_caract>-sd_numero_inspecao_4 IS NOT INITIAL.
        lwa_inspecao-insp = lcl_prog=>split_single( <fs_zppt_mchb_caract>-sd_numero_inspecao_4 ).
        IF lwa_inspecao-insp IS NOT INITIAL AND lwa_inspecao-insp NE '-'.
          APPEND lwa_inspecao TO lit_inspecao.
        ENDIF.
      ENDIF.

      "INSPECAO 5
      IF <fs_zppt_mchb_caract>-sd_numero_inspecao_5 IS NOT INITIAL.
        lwa_inspecao-insp = lcl_prog=>split_single( <fs_zppt_mchb_caract>-sd_numero_inspecao_5 ).
        IF lwa_inspecao-insp IS NOT INITIAL AND lwa_inspecao-insp NE '-'.
          APPEND lwa_inspecao TO lit_inspecao.
        ENDIF.
      ENDIF.

      "INSPECAO 6
      IF <fs_zppt_mchb_caract>-sd_numero_inspecao_6 IS NOT INITIAL.
        lwa_inspecao-insp = lcl_prog=>split_single( <fs_zppt_mchb_caract>-sd_numero_inspecao_6 ).
        IF lwa_inspecao-insp IS NOT INITIAL AND lwa_inspecao-insp NE '-'.
          APPEND lwa_inspecao TO lit_inspecao.
        ENDIF.
      ENDIF.
    ENDLOOP.

    IF lit_inspecao[] IS NOT INITIAL.
      SORT lit_inspecao BY insp.
      DELETE ADJACENT DUPLICATES FROM lit_inspecao COMPARING insp.

      SELECT inspecao matnr charg
        FROM zppt_inspecao
        INTO CORRESPONDING FIELDS OF TABLE it_inspecao_mp
        FOR ALL ENTRIES IN lit_inspecao
        WHERE inspecao EQ lit_inspecao-insp.
    ENDIF.
  ENDIF.

  SORT lit_zppt_mchb_caract BY matnr charg.

  LOOP AT it_mchbcar ASSIGNING FIELD-SYMBOL(<fs_mchbcar>).
    READ TABLE lit_zppt_mchb_caract ASSIGNING <fs_zppt_mchb_caract>
                                    WITH KEY matnr = <fs_mchbcar>-matnr
                                             charg = <fs_mchbcar>-charg
                                             BINARY SEARCH.
    IF sy-subrc IS INITIAL.
      "SD_NUMERO_INSPECAO
      INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
      <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
      <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
      <fs_caract_charg>-atnam = 'SD_NUMERO_INSPECAO'.
      <fs_caract_charg>-atwrt = <fs_zppt_mchb_caract>-sd_numero_inspecao_1.

      IF <fs_zppt_mchb_caract>-sd_numero_inspecao_2 IS NOT INITIAL.
        INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
        <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
        <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
        <fs_caract_charg>-atnam = 'SD_NUMERO_INSPECAO'.
        <fs_caract_charg>-atwrt = <fs_zppt_mchb_caract>-sd_numero_inspecao_2.
      ENDIF.

      IF <fs_zppt_mchb_caract>-sd_numero_inspecao_3 IS NOT INITIAL.
        INSERT INITIAL LINE INTO TABLE it_caract_charg ASSIGNING <fs_caract_charg>.
        <fs_caract_charg>-matnr = <fs_zppt_mchb_caract>-matnr.
        <fs_caract_charg>-charg = <fs_zppt_mchb_caract>-charg.
        <fs_caract_charg>-atnam = 'SD_NUMERO_INSPECAO'.
        <fs_caract_charg>-atwrt = <fs_zppt_mchb_caract>-sd_numero_inspecao_3.
      ENDIF.

      IF <fs_zppt_mchb_caract>-sd_numero_inspecao_4 IS NOT INITIAL.
