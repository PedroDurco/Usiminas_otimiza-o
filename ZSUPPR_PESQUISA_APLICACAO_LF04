*&---------------------------------------------------------------------*
*&      Form  F_CHECK_LOTE_RESERVADO
*&---------------------------------------------------------------------*
FORM f_check_lote_reservado CHANGING p_wa_mchbcar LIKE wa_outtab
                                     p_xloek.
  CLEAR wa_resb.

  " Filter batches reserved for production
  READ TABLE it_resb_261 INTO wa_resb
        WITH KEY werks = p_wa_mchbcar-werks
                 matnr = p_wa_mchbcar-matnr
                 charg = p_wa_mchbcar-charg
                 BINARY SEARCH.
  IF sy-subrc IS INITIAL.
    p_wa_mchbcar-bdmng_reserv = wa_resb-bdmng - wa_resb-enmng.

    READ TABLE it_resb_231 INTO wa_resb_231
        WITH KEY werks = p_wa_mchbcar-werks
                 matnr = p_wa_mchbcar-matnr
                 charg = p_wa_mchbcar-charg
                 BINARY SEARCH.
    IF sy-subrc IS INITIAL.
      p_wa_mchbcar-bdmng_reserv = p_wa_mchbcar-bdmng_reserv + ( wa_resb_231-bdmng - wa_resb_231-enmng ).
    ENDIF.

    p_xloek = 'X'.
    RETURN.
  ENDIF.

  " Filter batches reserved for Requisition
  READ TABLE it_resb_bext INTO wa_resb
        WITH KEY matnr = p_wa_mchbcar-matnr
                 charg = p_wa_mchbcar-charg
                 BINARY SEARCH.
  IF sy-subrc IS INITIAL.
    READ TABLE it_mslb INTO DATA(wl_mslb) WITH KEY matnr = p_wa_mchbcar-matnr
                                                   charg = p_wa_mchbcar-charg.
    IF sy-subrc EQ 0.
      p_wa_mchbcar-bdmng_reserv = wl_mslb-lblab.
    ENDIF.
    p_xloek = 'X'.
    RETURN.
  ENDIF.

  " Filter batches reserved for other orders
  READ TABLE it_resb_231 INTO wa_resb
        WITH KEY werks = p_wa_mchbcar-werks
                 matnr = p_wa_mchbcar-matnr
                 charg = p_wa_mchbcar-charg
                 BINARY SEARCH.
  IF sy-subrc IS INITIAL.

    p_xloek = 'X'.

    p_wa_mchbcar-bdmng_reserv = wa_resb-bdmng - wa_resb-enmng.

    READ TABLE it_resb_261 INTO wa_resb_261
          WITH KEY werks = p_wa_mchbcar-werks
                   matnr = p_wa_mchbcar-matnr
                   charg = p_wa_mchbcar-charg
                   BINARY SEARCH.
    IF sy-subrc IS INITIAL.
      p_wa_mchbcar-bdmng_reserv = p_wa_mchbcar-bdmng_reserv + ( wa_resb_261-bdmng - wa_resb_261-enmng ).
    ENDIF.

    RETURN.
  ENDIF.

  READ TABLE it_lista_alt TRANSPORTING NO FIELDS
                          WITH KEY matnr = p_wa_mchbcar-matnr
                                   charg = p_wa_mchbcar-charg
                                   BINARY SEARCH.
  IF sy-subrc IS INITIAL.
    p_xloek = 'X'.
    RETURN.
  ENDIF.
ENDFORM.                    " F_CHECK_LOTE_RESERVADO
*&---------------------------------------------------------------------*
*&      Form  F_CLASSIFICA_LOG
*&---------------------------------------------------------------------*
FORM f_classifica_log  CHANGING p_outtab TYPE ty_outtab
                                p_restrito.
  IF p_outtab-xloek EQ 'P' OR
     p_outtab-xloek EQ 'T'.
    p_restrito = ''.
    RETURN.
  ENDIF.

*PM - Capabilidade - PRJ1372 - 15.03.2022
  IF p_outtab-xloek EQ 'E' OR
     p_outtab-xloek EQ 'C' OR
     p_outtab-xloek EQ 'M' OR
     p_outtab-xloek EQ 'R' OR
     p_outtab-xloek EQ 'A' OR
     p_outtab-xloek EQ 'O'.                                 "RDM 324713
    CLEAR p_outtab-xloek.
    p_restrito = ''.
    RETURN.
  ENDIF.
*PM - Capabilidade - PRJ1372 - 15.03.2022

  FIND 'TOYOTA' IN wa_outtab-statustxt.
  IF sy-subrc IS INITIAL.
    wa_outtab-icon_stt = icon_yellow_light.
    p_restrito = ''.
    RETURN.
  ENDIF.

  FIND 'RESERVA' IN wa_outtab-statustxt.
  IF sy-subrc IS INITIAL.
    wa_outtab-icon_stt = icon_yellow_light.
    p_restrito = ''.
    RETURN.
  ENDIF.

  FIND 'DIMENSIONAL' IN wa_outtab-statustxt.
  IF sy-subrc IS INITIAL AND p_outtab-xloek NE 'D'.
    wa_outtab-icon_stt = icon_yellow_light.
    p_restrito = ''.
    RETURN.
  ENDIF.

  FIND 'ANALISE USINA' IN wa_outtab-statustxt.
  IF sy-subrc IS INITIAL AND p_outtab-xloek NE 'D'.
    wa_outtab-icon_stt = icon_yellow_light.
    p_restrito = ''.
    RETURN.
  ENDIF.

  FIND 'EM APROVAÇAO' IN wa_outtab-statustxt.
  IF sy-subrc IS INITIAL AND p_outtab-xloek NE 'D'.
    wa_outtab-icon_stt = icon_yellow_light.
    p_restrito = ''.
    RETURN.
  ENDIF.
  p_restrito = 'X'.
ENDFORM.                    " F_CLASSIFICA_LOG
*&---------------------------------------------------------------------*
*&      Form  F_CONSISTE_CERTIFICADO
*&---------------------------------------------------------------------*
FORM f_consiste_certificado  USING  p_werks
                                    p_matnr
                                    p_mtart
                                    p_lgpro
                                    p_wa_mchbcar LIKE wa_mchbcar
                                    p_charg_qualidade
                                    p_matnr_qualidade.
  IF p_mtart EQ 'ZFEJ'.
    SELECT SINGLE kunnr
      INTO @DATA(lv_kunnr)
      FROM zsdt_pncentro
     WHERE matnr     EQ @p_matnr
       AND werks     EQ @p_werks
       AND zf_status EQ 'A'.
    IF sy-subrc IS INITIAL.
      READ TABLE it_ztmmsu_controle TRANSPORTING NO FIELDS WITH KEY werks = p_werks
                                                                    lgort = p_lgpro
                                                                    repid = sy-cprog
                                                                    kunnr = lv_kunnr.
      IF sy-subrc IS INITIAL.
        IF p_charg_qualidade EQ p_matnr_qualidade.
          RETURN.
        ELSE.
          MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
          wa_result-werks_apl = p_werks.
          wa_result-matnr_apl = p_matnr.
          wa_result-log       = 'Cliente não aceita material alternativo'.
          wa_result-xloek     = 'A'.
          APPEND wa_result TO it_result.
          CLEAR wa_result.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.
ENDFORM.                    " F_CONSISTE_CERTIFICADO
