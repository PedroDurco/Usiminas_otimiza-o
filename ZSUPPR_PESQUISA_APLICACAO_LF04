*&      Form  F_SOLICITAR_APROVACAO
*&---------------------------------------------------------------------*
FORM f_solicitar_aprovacao .
  DATA: lwa_pajt TYPE zppt_pajt,
        lwa_oest TYPE zppt_oest,
        lv_seq   TYPE zppt_pajt-seq.

  DATA ls_selrow  TYPE lvc_s_row.
  DATA ls_selrow_aux  TYPE lvc_s_row.

  REFRESH gt_rows.
  IF g_tab_appl-subscreen = '0101'.
    gr_table1->get_selected_rows( IMPORTING et_index_rows = gt_rows ).
  ELSEIF g_tab_appl-subscreen = '0102'.
    gr_table2->get_selected_rows( IMPORTING et_index_rows = gt_rows ).
  ELSE.
    gr_table3->get_selected_rows( IMPORTING et_index_rows = gt_rows ).
  ENDIF.

  IF gt_rows[] IS INITIAL.
    MESSAGE e000(su) WITH text-m03.
  ELSE.
    CLEAR gt_rows_aux[].
    LOOP AT gt_rows INTO ls_selrow.
      IF g_tab_appl-subscreen EQ '0101'.
        READ TABLE gt_outtab1 INTO wa_outtab INDEX ls_selrow-index.

        LOOP AT gt_outtab1 INTO DATA(ls_outtab1) WHERE matnr     = wa_outtab-matnr
                                                   AND charg     = wa_outtab-charg
                                                   AND matnr_apl = wa_outtab-matnr_apl
                                                   AND werks_apl = wa_outtab-werks_apl.
          ls_outtab1-bdmng = wa_outtab-bdmng.
          MODIFY gt_outtab1 FROM ls_outtab1 INDEX sy-tabix.
          ls_selrow_aux-index = sy-tabix.
          APPEND ls_selrow_aux TO gt_rows_aux.
        ENDLOOP.
      ELSEIF g_tab_appl-subscreen = '0102'.
        READ TABLE gt_outtab2 INTO wa_outtab INDEX ls_selrow-index.

        LOOP AT gt_outtab2 INTO DATA(ls_outtab2) WHERE matnr     = wa_outtab-matnr
                                                   AND charg     = wa_outtab-charg
                                                   AND matnr_apl = wa_outtab-matnr_apl
                                                   AND werks_apl = wa_outtab-werks_apl.
          ls_outtab2-bdmng = wa_outtab-bdmng.
          MODIFY gt_outtab2 FROM ls_outtab2 INDEX sy-tabix.
          ls_selrow_aux-index = sy-tabix.
          APPEND ls_selrow_aux TO gt_rows_aux.
        ENDLOOP.
      ELSE.
        READ TABLE gt_outtab3 INTO wa_outtab INDEX ls_selrow-index.
        LOOP AT gt_outtab3 INTO DATA(ls_outtab3) WHERE matnr     = wa_outtab-matnr
                                                   AND charg     = wa_outtab-charg
                                                   AND matnr_apl = wa_outtab-matnr_apl
                                                   AND werks_apl = wa_outtab-werks_apl.
          ls_outtab3-bdmng = wa_outtab-bdmng.
          MODIFY gt_outtab3 FROM ls_outtab3 INDEX sy-tabix.
          ls_selrow_aux-index = sy-tabix.
          APPEND ls_selrow_aux TO gt_rows_aux.
        ENDLOOP.
      ENDIF.

      IF wa_outtab-bdmng  IS INITIAL.
        MESSAGE 'Existe alternativo sem indicação da Qtd.Liberada' TYPE 'S' DISPLAY LIKE 'E'.
        RETURN.
      ELSE.
        IF wa_outtab-clabs EQ 0 AND wa_outtab-bdmng > wa_outtab-bdmng_reserv.
          MESSAGE 'Qtd.Lib não pode ser maior que a reservada' TYPE 'S' DISPLAY LIKE 'E'.
          RETURN.
        ENDIF.

        IF wa_outtab-bdmng > wa_outtab-clabs AND wa_outtab-clabs NE 0.
          MESSAGE 'Qtd.Lib não pode ser maior que a Util.livre' TYPE 'S' DISPLAY LIKE 'E'.
          RETURN.
        ENDIF.
      ENDIF.
    ENDLOOP.

    CLEAR gt_rows[].
    SORT gt_rows_aux BY index.
    DELETE ADJACENT DUPLICATES FROM gt_rows_aux COMPARING index.
    APPEND LINES OF gt_rows_aux TO gt_rows.

    LOOP AT gt_rows INTO ls_selrow.
      IF g_tab_appl-subscreen = '0101'.
        READ TABLE gt_outtab1 INTO wa_outtab INDEX ls_selrow-index.
      ELSEIF g_tab_appl-subscreen = '0102'.
        READ TABLE gt_outtab2 INTO wa_outtab INDEX ls_selrow-index.
      ELSE.
        READ TABLE gt_outtab3 INTO wa_outtab INDEX ls_selrow-index.
      ENDIF.

      IF NOT sy-subrc IS INITIAL.
        CONTINUE.
      ELSE.
        wa_outtab-mark = 'X'.
        IF g_tab_appl-subscreen = '0101'.
          MODIFY gt_outtab1 FROM wa_outtab INDEX sy-tabix TRANSPORTING mark.
        ELSEIF g_tab_appl-subscreen = '0102'.
          MODIFY gt_outtab2 FROM wa_outtab INDEX sy-tabix TRANSPORTING mark.
        ELSE.
          MODIFY gt_outtab3 FROM wa_outtab INDEX sy-tabix TRANSPORTING mark.
        ENDIF.
      ENDIF.

      "Adicionar Registro na ZPPT_PAJT
      SELECT MAX( seq )
        FROM zppt_pajt
        INTO lv_seq
        WHERE cprog EQ 'ZSUPPR_PROCESSA_SOLICITACAO_MP'.

      ADD 1 TO lv_seq.
      MOVE-CORRESPONDING wa_outtab TO lwa_pajt.
      lwa_pajt-clabs    = wa_outtab-bdmng.
      IF wa_outtab-bdmng < wa_outtab-clabs.
        lwa_pajt-resbp = 'X'. "Reserva parcial do lote
      ELSE.
        lwa_pajt-resbp = ''.
      ENDIF.
      lwa_pajt-cprog    = 'ZSUPPR_PROCESSA_SOLICITACAO_MP'.
      lwa_pajt-ernam    = sy-uname.
      lwa_pajt-seq      = lv_seq.
      lwa_pajt-erdat    = sy-datum.
      lwa_pajt-erzet    = sy-uzeit.
      lwa_pajt-usuario  = sy-uname.
      lwa_pajt-data     = sy-datum.
      lwa_pajt-hora     = sy-uzeit.
      INSERT zppt_pajt FROM lwa_pajt.
      COMMIT WORK.

      "Adicionar registro na ZPPT_OEST
      SELECT MAX( seq )
        FROM zppt_oest
        INTO lv_seq
        WHERE cprog EQ 'ZSUPPR_PROCESSA_SOLICITACAO_MP'.

      ADD 1 TO lv_seq.
      MOVE-CORRESPONDING wa_outtab TO lwa_oest.
      lwa_oest-clabs    = wa_outtab-bdmng.
      IF wa_outtab-bdmng < wa_outtab-clabs.
        lwa_oest-resbp = 'X'. "Reserva parcial do lote
      ELSE.
        lwa_oest-resbp = ''.
      ENDIF.
      lwa_oest-seq       = lv_seq.
      lwa_oest-cprog     = 'ZSUPPR_PROCESSA_SOLICITACAO_MP'.
      lwa_oest-clabs     = wa_outtab-bdmng.
      lwa_oest-usuario   = sy-uname.
      lwa_oest-data      = sy-datum.
      lwa_oest-cputm     = sy-uzeit.
      INSERT zppt_oest FROM lwa_oest.
      COMMIT WORK.
      CLEAR: wa_outtab.
    ENDLOOP.

    IF g_tab_appl-subscreen = '0101'.
      DELETE gt_outtab1 WHERE mark = 'X'.
      gr_table1->refresh_table_display( ).
    ELSEIF g_tab_appl-subscreen = '0102'.
      DELETE gt_outtab2 WHERE mark = 'X'.
      gr_table2->refresh_table_display( ).
    ELSE.
      DELETE gt_outtab3 WHERE mark = 'X'.
      gr_table3->refresh_table_display( ).
    ENDIF.
  ENDIF.
ENDFORM.                    " F_SOLICITAR_APROVACAO
