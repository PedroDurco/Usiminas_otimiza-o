*&      Form  F_SELECIONA_ESTOQUES
*&---------------------------------------------------------------------*
FORM f_seleciona_estoques .
  DATA lit_mchbcar TYPE TABLE OF zrnsdt_mchbcar.
  DATA lv_data_estoque TYPE sy-datum.
  FIELD-SYMBOLS: <fs_mslb>    TYPE mslb,
                 <fs_mchbcar> TYPE zrnsdt_mchbcar.

  cl_progress_indicator=>progress_indicate( i_text = 'Selecionando os Estoques...'
                                            i_output_immediately = abap_true ).

  REFRESH:  it_mchbcar,
            it_mslb,
            it_lista_alt,
            it_pajt_sol_mp.

  SELECT matnr werks lgort charg espessura largura clabs
    INTO CORRESPONDING FIELDS OF TABLE it_mchbcar
    FROM zrnsdt_mchbcar
    WHERE charg IN s_charg
      AND werks IN s_ewrks       "12/05/2026 - Nic-Labs - Filtro Centro Estoque
      AND lgort IN s_elgrt       "12/05/2026 - Nic-Labs - Filtro Depósito Estoque
      AND clabs GE gv_estoque_minimo.

  "estoque especial
  SELECT matnr werks charg sobkz lifnr lblab
    INTO CORRESPONDING FIELDS OF TABLE it_mslb
    FROM mslb
   WHERE charg IN s_charg
     AND werks IN s_ewrks       "12/05/2026 - Nic-Labs - Filtro Centro Estoque
     AND lblab GE gv_estoque_minimo.
  IF sy-subrc IS INITIAL.
    LOOP AT it_mslb ASSIGNING <fs_mslb>.
      MOVE-CORRESPONDING <fs_mslb> TO wa_mchbcar.
      MOVE <fs_mslb>-lblab TO wa_mchbcar-clabs.
      PERFORM f_get_stock_lgort USING wa_mchbcar-charg wa_mchbcar-matnr wa_mchbcar-werks
                                CHANGING wa_mchbcar-lgort.
      APPEND wa_mchbcar TO it_mchbcar.
    ENDLOOP.
  ENDIF.

  DELETE it_mchbcar WHERE matnr NOT BETWEEN '12000000' AND '12999999' AND
                          matnr NOT BETWEEN '54000000' AND '54999999' AND
                          matnr NOT BETWEEN '34000000' AND '34999999' AND
                          matnr NOT BETWEEN '10000000' AND '11999999' AND "RDM 271193
                          matnr NOT BETWEEN '50000000' AND '59999999' AND "RDM 271193
                          matnr NOT BETWEEN '71000000' AND '71999999'. "RDM 271193

  "Registro do otimizador que está pendente de aprovação não é relevante para aplicação e consulta
  SELECT *
    FROM zppt_oest
    INTO TABLE @DATA(tl_oest)
   WHERE cprog EQ 'ZPPR_PROCESSA_NECESSIDADE_MP'.
  IF sy-subrc EQ 0.
    SORT tl_oest BY matnr charg.
    DELETE ADJACENT DUPLICATES FROM tl_oest COMPARING matnr charg.
    LOOP AT tl_oest INTO DATA(wl_oest).
      DELETE it_mchbcar WHERE matnr EQ wl_oest-matnr
                          AND charg EQ wl_oest-charg.
    ENDLOOP.
  ENDIF.

  "Regra para ESTOQUE ACABADOU OU SEMI-ACABADO:
  "considerar somente lotes estocados a mais de 90 dias.
  lit_mchbcar[] = it_mchbcar[].
  DELETE lit_mchbcar WHERE matnr BETWEEN '12000000' AND '12999999' AND
                           matnr BETWEEN '10000000' AND '11999999' AND "RDM 271193
                           matnr BETWEEN '71000000' AND '71999999'. "RDM 271193

  IF lit_mchbcar[] IS NOT INITIAL.
    lv_data_estoque = sy-datum - 90.
    LOOP AT lit_mchbcar ASSIGNING <fs_mchbcar>.
      IF <fs_mchbcar>-ersda > lv_data_estoque.
        DELETE it_mchbcar WHERE matnr EQ <fs_mchbcar>-matnr AND
                                charg EQ <fs_mchbcar>-charg.
      ENDIF.
    ENDLOOP.
  ENDIF.

  FREE lit_mchbcar.
ENDFORM.                    " F_SELECIONA_ESTOQUES
*&---------------------------------------------------------------------*
*& 12/05/2026 - Nic-Labs - Filtros adicionais MCHB
*&      Form  F_FILTRA_ESTOQUES_MCHB
*&---------------------------------------------------------------------*
*  Quando LGORT do estoque (s_elgrt) for preenchido:
*  - MCHB-WERKS = MARC-WERKS (ambos centros iguais)
*  - LGORT somente 0089, 0080, 1018, 1017, 1020
*  - MATNR não inicie com "00"
*  - CLABS > 1
*  - 1º Filtro: descartar lotes com reserva ativa (RESB)
*  - 2º Filtro: cruzar com ZRNPPT_OV_SEPARA (manter STATUS <> vazio)
*  - 3º Filtro: cruzar com ZPPT_GD_MODELOS
*----------------------------------------------------------------------*
FORM f_filtra_estoques_mchb .

  TYPES: BEGIN OF ty_mchb_filt,
           werks TYPE mchb-werks,
           matnr TYPE mchb-matnr,
           charg TYPE mchb-charg,
           lgort TYPE mchb-lgort,
           clabs TYPE mchb-clabs,
         END OF ty_mchb_filt.

  DATA: lt_mchb_filt TYPE STANDARD TABLE OF ty_mchb_filt,
        ls_mchb_filt TYPE ty_mchb_filt.

  DATA: lr_lgort_valido  TYPE RANGE OF mchb-lgort.

  cl_progress_indicator=>progress_indicate(
    i_text = 'Aplicando filtros adicionais MCHB...'
    i_output_immediately = abap_true ).

  "--- Depósitos permitidos: 0089, 0080, 1018, 1017, 1020 ---
  lr_lgort_valido = VALUE #(
    ( sign = 'I' option = 'EQ' low = '0089' )
    ( sign = 'I' option = 'EQ' low = '0080' )
    ( sign = 'I' option = 'EQ' low = '1018' )
    ( sign = 'I' option = 'EQ' low = '1017' )
    ( sign = 'I' option = 'EQ' low = '1020' )
  ).

  "--- Filtrar it_mchbcar: somente depósitos permitidos ---
  DELETE it_mchbcar WHERE lgort NOT IN lr_lgort_valido.

  "--- MATNR não inicie com '00' ---
  DELETE it_mchbcar WHERE matnr(2) = '00'.

  "--- CLABS > 1 ---
  DELETE it_mchbcar WHERE clabs <= 1.

  "--- MCHB-WERKS = MARC-WERKS: manter somente lotes onde o centro
  "    do estoque seja igual ao centro da aplicação ---
  SORT it_marc BY werks.
  DATA lt_mchbcar_temp LIKE it_mchbcar.
  lt_mchbcar_temp = it_mchbcar.
  LOOP AT lt_mchbcar_temp INTO wa_mchbcar.
    READ TABLE it_marc WITH KEY werks = wa_mchbcar-werks
                       BINARY SEARCH TRANSPORTING NO FIELDS.
    IF sy-subrc NE 0.
      DELETE it_mchbcar WHERE werks = wa_mchbcar-werks
                          AND matnr = wa_mchbcar-matnr
                          AND charg = wa_mchbcar-charg.
    ENDIF.
  ENDLOOP.
  FREE lt_mchbcar_temp.

  CHECK it_mchbcar[] IS NOT INITIAL.

  "--- 1º Filtro: RESB (Reservas em aberto) ---
  "    Descartar lotes com reserva ativa
  cl_progress_indicator=>progress_indicate(
    i_text = 'Filtro 1: Verificando reservas ativas (RESB)...'
    i_output_immediately = abap_true ).

  SELECT werks, lgort, charg
    FROM resb
    INTO TABLE @DATA(lt_resb_check)
    FOR ALL ENTRIES IN @it_mchbcar
    WHERE werks EQ @it_mchbcar-werks
      AND lgort EQ @it_mchbcar-lgort
      AND charg EQ @it_mchbcar-charg
      AND xloek EQ @abap_false
      AND kzear EQ @abap_false.
  IF sy-subrc EQ 0.
    SORT lt_resb_check BY werks lgort charg.
    DELETE ADJACENT DUPLICATES FROM lt_resb_check COMPARING werks lgort charg.
    LOOP AT lt_resb_check INTO DATA(ls_resb_chk).
      DELETE it_mchbcar WHERE werks = ls_resb_chk-werks
                          AND lgort = ls_resb_chk-lgort
                          AND charg = ls_resb_chk-charg.
    ENDLOOP.
  ENDIF.

  CHECK it_mchbcar[] IS NOT INITIAL.

  "--- 2º Filtro: ZRNPPT_OV_SEPARA ---
  "    Manter somente registros onde STATUS <> vazio
  cl_progress_indicator=>progress_indicate(
    i_text = 'Filtro 2: Verificando separação (ZRNPPT_OV_SEPARA)...'
    i_output_immediately = abap_true ).

  SELECT werks, charg, lgort
    FROM zrnppt_ov_separa
    INTO TABLE @DATA(lt_ov_separa)
    FOR ALL ENTRIES IN @it_mchbcar
    WHERE werks  EQ @it_mchbcar-werks
      AND charg  EQ @it_mchbcar-charg
      AND lgort  EQ @it_mchbcar-lgort
      AND status NE @abap_false.
  IF sy-subrc EQ 0.
    SORT lt_ov_separa BY werks charg lgort.
    DELETE ADJACENT DUPLICATES FROM lt_ov_separa COMPARING werks charg lgort.
    "Manter em it_mchbcar somente os que existem em lt_ov_separa
    DATA lt_mchbcar_keep LIKE it_mchbcar.
    LOOP AT it_mchbcar INTO wa_mchbcar.
      READ TABLE lt_ov_separa WITH KEY werks = wa_mchbcar-werks
                                       charg = wa_mchbcar-charg
                                       lgort = wa_mchbcar-lgort
                              BINARY SEARCH TRANSPORTING NO FIELDS.
      IF sy-subrc EQ 0.
        APPEND wa_mchbcar TO lt_mchbcar_keep.
      ENDIF.
    ENDLOOP.
    it_mchbcar[] = lt_mchbcar_keep[].
    FREE lt_mchbcar_keep.
  ELSE.
    "Se não encontrou nenhum registro com STATUS preenchido, descartar tudo
    REFRESH it_mchbcar.
  ENDIF.

  CHECK it_mchbcar[] IS NOT INITIAL.

  "--- 3º Filtro: ZPPT_GD_MODELOS ---
  "    PREV_ORG > 0 OU PERIODO_1 > 0
  "    DIAS_ESTOQUE <= 60
  "    PRODUTO <> BLANK
  cl_progress_indicator=>progress_indicate(
    i_text = 'Filtro 3: Verificando modelos GD (ZPPT_GD_MODELOS)...'
    i_output_immediately = abap_true ).

  SELECT matnr, werks, prev_org, periodo_1
    FROM zppt_gd_modelos
    INTO TABLE @DATA(lt_gd_modelos)
    FOR ALL ENTRIES IN @it_mchbcar
    WHERE matnr        EQ @it_mchbcar-matnr
      AND werks        EQ @it_mchbcar-werks
      AND dias_estoque LE 60
      AND produto      NE @abap_false.
  IF sy-subrc EQ 0.
    "Filtrar: manter somente onde PREV_ORG > 0 OU PERIODO_1 > 0
    DELETE lt_gd_modelos WHERE prev_org <= 0 AND periodo_1 <= 0.

    IF lt_gd_modelos[] IS NOT INITIAL.
      SORT lt_gd_modelos BY matnr werks.
      DELETE ADJACENT DUPLICATES FROM lt_gd_modelos COMPARING matnr werks.
      "Manter em it_mchbcar somente os que existem em lt_gd_modelos
      DATA lt_mchbcar_gd LIKE it_mchbcar.
      LOOP AT it_mchbcar INTO wa_mchbcar.
        READ TABLE lt_gd_modelos WITH KEY matnr = wa_mchbcar-matnr
                                          werks = wa_mchbcar-werks
                                 BINARY SEARCH TRANSPORTING NO FIELDS.
        IF sy-subrc EQ 0.
          APPEND wa_mchbcar TO lt_mchbcar_gd.
        ENDIF.
      ENDLOOP.
      it_mchbcar[] = lt_mchbcar_gd[].
      FREE lt_mchbcar_gd.
    ELSE.
      REFRESH it_mchbcar.
    ENDIF.
  ELSE.
    REFRESH it_mchbcar.
  ENDIF.

ENDFORM.                    " F_FILTRA_ESTOQUES_MCHB
