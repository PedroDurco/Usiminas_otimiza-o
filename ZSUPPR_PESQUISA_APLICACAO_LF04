*&      Form  F_SUGESTAO_APROVEITAMENTO
*&---------------------------------------------------------------------*
*       Sugestão de Aproveitamento SU - sistema PA Usiminas
*----------------------------------------------------------------------*
FORM f_sugestao_aproveitamento USING p_idnrk
                                     p_wa_mchbcar LIKE wa_mchbcar
                            CHANGING p_lines.
  DATA lv_pe_ok TYPE c.

  LOOP AT it_vsamp_pa INTO wa_vsamp_pa WHERE nr_lote        = p_wa_mchbcar-charg
                                         AND ds_simbolo_sug = p_idnrk.
    MOVE-CORRESPONDING p_wa_mchbcar TO wa_result.
    wa_result-werks_apl = wa_marc-werks.
    wa_result-matnr_apl = wa_marc-matnr.
    IF wa_vsamp_pa-st_sugestao NE 'VINCULAR'.
      CONCATENATE 'ANALISE USINA >>' text-m07 INTO wa_result-log SEPARATED BY space.
      APPEND wa_result TO it_result.
    ELSE.
      "Verifica Prova de Erro
      lv_pe_ok = 'X'.
      PERFORM f_consiste_prova_erro
        USING wa_marc-werks
              wa_marc-matnr
              wa_mchbcar
        CHANGING lv_pe_ok.
      IF lv_pe_ok IS INITIAL.
        CONCATENATE 'SUGESTAO USINA >>' 'INCONSISTENCIA PROVA DE ERRO' INTO wa_result-log SEPARATED BY space.
      ELSE.
        wa_result-log = ''.
        p_lines = p_lines + 1.
        CONTINUE.
      ENDIF.
    ENDIF.
    CLEAR wa_result.
  ENDLOOP.
ENDFORM.                    " F_SUGESTAO_APROVEITAMENTO
